{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components": "Information",
      "Microsoft.AspNetCore.SignalR": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DetailedErrors": false,
  "AllowedOrigins": [
    "https://staging-app.mycompany.com"
  ],
  "ReverseProxy": {
    "Clusters": {
      "backend-api": {
        "Destinations": {
          "backend": {
            "Address": "https://staging-api.mycompany.com"
          }
        }
      }
    }
  }
}
