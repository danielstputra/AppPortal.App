@* ═══════════════════════════════════════════════════════════════
   AppTreeList — Base Component (via DevExpress DxTreeList 25.2.5)
   Full parameter mapping, native context menu, summaries,
   band columns, virtual scrolling, drag-drop, paging, editing.
   ═══════════════════════════════════════════════════════════════ *@
@typeparam TData
@using DevExpress.Blazor
@using Microsoft.JSInterop
@using System.Diagnostics.CodeAnalysis
@{
    var mergedClasses = $"app-treelist {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label @if (IsRequired) { <span class="text-red-500">*</span> }
        </label>
    }

    <DxTreeList @ref="_treeList"
                Data="@Data"
                KeyFieldName="@KeyFieldName"
                ParentKeyFieldName="@ParentKeyFieldName"
                RootValue="@RootValue"
                AllowDragDrop="@AllowDragDrop"
                AllowDragRows="@AllowDragRows"
                AllowedDropTarget="@AllowedDropTarget"
                ItemsDropped="@((TreeListItemsDroppedEventArgs e) => ItemsDropped.InvokeAsync(e))"
                AllowSelect="@AllowSelect"
                AllowSort="@AllowSort"
                AutoExpandAllNodes="@AutoExpandAllNodes"
                AutoGenerateColumns="@AutoGenerateColumns"
                ShowColumnHeaders="@ShowColumnHeaders"
                ShowVerticalLines="@ShowVerticalLines"
                ShowHorizontalLines="@ShowHorizontalLines"
                ShowBorders="@ShowBorders"
                ShowRootNode="@ShowRootNode"
                ShowAllRows="@ShowAllRows"
                HighlightRowOnHover="@HighlightRowOnHover"
                SortingMode="@SortingMode"
                ShowFilterRow="@ShowFilterRow"
                ShowSearchBox="@ShowSearchBox"
                SearchText="@SearchText"
                SearchTextChanged="@((string v) => SearchTextChanged.InvokeAsync(v))"
                VirtualScrollingEnabled="@VirtualScrollingEnabled"
                ColumnResizeMode="@ColumnResizeMode"
                TextWrapEnabled="@TextWrapEnabled"
                ContextMenus="@ContextMenus"
                CustomizeContextMenu="@((TreeListCustomizeContextMenuEventArgs e) => CustomizeContextMenu.InvokeAsync(e))"
                GridlinesVisible="@GridlinesVisible"
                FooterDisplayMode="@FooterDisplayMode"
                PageSize="@PageSize"
                PageIndex="@PageIndex"
                PagerNavigationMode="@PagerNavigationMode"
                AllowEditing="@AllowEditing"
                EditMode="@EditMode"
                AllowExpandCollapse="@AllowExpandCollapse"
                CustomSummary="@((TreeListCustomSummaryEventArgs e) => CustomSummary.InvokeAsync(e))"
                CustomizeSummaryDisplayText="@((TreeListCustomizeSummaryDisplayTextEventArgs e) => CustomizeSummaryDisplayText.InvokeAsync(e))"
                NodeExpanded="@(() => NodeExpanded.InvokeAsync())"
                NodeCollapsed="@(() => NodeCollapsed.InvokeAsync())"
                SelectionChanged="@(() => SelectionChanged.InvokeAsync())"
                CssClass="@mergedClasses"
                @attributes="AdditionalAttributes">
        @ChildContent
    </DxTreeList>

    @if (!string.IsNullOrEmpty(ValidationMessage))
        { <p class="mt-1 text-xs text-red-600">@ValidationMessage</p> }
    else if (!string.IsNullOrEmpty(HelperText))
        { <p class="mt-1 text-xs text-gray-400">@HelperText</p> }
</div>

@code {
    private DxTreeList? _treeList;

    [Parameter] public IEnumerable<TData>? Data { get; set; }
    [Parameter] public string KeyFieldName { get; set; } = "Id";
    [Parameter] public string ParentKeyFieldName { get; set; } = "ParentId";
    [Parameter] public object? RootValue { get; set; }

    [Parameter] public bool AllowDragDrop { get; set; }
    [Parameter] public bool AllowDragRows { get; set; }
    [Parameter] public TreeListAllowedDropTarget AllowedDropTarget { get; set; }
    [Parameter] public EventCallback<TreeListItemsDroppedEventArgs> ItemsDropped { get; set; }

    [Parameter] public bool AllowSelect { get; set; } = true;
    [Parameter] public bool AllowSort { get; set; } = true;
    [Parameter] public bool AutoExpandAllNodes { get; set; }
    [Parameter] public bool AllowExpandCollapse { get; set; } = true;
    [Parameter] public bool ShowRootNode { get; set; } = true;
    [Parameter] public bool ShowAllRows { get; set; }
    [Parameter] public bool HighlightRowOnHover { get; set; } = true;
    [Parameter] public bool AutoGenerateColumns { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool ShowColumnHeaders { get; set; } = true;
    [Parameter] public bool ShowVerticalLines { get; set; }
    [Parameter] public bool ShowHorizontalLines { get; set; } = true;
    [Parameter] public bool ShowBorders { get; set; }
    [Parameter] public string? GridlinesVisible { get; set; }
    [Parameter] public TreeListFooterDisplayMode FooterDisplayMode { get; set; }
    [Parameter] public bool VirtualScrollingEnabled { get; set; }
    [Parameter] public TreeListColumnResizeMode ColumnResizeMode { get; set; }
    [Parameter] public bool TextWrapEnabled { get; set; } = true;
    [Parameter] public bool ShowSearchBox { get; set; }
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
    [Parameter] public TreeListContextMenus ContextMenus { get; set; }
    [Parameter] public EventCallback<TreeListCustomizeContextMenuEventArgs> CustomizeContextMenu { get; set; }
    [Parameter] public string? SortingMode { get; set; }
    [Parameter] public bool ShowFilterRow { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public PagerNavigationMode PagerNavigationMode { get; set; }
    [Parameter] public bool AllowEditing { get; set; }
    [Parameter] public TreeListEditMode EditMode { get; set; }
    [Parameter] public EventCallback<TreeListCustomSummaryEventArgs> CustomSummary { get; set; }
    [Parameter] public EventCallback<TreeListCustomizeSummaryDisplayTextEventArgs> CustomizeSummaryDisplayText { get; set; }
    [Parameter] public EventCallback NodeExpanded { get; set; }
    [Parameter] public EventCallback NodeCollapsed { get; set; }
    [Parameter] public EventCallback SelectionChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public string? ValidationMessage { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject][SuppressMessage("CodeQuality", "IDE0044")] private IJSRuntime JS { get; set; } = default!;
}
