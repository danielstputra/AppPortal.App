@* ═══════════════════════════════════════════════════════════════
   AppDateEdit — Base Component (via DevExpress DxDateEdit)
   Flowbite style date picker.
   ═══════════════════════════════════════════════════════════════ *@
@{
    var mergedClasses = $"app-date-edit {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label
            @if (IsRequired)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }

    <DxDateEdit Date="@Value"
                DateChanged="@((DateTime? v) => OnValueChanged(v))"
                Enabled="@(!IsDisabled)"
                ReadOnly="@IsReadOnly"
                NullText="@Placeholder"
                TimeSectionVisible="@TimeSectionVisible"
                PickerDisplayMode="@PickerDisplayMode"
                CustomDisabledDate="@(async (CalendarCustomDisabledDateEventArgs e) => await CustomDisabledDate.InvokeAsync(e))"
                CssClass="@mergedClasses"
                @attributes="AdditionalAttributes" />

    @* Validation message *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }

    @* Helper text *@
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    /// <summary>Label di atas input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Tandai sebagai required (* merah).</summary>
    [Parameter] public bool IsRequired { get; set; }

    /// <summary>Nonaktifkan input.</summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>Read-only mode.</summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>Tampilkan pemilih waktu.</summary>
    [Parameter] public bool TimeSectionVisible { get; set; }

    /// <summary>Tipe pemilih (Auto, Calendar, ScrollPicker).</summary>
    [Parameter] public DatePickerDisplayMode PickerDisplayMode { get; set; } = DatePickerDisplayMode.Auto;

    /// <summary>Event untuk menonaktifkan tanggal tertentu.</summary>
    [Parameter] public EventCallback<CalendarCustomDisabledDateEventArgs> CustomDisabledDate { get; set; }

    /// <summary>Pesan validasi error (merah).</summary>
    [Parameter] public string? ValidationMessage { get; set; }

    /// <summary>Teks bantuan (abu-abu).</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>CSS class untuk wrapper luar.</summary>
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;

    /// <summary>CSS class tambahan.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnValueChanged(DateTime? value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
