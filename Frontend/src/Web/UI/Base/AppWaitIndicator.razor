@* ═══════════════════════════════════════════════════════════════
   AppWaitIndicator — Base Component (via DevExpress DxWaitIndicator 25.2.5)
   Flowbite style waiting spinner indicator.
   ═══════════════════════════════════════════════════════════════ *@
@using DevExpress.Blazor
@{
    var mergedClasses = $"app-wait-indicator {CssClass}".Trim();
}

<DxWaitIndicator Visible="@Visible"
                 CssClass="@mergedClasses"
                 @attributes="AdditionalAttributes">@ChildContent</DxWaitIndicator>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
