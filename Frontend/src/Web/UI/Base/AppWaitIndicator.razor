@* ═══════════════════════════════════════════════════════════════
   AppWaitIndicator — Base Component (via DevExpress DxWaitIndicator 25.2.5)
   Flowbite style waiting spinner indicator.
   ═══════════════════════════════════════════════════════════════ *@
@using DevExpress.Blazor
@{
    var mergedClasses = $"app-wait-indicator {CssClass}".Trim();
}

<DxWaitIndicator Visible="@Visible"
                 AnimationType="@AnimationType"
                 CssClass="@mergedClasses" />

@code {
    /// <summary>Whether the wait indicator is visible.</summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>Optional display text (wrapper-only, not passed to DxWaitIndicator).</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Additional CSS class.</summary>
    /// <summary>Animation type: Pulse, DotLadder, Rotation, etc.</summary>
    [Parameter] public WaitIndicatorAnimationType AnimationType { get; set; } = WaitIndicatorAnimationType.Pulse;

    [Parameter] public string CssClass { get; set; } = string.Empty;
}
