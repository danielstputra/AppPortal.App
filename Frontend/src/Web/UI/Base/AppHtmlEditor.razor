@* ═══════════════════════════════════════════════════════════════
   AppHtmlEditor — Base Component (via DevExpress DxHtmlEditor)
   Flowbite style WYSIWYG HTML rich text editor.
   ═══════════════════════════════════════════════════════════════ *@
@{
    var mergedClasses = $"app-html-editor {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label
            @if (IsRequired)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }

    <DxHtmlEditor Markup="@Markup"
                  MarkupChanged="@OnMarkupChanged"
                  Height="@Height"
                  ReadOnly="@IsReadOnly"
                  Enabled="@(!IsDisabled)"
                  CssClass="@mergedClasses"
                  @attributes="AdditionalAttributes">
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </DxHtmlEditor>

    @* Validation message *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }

    @* Helper text *@
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@code {
    /// <summary>Konten HTML markup.</summary>
    [Parameter] public string? Markup { get; set; }
    [Parameter] public EventCallback<string?> MarkupChanged { get; set; }

    /// <summary>Label di atas editor.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Tinggi editor (misal: "300px").</summary>
    [Parameter] public string Height { get; set; } = "300px";

    /// <summary>Tandai sebagai required (* merah).</summary>
    [Parameter] public bool IsRequired { get; set; }

    /// <summary>Nonaktifkan editor.</summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>Read-only mode.</summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>Pesan validasi error (merah).</summary>
    [Parameter] public string? ValidationMessage { get; set; }

    /// <summary>Teks bantuan (abu-abu).</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Child content custom Toolbar / Extensions.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>CSS class untuk wrapper luar.</summary>
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;

    /// <summary>CSS class tambahan.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnMarkupChanged(string? html)
    {
        Markup = html;
        return MarkupChanged.InvokeAsync(html);
    }
}
