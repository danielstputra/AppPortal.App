@* ═══════════════════════════════════════════════════════════════
   AppScheduler — Base Component (via DevExpress DxScheduler)
   Flowbite style scheduling/calendar component.
   ═══════════════════════════════════════════════════════════════ *@
@typeparam TData
@{
    var mergedClasses = $"app-scheduler {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    <DxScheduler Data="@Data"
                 CssClass="@mergedClasses"
                 @attributes="AdditionalAttributes">
        @if (ChildContent != null) { @ChildContent }
    </DxScheduler>
</div>

@code {
    [Parameter] public IEnumerable<TData>? Data { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
