@* ═══════════════════════════════════════════════════════════════
   AppTreeView — via DevExpress DxTreeView 25.2.5
   Supports Data binding + static DxTreeViewNode children.
   ═══════════════════════════════════════════════════════════════ *@
@using DevExpress.Blazor
@using Microsoft.JSInterop
@using System.Diagnostics.CodeAnalysis
@{
    var mergedClasses = $"app-treeview {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label @if (IsRequired) { <span class="text-red-500">*</span> }
        </label>
    }

    <DxTreeView @ref="_treeView"
                Data="@Data"
                AllowSelectNodes="@AllowSelectNodes"
                AllowSelectMultiple="@AllowSelectMultiple"
                ExpandNodeOnClick="@ExpandNodeOnClick"
                ExpandNodesMode="@ExpandNodesMode"
                ShowCheckBoxes="@ShowCheckBoxes"
                ShowRootNode="@ShowRootNode"
                AllowRecursiveCheck="@AllowRecursiveCheck"
                SelectNodesRecursive="@SelectNodesRecursive"
                AnimationEnabled="@AnimationEnabled"
                AllowDragDrop="@AllowDragDrop"
                Visible="@Visible"
                Enabled="@(!IsDisabled)"
                TextFieldName="@TextFieldName"
                HasChildrenFieldName="@HasChildrenFieldName"
                ChildNodesFieldName="@ChildNodesFieldName"
                NodeSelected="@((TreeViewNodeEventArgs e) => OnNodeSelected(e))"
                NodeSelectionChanged="@((TreeViewNodeEventArgs e) => OnNodeSelectionChanged(e))"
                NodeExpanded="@((TreeViewNodeEventArgs e) => OnNodeExpanded(e))"
                NodeCollapsed="@((TreeViewNodeEventArgs e) => OnNodeCollapsed(e))"
                CssClass="@mergedClasses"
                @attributes="AdditionalAttributes">
        
        
    </DxTreeView>

    @if (!string.IsNullOrEmpty(ValidationMessage))
        { <p class="mt-1 text-xs text-red-600">@ValidationMessage</p> }
    else if (!string.IsNullOrEmpty(HelperText))
        { <p class="mt-1 text-xs text-gray-400">@HelperText</p> }
</div>

@* Context menu *@
@if (_ctxVisible)
{
    <div class="app-treeview-ctx-backdrop" @onclick="@(_ => CloseContextMenu())"></div>
    <div class="app-treeview-ctx-menu" style="top: @(_ctxY)px; left: @(_ctxX)px;">
        <div class="app-treeview-ctx-header">@_ctxItemText ?? "Tree"</div>
        @if (ContextMenuContent is not null) { @ContextMenuContent }
        else
        {
            <button type="button" class="app-treeview-ctx-item" @onclick="@(_ => CtxAction("expandAll"))">Expand All</button>
            <button type="button" class="app-treeview-ctx-item" @onclick="@(_ => CtxAction("collapseAll"))">Collapse All</button>
            <div class="app-treeview-ctx-divider"></div>
            <button type="button" class="app-treeview-ctx-item" @onclick="@(_ => CtxAction("selectAll"))">Select All</button>
            <button type="button" class="app-treeview-ctx-item" @onclick="@(_ => CtxAction("deselectAll"))">Deselect All</button>
        }
    </div>
}

@code {
    private DxTreeView? _treeView;
    private bool _ctxVisible;
    private double _ctxX;
    private double _ctxY;
    private string? _ctxItemText;

    [Parameter] public IEnumerable<object>? Data { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool AllowSelectNodes { get; set; } = true;
    [Parameter] public bool AllowSelectMultiple { get; set; }
    [Parameter] public bool SelectNodesRecursive { get; set; }
    [Parameter] public bool ExpandNodeOnClick { get; set; }
    [Parameter] public string? ExpandNodesMode { get; set; } = "Single";
    [Parameter] public bool ShowCheckBoxes { get; set; }
    [Parameter] public bool AllowRecursiveCheck { get; set; }
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool AnimationEnabled { get; set; } = true;
    [Parameter] public bool AllowDragDrop { get; set; }
    [Parameter] public bool ShowRootNode { get; set; } = true;
    [Parameter] public string? TextFieldName { get; set; }
    [Parameter] public string? HasChildrenFieldName { get; set; }
    [Parameter] public string? ChildNodesFieldName { get; set; }
    [Parameter] public RenderFragment? NodeTextTemplate { get; set; }
    [Parameter] public RenderFragment? NodeTemplate { get; set; }
    [Parameter] public bool ShowNodeContextMenu { get; set; }
    [Parameter] public RenderFragment? ContextMenuContent { get; set; }
    [Parameter] public EventCallback<string> ContextMenuItemClicked { get; set; }
    [Parameter] public EventCallback<TreeViewNodeEventArgs> NodeSelected { get; set; }
    [Parameter] public EventCallback<TreeViewNodeEventArgs> NodeSelectionChanged { get; set; }
    [Parameter] public EventCallback<TreeViewNodeEventArgs> NodeExpanded { get; set; }
    [Parameter] public EventCallback<TreeViewNodeEventArgs> NodeCollapsed { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public string? ValidationMessage { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject][SuppressMessage("CodeQuality", "IDE0044")] private IJSRuntime JS { get; set; } = default!;

    private Task OnNodeSelected(TreeViewNodeEventArgs e) => NodeSelected.InvokeAsync(e);
    private Task OnNodeSelectionChanged(TreeViewNodeEventArgs e) => NodeSelectionChanged.InvokeAsync(e);
    private Task OnNodeExpanded(TreeViewNodeEventArgs e) => NodeExpanded.InvokeAsync(e);
    private Task OnNodeCollapsed(TreeViewNodeEventArgs e) => NodeCollapsed.InvokeAsync(e);

    public async Task ShowContextMenuAt(double x, double y, string? itemText = null)
    {
        _ctxX = Math.Max(0, x); _ctxY = Math.Max(0, y);
        try { var vw = await JS.InvokeAsync<double>("window.innerWidth"); if (_ctxX + 200 > vw) _ctxX = vw - 208; } catch { }
        _ctxItemText = itemText; _ctxVisible = true; StateHasChanged();
    }

    private void CloseContextMenu() { _ctxVisible = false; _ctxItemText = null; }

    private async Task CtxAction(string action)
    {
        _ctxVisible = false;
        try { if (action == "expandAll") _treeView?.ExpandAll(); else if (action == "collapseAll") _treeView?.CollapseAll(); } catch { }
        await ContextMenuItemClicked.InvokeAsync(action); StateHasChanged();
    }
}
