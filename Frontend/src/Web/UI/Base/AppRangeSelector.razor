@* ═══════════════════════════════════════════════════════════════
   AppRangeSelector — Base Component (via DevExpress DxRangeSelector)
   Flowbite style range selector for data filtering.
   ═══════════════════════════════════════════════════════════════ *@
@{
    var mergedClasses = $"app-range-selector {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    <DxRangeSelector CssClass="@mergedClasses" @attributes="AdditionalAttributes">
        @if (ChildContent != null) { @ChildContent }
    </DxRangeSelector>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
