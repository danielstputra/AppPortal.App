@* ═══════════════════════════════════════════════════════════════
   AppRichEdit — Base Component (via DevExpress DxRichEdit 25.2.5)
   Rich text document editor with full formatting capabilities.
   ═══════════════════════════════════════════════════════════════ *@
@using DevExpress.Blazor.RichEdit
@{
    var mergedClasses = $"app-rich-edit {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @* ─── Label ─── *@
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label @if (IsRequired) { <span class="text-red-500">*</span> }
        </label>
    }

    <DxRichEdit @ref="_richEdit"
                Document="@Document"
                DocumentContent="@DocumentContent"
                DocumentFormat="@DocumentFormat"
                Title="@Title"
                Password="@Password"
                Encoding="@Encoding"
                Height="@Height"
                Width="@Width"
                ReadOnly="@IsReadOnly"
                Enabled="@(!IsDisabled)"
                PrintLayout="@(!SimpleView)"
                ZoomFactor="@Zoom"
                AllowCreateNew="@AllowNew"
                AllowOpen="@AllowOpen"
                AllowSave="@AllowSave"
                MailMergeEnabled="@MailMergeEnabled"
                Locale="@Locale"
                AllowDrop="@AllowDrop"
                InputMethod="@InputMethod"
                AllowSkinning="@AllowSkinning"
                ShowPageTabs="@ShowPageTabs"
                ShowBookmarks="@ShowBookmarks"
                ShowComments="@ShowComments"
                ShowTrackChanges="@ShowTrackChanges"
                ShowFieldCodes="@ShowFieldCodes"
                ShowFieldResults="@ShowFieldResults"
                FieldHighlightMode="@FieldHighlightMode"
                AllowSpellCheck="@AllowSpellCheck"
                ShowLineNumbers="@ShowLineNumbers"
                ShowParagraphMarks="@ShowParagraphMarks"
                ShowWhitespace="@ShowWhitespace"
                ShowTableGridLines="@ShowTableGridLines"
                ValidationEnabled="@ValidationEnabled"
                MaxDocumentCapacity="@MaxDocumentCapacity"
                ShowToolbar="@ShowToolbar"
                ShowRibbon="@ShowRibbon"
                ShowContextMenu="@ShowContextMenu"
                ShowSearchPanel="@ShowSearchPanel"
                ShowDocumentWizard="@ShowDocumentWizard"
                ShowPrintButton="@ShowPrintButton"
                ShowHorizontalRuler="@ShowHorizontalRuler"
                ShowVerticalRuler="@ShowVerticalRuler"
                SpellCheckEnabled="@SpellCheckEnabled"
                ActiveTabIndex="@ActiveRibbonTabIndex"
                HideRibbonTabs="@HiddenRibbonTabs"
                DocumentChanged="@(() => OnDocumentChanged())"
                DocumentContentChanged="@(() => OnDocumentContentChanged())"
                SelectionChanged="@(() => OnSelectionChanged())"
                CustomStyleSettingsChanged="@(() => OnCustomStyleSettingsChanged())"
                BeforeExport="@(() => OnBeforeExport())"
                BeforeImport="@(() => OnBeforeImport())"
                DocumentLoaded="@(() => OnDocumentLoaded())"
                ContentChanged="@(() => OnContentChanged())"
                Print="@(() => OnPrint())"
                BeforeDocumentSave="@(() => OnBeforeDocumentSave())"
                BeforeDocumentOpen="@(() => OnBeforeDocumentOpen())"
                BeforeContextMenuShown="@(() => OnBeforeContextMenuShown())"
                CssClass="@mergedClasses"
                @attributes="AdditionalAttributes" />

    @* ─── Validation message ─── *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }

    @* ─── Helper text ─── *@
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@code {
    private DxRichEdit? _richEdit;

    // ═══════════════════════════════════════════════════
    //  Document Core
    // ═══════════════════════════════════════════════════
    [Parameter] public object? Document { get; set; }
    [Parameter] public EventCallback<object?> DocumentChanged { get; set; }
    [Parameter] public byte[]? DocumentContent { get; set; }
    [Parameter] public EventCallback<byte[]?> DocumentContentChanged { get; set; }
    [Parameter] public DocumentFormat DocumentFormat { get; set; } = DocumentFormat.OpenXml;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? Encoding { get; set; }

    // ═══════════════════════════════════════════════════
    //  Size
    // ═══════════════════════════════════════════════════
    [Parameter] public string Height { get; set; } = "500px";
    [Parameter] public string Width { get; set; } = "100%";

    // ═══════════════════════════════════════════════════
    //  Behavior
    // ═══════════════════════════════════════════════════
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool SimpleView { get; set; }
    [Parameter] public double Zoom { get; set; } = 1.0;
    [Parameter] public bool AllowNew { get; set; } = true;
    [Parameter] public bool AllowOpen { get; set; } = true;
    [Parameter] public bool AllowSave { get; set; } = true;
    [Parameter] public bool MailMergeEnabled { get; set; }
    [Parameter] public string? Locale { get; set; }
    [Parameter] public bool AllowDrop { get; set; } = true;
    [Parameter] public string? InputMethod { get; set; }
    [Parameter] public bool AllowSkinning { get; set; } = true;

    // ═══════════════════════════════════════════════════
    //  Document Features
    // ═══════════════════════════════════════════════════
    [Parameter] public bool ShowPageTabs { get; set; } = true;
    [Parameter] public bool ShowBookmarks { get; set; }
    [Parameter] public bool ShowComments { get; set; } = true;
    [Parameter] public bool ShowTrackChanges { get; set; } = true;
    [Parameter] public bool ShowFieldCodes { get; set; }
    [Parameter] public bool ShowFieldResults { get; set; } = true;
    [Parameter] public string? FieldHighlightMode { get; set; }
    [Parameter] public bool AllowSpellCheck { get; set; } = true;
    [Parameter] public bool ShowLineNumbers { get; set; }
    [Parameter] public bool ShowParagraphMarks { get; set; }
    [Parameter] public bool ShowWhitespace { get; set; }
    [Parameter] public bool ShowTableGridLines { get; set; } = true;
    [Parameter] public bool ValidationEnabled { get; set; }
    [Parameter] public int MaxDocumentCapacity { get; set; } = 1000000;

    // ═══════════════════════════════════════════════════
    //  UI Customization
    // ═══════════════════════════════════════════════════
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public bool ShowRibbon { get; set; } = true;

    /// <summary>
    /// Show context menu on right-click. Default: true.
    /// Context menu items dapat dikustomisasi melalui event
    /// <see cref="BeforeContextMenuShown"/> (Kombinasi B).
    /// Untuk custom context menu total (Kombinasi A), gunakan
    /// DxRichEdit secara langsung dengan <c>&lt;ContextMenuTemplate&gt;</c>.
    /// </summary>
    [Parameter] public bool ShowContextMenu { get; set; } = true;

    [Parameter] public bool ShowSearchPanel { get; set; } = true;
    [Parameter] public bool ShowDocumentWizard { get; set; } = true;
    [Parameter] public bool ShowPrintButton { get; set; } = true;
    [Parameter] public bool ShowHorizontalRuler { get; set; } = true;
    [Parameter] public bool ShowVerticalRuler { get; set; } = true;
    [Parameter] public bool SpellCheckEnabled { get; set; } = true;
    [Parameter] public int ActiveRibbonTabIndex { get; set; }
    [Parameter] public string[]? HiddenRibbonTabs { get; set; }

    // ═══════════════════════════════════════════════════
    //  Document Lifecycle Events
    // ═══════════════════════════════════════════════════
    [Parameter] public EventCallback BeforeExport { get; set; }
    [Parameter] public EventCallback BeforeImport { get; set; }
    [Parameter] public EventCallback DocumentLoaded { get; set; }
    [Parameter] public EventCallback ContentChanged { get; set; }
    [Parameter] public EventCallback SelectionChanged { get; set; }
    [Parameter] public EventCallback CustomStyleSettingsChanged { get; set; }
    [Parameter] public EventCallback Print { get; set; }
    [Parameter] public EventCallback BeforeDocumentSave { get; set; }
    [Parameter] public EventCallback BeforeDocumentOpen { get; set; }

    /// <summary>
    /// Fires before the context menu is shown.
    /// Kombinasi B: Gunakan event ini untuk memanipulasi context menu
    /// items secara runtime tanpa perlu override template.
    /// </summary>
    [Parameter] public EventCallback BeforeContextMenuShown { get; set; }

    // ═══════════════════════════════════════════════════
    //  Feedback & Styling
    // ═══════════════════════════════════════════════════
    [Parameter] public string? ValidationMessage { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // ═══════════════════════════════════════════════════
    //  Event Handlers
    // ═══════════════════════════════════════════════════
    private Task OnDocumentChanged() => DocumentChanged.InvokeAsync(Document);
    private Task OnDocumentContentChanged() => DocumentContentChanged.InvokeAsync(DocumentContent);
    private Task OnSelectionChanged() => SelectionChanged.InvokeAsync();
    private Task OnCustomStyleSettingsChanged() => CustomStyleSettingsChanged.InvokeAsync();
    private Task OnBeforeExport() => BeforeExport.InvokeAsync();
    private Task OnBeforeImport() => BeforeImport.InvokeAsync();
    private Task OnDocumentLoaded() => DocumentLoaded.InvokeAsync();
    private Task OnContentChanged() => ContentChanged.InvokeAsync();
    private Task OnPrint() => Print.InvokeAsync();
    private Task OnBeforeDocumentSave() => BeforeDocumentSave.InvokeAsync();
    private Task OnBeforeDocumentOpen() => BeforeDocumentOpen.InvokeAsync();
    private Task OnBeforeContextMenuShown() => BeforeContextMenuShown.InvokeAsync();
}
