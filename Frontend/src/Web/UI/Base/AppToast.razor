@* ═══════════════════════════════════════════════════════════════
   AppToast — Base Component (DevExpress DxToast + DxToastProvider Engine)
   Menggunakan engine DevExpress + CSS override Tailwind/Flowbite.
   ═══════════════════════════════════════════════════════════════ *@

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

<DxToastProvider />

@foreach (var t in _toasts)
{
    <DxToast Text="@t.Message"
             Title="@t.Title"
             Visible="@t.Visible" />
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly List<ToastEntry> _toasts = new();

    /// <summary>Tampilkan toast.</summary>
    public void Show(string title, string message, int durationMs = 4000)
    {
        var toast = new ToastEntry { Title = title, Message = message };
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        if (durationMs > 0)
            _ = RemoveAfter(toast, durationMs);
    }

    public void Success(string message, string? title = null) => Show(title ?? "Berhasil", message);
    public void Error(string message, string? title = null) => Show(title ?? "Gagal", message);
    public void Warning(string message, string? title = null) => Show(title ?? "Peringatan", message);
    public void Info(string message, string? title = null) => Show(title ?? "Informasi", message);

    private async Task RemoveAfter(ToastEntry toast, int ms)
    {
        await Task.Delay(ms);
        toast.Visible = false;
        _toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    private class ToastEntry
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public bool Visible { get; set; } = true;
    }
}
