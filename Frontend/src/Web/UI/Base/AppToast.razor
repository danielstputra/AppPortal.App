@* ═══════════════════════════════════════════════════════════════
   AppToast — Base Component (DevExpress IToastNotificationService)
   Menggunakan engine DevExpress + CSS override Tailwind/Flowbite.
   ═══════════════════════════════════════════════════════════════ *@
@inject IToastNotificationService _toastSvc

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

<DxToastProvider Name="AppToastProvider" />

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public void Success(string message, string? title = null)
    {
        var opt = new ToastOptions { RenderStyle = ToastRenderStyle.Success, ThemeMode = ToastThemeMode.Saturated };
        _toastSvc.ShowToast(opt);
    }

    public void Error(string message, string? title = null)
    {
        var opt = new ToastOptions { RenderStyle = ToastRenderStyle.Danger, ThemeMode = ToastThemeMode.Saturated };
        _toastSvc.ShowToast(opt);
    }

    public void Warning(string message, string? title = null)
    {
        var opt = new ToastOptions { RenderStyle = ToastRenderStyle.Warning, ThemeMode = ToastThemeMode.Saturated };
        _toastSvc.ShowToast(opt);
    }

    public void Info(string message, string? title = null)
    {
        var opt = new ToastOptions { RenderStyle = ToastRenderStyle.Info, ThemeMode = ToastThemeMode.Saturated };
        _toastSvc.ShowToast(opt);
    }
}
