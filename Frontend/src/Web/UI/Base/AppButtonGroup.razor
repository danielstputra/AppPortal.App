@* ═══════════════════════════════════════════════════════════════
   AppButtonGroup — Base Component (via DevExpress DxButtonGroup)
   Flowbite style grouped button toolbar.
   ═══════════════════════════════════════════════════════════════ *@
@{
    var mergedClasses = $"app-button-group {CssClass}".Trim();
}

<DxButtonGroup Data="@Items"
               CssClass="@mergedClasses"
               @attributes="AdditionalAttributes" />

@code {
    /// <summary>Data source items (string list).</summary>
    [Parameter] public IEnumerable<string>? Items { get; set; }

    /// <summary>CSS class tambahan.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
