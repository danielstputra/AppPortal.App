@* ═══════════════════════════════════════════════════════════════
   AppFileInput — Base Component (via DevExpress DxFileInput)
   Flowbite style file upload input.
   ═══════════════════════════════════════════════════════════════ *@
@{
    var mergedClasses = $"app-file-input {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label
            @if (IsRequired)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }

    <DxFileInput AllowMultiFileUpload="@AllowMultiFileUpload"
                 MaxFileSize="@MaxFileSize"
                 FilesUploading="@FilesUploading"
                 AllowedFileExtensions="@AllowedFileExtensions"
                 ReadOnly="@IsReadOnly"
                 Enabled="@(!IsDisabled)"
                 CssClass="@mergedClasses"
                 @attributes="AdditionalAttributes" />

    @* Validation message *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }

    @* Helper text *@
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@code {
    /// <summary>Izinkan upload banyak file sekaligus.</summary>
    [Parameter] public bool AllowMultiFileUpload { get; set; }

    /// <summary>Ukuran maksimal file (dalam byte, misal 4000000 = 4MB).</summary>
    [Parameter] public int MaxFileSize { get; set; } = 4_000_000;

    /// <summary>Ekstensi file yang diizinkan (misal: new List<string> { ".jpg", ".png", ".pdf" }).</summary>
    [Parameter] public List<string>? AllowedFileExtensions { get; set; }

    /// <summary>Event callback saat file mengunggah.</summary>
    [Parameter] public EventCallback<FilesUploadingEventArgs> FilesUploading { get; set; }

    /// <summary>Label di atas file input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Tandai sebagai required (* merah).</summary>
    [Parameter] public bool IsRequired { get; set; }

    /// <summary>Nonaktifkan input.</summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>Read-only mode.</summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>Pesan validasi error (merah).</summary>
    [Parameter] public string? ValidationMessage { get; set; }

    /// <summary>Teks bantuan (abu-abu).</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>CSS class untuk wrapper luar.</summary>
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;

    /// <summary>CSS class tambahan.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
