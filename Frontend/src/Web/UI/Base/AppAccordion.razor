@* ═══════════════════════════════════════════════════════════════
   AppAccordion — Base Component (via DevExpress DxAccordion 25.2.5)
   Flowbite style collapsible accordion with full parameter mapping,
   data binding, templates, and custom context menu support.
   ═══════════════════════════════════════════════════════════════ *@
@using DevExpress.Blazor
@using Microsoft.JSInterop
@using System.Diagnostics.CodeAnalysis
@{
    var mergedClasses = $"app-accordion {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @* ─── Label ─── *@
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label @if (IsRequired) { <span class="text-red-500">*</span> }
        </label>
    }

    <DxAccordion @ref="_accordion"
                 Data="@Data"
                 AllowCollapseAll="@AllowCollapseAll"
                 AllowExpandAll="@AllowExpandAll"
                 ExpandMode="@ExpandMode"
                 CollapseAllButtonVisible="@CollapseAllButtonVisible"
                 ExpandAllButtonVisible="@ExpandAllButtonVisible"
                 ShowExpandButton="@ShowExpandButton"
                 AnimationEnabled="@AnimationEnabled"
                 AnimationDuration="@AnimationDuration"
                 ActiveItem="@ActiveItem"
                 Visible="@Visible"
                 Enabled="@Enabled"
                 ItemTextFieldName="@ItemTextFieldName"
                 ItemEnabledFieldName="@ItemEnabledFieldName"
                 ItemExpandedFieldName="@ItemExpandedFieldName"
                 ItemVisibleFieldName="@ItemVisibleFieldName"
                 SelectedItemChanged="@((object? e) => SelectedItemChanged.InvokeAsync(e))"
                 ExpandedItemChanged="@((object? e) => ExpandedItemChanged.InvokeAsync(e))"
                 ExpandedItemsChanged="@((IEnumerable<object?> e) => ExpandedItemsChanged.InvokeAsync(e))"
                 ItemClick="@((AccordionItemClickEventArgs e) => OnItemClick(e))"
                 ActiveItemChanged="@((object? e) => ActiveItemChanged.InvokeAsync(e))"
                 CssClass="@mergedClasses"
                 @attributes="AdditionalAttributes">
        <Items>@ChildContent</Items>
    </DxAccordion>

    @* ─── Validation / Helper ─── *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@* ─── Context Menu Overlay ─── *@
@if (_ctxVisible)
{
    <div class="app-accordion-ctx-backdrop" @onclick="@(_ => CloseContextMenu())"></div>
    <div class="app-accordion-ctx-menu"
         style="top: @(_ctxY)px; left: @(_ctxX)px;">
        <div class="app-accordion-ctx-header">
            @_ctxItemText ?? "Actions"
        </div>
        @if (ContextMenuContent is not null)
        {
            @ContextMenuContent
        }
        else
        {
            <button type="button" class="app-accordion-ctx-item" @onclick="@(_ => ExecuteCtxAction("expand"))">Expand</button>
            <button type="button" class="app-accordion-ctx-item" @onclick="@(_ => ExecuteCtxAction("collapse"))">Collapse</button>
            <div class="app-accordion-ctx-divider"></div>
            <button type="button" class="app-accordion-ctx-item" @onclick="@(_ => ExecuteCtxAction("expandAll"))">Expand All</button>
            <button type="button" class="app-accordion-ctx-item" @onclick="@(_ => ExecuteCtxAction("collapseAll"))">Collapse All</button>
        }
    </div>
}

@code {
    private DxAccordion? _accordion;

    // ═══════════════════════════════════════════
    //  Context Menu State
    // ═══════════════════════════════════════════
    private bool _ctxVisible;
    private double _ctxX;
    private double _ctxY;
    private string? _ctxItemText;

    // ═══════════════════════════════════════════
    //  Core
    // ═══════════════════════════════════════════
    [Parameter] public IEnumerable<object>? Data { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public object? ActiveItem { get; set; }
    [Parameter] public AccordionExpandMode ExpandMode { get; set; } = AccordionExpandMode.SingleOrNone;
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public bool Enabled { get; set; } = true;

    // ═══════════════════════════════════════════
    //  Behavior
    // ═══════════════════════════════════════════
    [Parameter] public bool AllowCollapseAll { get; set; } = true;
    [Parameter] public bool AllowExpandAll { get; set; } = true;
    [Parameter] public bool AnimationEnabled { get; set; } = true;
    [Parameter] public int AnimationDuration { get; set; } = 300;

    // ═══════════════════════════════════════════
    //  UI
    // ═══════════════════════════════════════════
    [Parameter] public bool ShowExpandButton { get; set; } = true;
    [Parameter] public bool CollapseAllButtonVisible { get; set; }
    [Parameter] public bool ExpandAllButtonVisible { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsRequired { get; set; }

    // ═══════════════════════════════════════════
    //  Data Mapping
    // ═══════════════════════════════════════════
    [Parameter] public string? ItemTextFieldName { get; set; }
    [Parameter] public string? ItemEnabledFieldName { get; set; }
    [Parameter] public string? ItemExpandedFieldName { get; set; }
    [Parameter] public string? ItemVisibleFieldName { get; set; }

    // ═══════════════════════════════════════════
    //  Context Menu
    // ═══════════════════════════════════════════
    [Parameter] public bool ShowItemContextMenu { get; set; }
    [Parameter] public RenderFragment? ContextMenuContent { get; set; }
    [Parameter] public EventCallback<string> ContextMenuItemClicked { get; set; }
    [Parameter] public EventCallback<AccordionContextMenuEventArgs> BeforeContextMenuShown { get; set; }

    // ═══════════════════════════════════════════
    //  Events
    // ═══════════════════════════════════════════
    [Parameter] public EventCallback<object?> SelectedItemChanged { get; set; }
    [Parameter] public EventCallback<object?> ExpandedItemChanged { get; set; }
    [Parameter] public EventCallback<IEnumerable<object?>> ExpandedItemsChanged { get; set; }
    [Parameter] public EventCallback<AccordionItemClickEventArgs> ItemClick { get; set; }
    [Parameter] public EventCallback<object?> ActiveItemChanged { get; set; }

    // ═══════════════════════════════════════════
    //  Feedback & Styling
    // ═══════════════════════════════════════════
    [Parameter] public string? ValidationMessage { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject][SuppressMessage("CodeQuality", "IDE0044")] private IJSRuntime JS { get; set; } = default!;

    // ═══════════════════════════════════════════
    //  Event Handlers
    // ═══════════════════════════════════════════
    private void OnItemClick(AccordionItemClickEventArgs e)
    {
        _ctxItemText = e?.ItemInfo?.Text;
    }

    public async Task ShowContextMenuAt(double x, double y, string? itemText = null)
    {
        _ctxX = Math.Max(0, x);
        _ctxY = Math.Max(0, y);

        try
        {
            var vw = await JS.InvokeAsync<double>("window.innerWidth");
            if (_ctxX + 200 > vw) _ctxX = vw - 208;
        }
        catch { }

        _ctxItemText = itemText ?? _ctxItemText;

        var args = new AccordionContextMenuEventArgs { ItemText = _ctxItemText };
        await BeforeContextMenuShown.InvokeAsync(args);

        if (!args.Cancel) _ctxVisible = true;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        _ctxVisible = false;
        _ctxItemText = null;
    }

    private async Task ExecuteCtxAction(string action)
    {
        _ctxVisible = false;
        try
        {
            if (action == "expandAll") _accordion?.ExpandAll();
            else if (action == "collapseAll") _accordion?.CollapseAll();
        }
        catch { }

        await ContextMenuItemClicked.InvokeAsync(action);
        StateHasChanged();
    }
}
