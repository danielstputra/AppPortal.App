@* ═══════════════════════════════════════════════════════════════
   AppTagBox — Base Component (via DevExpress DxTagBox)
   Flowbite style multi-select tag box.
   ═══════════════════════════════════════════════════════════════ *@
@typeparam TData
@typeparam TValue
@{
    var mergedClasses = $"app-tagbox {CssClass}".Trim();
}

<div class="@WrapperCssClass">
    @* Label *@
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
            @Label
            @if (IsRequired)
            {
                <span class="text-red-500">*</span>
            }
        </label>
    }

    <DxTagBox Data="@Data"
              Values="@Values"
              ValuesChanged="@ValuesChanged"
              TextFieldName="@TextFieldName"
              ValueFieldName="@ValueFieldName"
              NullText="@Placeholder"
              ReadOnly="@IsReadOnly"
              Enabled="@(!IsDisabled)"
              AllowCustomTags="@AllowCustomTags"
              CssClass="@mergedClasses"
              @attributes="AdditionalAttributes" />

    @* Validation message *@
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-red-600">@ValidationMessage</p>
    }

    @* Helper text *@
    @if (!string.IsNullOrEmpty(HelperText) && string.IsNullOrEmpty(ValidationMessage))
    {
        <p class="mt-1 text-xs text-gray-400">@HelperText</p>
    }
</div>

@code {
    /// <summary>Data source collection.</summary>
    [Parameter] public IEnumerable<TData>? Data { get; set; }

    /// <summary>Selected values.</summary>
    [Parameter] public IEnumerable<TValue>? Values { get; set; }
    [Parameter] public EventCallback<IEnumerable<TValue>?> ValuesChanged { get; set; }

    /// <summary>Property name for text display.</summary>
    [Parameter] public string? TextFieldName { get; set; }

    /// <summary>Property name for value field.</summary>
    [Parameter] public string? ValueFieldName { get; set; }

    /// <summary>Label di atas input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Tandai sebagai required (* merah).</summary>
    [Parameter] public bool IsRequired { get; set; }

    /// <summary>Nonaktifkan input.</summary>
    [Parameter] public bool IsDisabled { get; set; }

    /// <summary>Read-only mode.</summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>Izinkan penambahan tag kustom.</summary>
    [Parameter] public bool AllowCustomTags { get; set; }

    /// <summary>Pesan validasi error (merah).</summary>
    [Parameter] public string? ValidationMessage { get; set; }

    /// <summary>Teks bantuan (abu-abu).</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>CSS class untuk wrapper luar.</summary>
    [Parameter] public string WrapperCssClass { get; set; } = string.Empty;

    /// <summary>CSS class tambahan.</summary>
    [Parameter] public string CssClass { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
