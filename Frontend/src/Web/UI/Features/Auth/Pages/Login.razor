@page "/login"
@layout AuthLayout
@implements IDisposable

<PageTitle>Login — AppPortal</PageTitle>

<div class="flex min-h-screen items-center justify-center px-4 py-8 md:py-12">
    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6 items-center">

        @* ═════════════════════════════════════════════════════════
           LEFT COLUMN — Login Form
           ═════════════════════════════════════════════════════════ *@
        <div>
            @* ─── Logo / Brand ─── *@
            <div class="text-center md:text-left mb-6">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm mb-3">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-white tracking-tight">AppPortal</h1>
                <p class="text-sm text-white/70 mt-1">Sign in to your account</p>
            </div>

            @* ─── Login Card ─── *@
            <AppCard CssClass="p-6 sm:p-8">
                @if (_isError)
                {
                    <div class="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg flex items-start gap-2">
                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                        <input type="email" @bind="_email"
                               class="app-login-input w-full px-3.5 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-700/20 focus:border-green-700 outline-none transition-all placeholder-gray-400"
                               placeholder="you@example.com" @onkeyup="@HandleKeyUp" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
                        <input type="password" @bind="_password"
                               class="app-login-input w-full px-3.5 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-700/20 focus:border-green-700 outline-none transition-all placeholder-gray-400"
                               placeholder="••••••••" @onkeyup="@HandleKeyUp" />
                    </div>

                    <div class="flex items-center justify-between">
                        <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer select-none">
                            <input type="checkbox" @bind="_remember" class="rounded border-gray-300 text-green-700 focus:ring-green-700" />
                            Remember me
                        </label>
                        <a href="#" class="text-sm text-green-700 hover:text-green-800 font-medium">Forgot password?</a>
                    </div>

                    <AppButton Text="Sign In"
                               Variant="AppButtonVariant.Primary"
                               IsLoading="@_isLoading"
                               CssClass="w-full justify-center py-2.5"
                               OnClick="@HandleLogin" />
                </div>

                <div class="mt-6 text-center">
                    <p class="text-sm text-gray-500">
                        Don't have an account?
                        <a href="#" class="text-green-700 hover:text-green-800 font-medium">Sign up</a>
                    </p>
                </div>
            </AppCard>
        </div>

        @* ═════════════════════════════════════════════════════════
           RIGHT COLUMN — Feature Slider
           ═════════════════════════════════════════════════════════ *@
        <div class="hidden md:block">
            <AppCard CssClass="overflow-hidden">
                <div class="relative">
                    @* ─── Slides ─── *@
                    @foreach (var (slide, idx) in _slides.Select((s, i) => (s, i)))
                    {
                        <div class="transition-all duration-500 @(idx == _currentSlide ? "opacity-100 visible" : "opacity-0 invisible absolute inset-0")">
                            <div class="p-8 sm:p-10">
                                @* Icon *@
                                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-green-100 to-green-50 flex items-center justify-center mb-6 shadow-sm">
                                    <span class="text-3xl">@slide.Icon</span>
                                </div>

                                @* Title *@
                                <h3 class="text-xl font-bold text-gray-900 mb-3">@slide.Title</h3>

                                @* Description *@
                                <p class="text-sm text-gray-500 leading-relaxed mb-6">@slide.Description</p>

                                @* Feature list *@
                                <ul class="space-y-3">
                                    @foreach (var feature in slide.Features)
                                    {
                                        <li class="flex items-start gap-3 text-sm text-gray-600">
                                            <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            <span>@feature</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    @* ─── Dot Navigation ─── *@
                    <div class="flex items-center justify-center gap-2 pb-6">
                        @for (var i = 0; i < _slides.Length; i++)
                        {
                            <button type="button" class="w-2 h-2 rounded-full transition-all duration-300 @(i == _currentSlide ? "bg-green-700 w-6" : "bg-gray-300 hover:bg-gray-400")"
                                    @onclick="@(() => GoToSlide(i))" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                </div>
            </AppCard>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _remember;
    private bool _isLoading;
    private bool _isError;
    private string _errorMessage = "";
    private int _currentSlide;
    private Timer? _slideTimer;
    private const int SLIDE_INTERVAL_MS = 4500;

    private readonly Slide[] _slides = new[]
    {
        new Slide
        {
            Icon = "🚀",
            Title = "Enterprise Performance",
            Description = "Built on DevExpress Blazor 25.2.5 — experience lightning-fast data processing, real-time updates, and seamless scalability for enterprise-grade applications.",
            Features = new[] { "Optimized server-side rendering", "Real-time data synchronization", "Scalable microservices architecture" }
        },
        new Slide
        {
            Icon = "🎨",
            Title = "Modern UI/UX Design",
            Description = "Flowbite-inspired interface with Tailwind CSS — delivering pixel-perfect responsive design across all devices and screen sizes.",
            Features = new[] { "Mobile-first responsive layout", "Accessible WCAG 2.1 compliant", "Dark mode ready architecture" }
        },
        new Slide
        {
            Icon = "🔒",
            Title = "Enterprise Security",
            Description = "End-to-end security with HMAC-SHA256 & AES-256-GCM encryption. SOC 2 compliant infrastructure for your critical data.",
            Features = new[] { "AES-256-GCM data encryption", "HMAC-SHA256 API signing", "Role-based access control (RBAC)" }
        },
        new Slide
        {
            Icon = "📊",
            Title = "Advanced Analytics",
            Description = "Comprehensive dashboards with pivot grids, charts, and real-time reporting tools to make data-driven decisions.",
            Features = new[] { "Interactive pivot tables", "Real-time chart updates", "Custom export formats (PDF/XLSX)" }
        },
    };

    protected override void OnInitialized()
    {
        _slideTimer = new Timer(_ => { InvokeAsync(() => NextSlide()); }, null, SLIDE_INTERVAL_MS, SLIDE_INTERVAL_MS);
    }

    private void NextSlide() => _currentSlide = (_currentSlide + 1) % _slides.Length;
    private void GoToSlide(int idx) { _currentSlide = idx; ResetTimer(); }

    private void ResetTimer()
    {
        _slideTimer?.Change(SLIDE_INTERVAL_MS, SLIDE_INTERVAL_MS);
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    private async Task HandleLogin()
    {
        _isError = false;
        _isLoading = true;

        try
        {
            await Task.Delay(800);
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            {
                _isError = true; _errorMessage = "Email and password are required."; return;
            }
            Navigation.NavigateTo("/");
        }
        catch
        {
            _isError = true; _errorMessage = "Invalid email or password.";
        }
        finally { _isLoading = false; }
    }

    public void Dispose()
    {
        _slideTimer?.Dispose();
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private record Slide
    {
        public string Icon { get; init; } = "";
        public string Title { get; init; } = "";
        public string Description { get; init; } = "";
        public string[] Features { get; init; } = Array.Empty<string>();
    }
}
