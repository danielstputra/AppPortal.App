@implements IDisposable
@page "/employee-data/new"
@attribute [StreamRendering(true)]

<PageTitle>Tambah Karyawan — @_loc.T("app.title")</PageTitle>

<AppPageNav Title="Tambah Karyawan"
            Subtitle="Isi data karyawan baru pada form di bawah."
            BreadcrumbItems="@_bc">
</AppPageNav>

<div class="max-w-2xl">
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <AppFormLayout @ref="_form"
                       TModel="Employee"
                       Model="@_model"
                       Fields="@_fields"
                       OnSubmit="@HandleSubmit"
                       ShowResetButton="false"
                       SubmitButtonText="Simpan" />
    </div>
</div>

@code {
    [Inject] private LocalizationService _loc { get; set; } = default!;
    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private AppFormLayout<Employee>? _form;
    private Employee _model = new();
    private List<FormFieldMeta> _fields = new()
    {
        new() { FieldName = "Nik", Caption = "NIK", Type = FormFieldType.Text, Placeholder = "Masukkan NIK", Required = true, ColSpan = 12 },
        new() { FieldName = "NamaKaryawan", Caption = "Nama Lengkap", Type = FormFieldType.Text, Placeholder = "Masukkan nama", Required = true, ColSpan = 12 },
        new() { FieldName = "Jabatan", Caption = "Jabatan", Type = FormFieldType.Text, Placeholder = "Masukkan jabatan", ColSpan = 6 },
        new() { FieldName = "UnitKerja", Caption = "Unit Kerja", Type = FormFieldType.Text, Placeholder = "Masukkan unit kerja", ColSpan = 6 },
        new() { FieldName = "Status", Caption = "Status", Type = FormFieldType.ComboBox, Placeholder = "Pilih status",
                Options = new[] { "Active", "Resigned", "Pending" }, ColSpan = 6 },
    };

    private List<BreadcrumbItem> _bc = new()
    {
        new() { Text = "Home", Url = "" },
        new() { Text = "Employee Data", Url = "/employee-data" },
        new() { Text = "Tambah Baru" }
    };

    private Action? _langHandler;

    protected override void OnInitialized()
    {
        _langHandler = () => InvokeAsync(StateHasChanged);
        _loc.OnLanguageChanged += _langHandler;
    }

    private async Task HandleSubmit()
    {
        await EmployeeService.CreateEmployeeAsync(_model);
        _form?.ShowSuccess($"Karyawan {_model.NamaKaryawan} berhasil ditambahkan.");
        await Task.Delay(1500);
        Navigation.NavigateTo("/employee-data");
    }

    public void Dispose()
    {
        if (_langHandler != null)
            _loc.OnLanguageChanged -= _langHandler;
    }
}
