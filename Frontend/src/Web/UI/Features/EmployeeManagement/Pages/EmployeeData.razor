@implements IDisposable
@page "/employee-data"

<PageTitle>@_loc.T("employee.title") — @_loc.T("app.title")</PageTitle>

<nav class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <a href="" class="hover:text-green-700 transition-colors">@_loc.T("common.home")</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium">@_loc.T("employee.title")</span>
</nav>

<div class="mb-6 flex items-center justify-between">
    <div><h1 class="text-2xl font-bold text-gray-900">@_loc.T("employee.title")</h1>
    <p class="text-sm text-gray-500 mt-1">@_loc.T("employee.subtitle")</p></div>
    <a href="/employee-data/new" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-green-700 rounded-lg hover:bg-green-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Tambah
    </a>
</div>

<FilterBar UnitKerjaList="@_unitKerjaList"
           @bind-SearchQuery="_searchQuery"
           @bind-SelectedUnit="_selectedUnit"
           @bind-SelectedStatus="_selectedStatus" />

<div class="p-0">
    <AppGrid TData="Employee" Data="@FilteredEmployees" PageSize="6">
        <Template Context="emp">
            <div class="px-4 py-4 bg-white">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-mono text-gray-400">@emp.Nik</span>
                    <StatusBadge Status="@emp.Status" />
                </div>
                <p class="text-sm font-semibold text-gray-900">@emp.NamaKaryawan</p>
                <p class="text-xs text-gray-500 mt-0.5">@emp.Jabatan</p>
                <div class="flex items-center gap-3 mt-2 text-xs text-gray-400">
                    <span>@emp.UnitKerja</span>
                    <span>•</span>
                    <span>@emp.SumberData</span>
                </div>
            </div>
        </Template>
        <ChildContent>
            <DxGridDataColumn FieldName="No" Caption="No" Width="60px" />
            <DxGridDataColumn FieldName="Nik" Caption="NIK" Width="130px" />
            <DxGridDataColumn FieldName="NamaKaryawan" Caption="Nama" />
            <DxGridDataColumn FieldName="Jabatan" Caption="Jabatan" />
            <DxGridDataColumn FieldName="UnitKerja" Caption="Unit" />

            <DxGridDataColumn Caption="Status" Width="120px">
                <CellDisplayTemplate>
                    @{ var emp = context.DataItem as Employee; }
                    <StatusBadge Status="@(emp?.Status ?? StatusKaryawan.Pending)" />
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn Caption="Aksi" Width="100px">
                <CellDisplayTemplate>
                    @{
                        var emp = context.DataItem as Employee;
                    }
                    <div class="flex items-center gap-1">
                        <a href="@($"/employee-data/" + emp?.No + "/edit")" class="text-gray-400 hover:text-blue-700 transition-colors p-1" title="Edit">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                        <a href="@($"/employee-data/" + emp?.No)" class="text-gray-400 hover:text-green-700 transition-colors p-1" title="@_loc.T("common.detail")">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </a>
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </ChildContent>
    </AppGrid>
</div>

@code {
    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private LocalizationService _loc { get; set; } = default!;

    private List<Employee> _allEmployees = new();
    private List<string> _unitKerjaList = new();
    private string _searchQuery = string.Empty;
    private Action? _langHandler;
    private string _selectedUnit = string.Empty;
    private string _selectedStatus = string.Empty;

    private List<Employee> FilteredEmployees
    {
        get
        {
            var query = _allEmployees.AsEnumerable();

            // Filter by search query (Nik, Nama, Jabatan)
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(e =>
                    (e.Nik?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (e.NamaKaryawan?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (e.Jabatan?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            // Filter by unit kerja
            if (!string.IsNullOrWhiteSpace(_selectedUnit))
            {
                query = query.Where(e => e.UnitKerja == _selectedUnit);
            }

            // Filter by status
            if (!string.IsNullOrWhiteSpace(_selectedStatus))
            {
                if (Enum.TryParse<StatusKaryawan>(_selectedStatus, out var status))
                {
                    query = query.Where(e => e.Status == status);
                }
            }

            return query.ToList();
        }
    }

    protected override void OnInitialized()
    {
        _langHandler = () => InvokeAsync(StateHasChanged);
        _loc.OnLanguageChanged += _langHandler;
    }

    protected override async Task OnInitializedAsync()
    {
        _allEmployees = (await EmployeeService.GetEmployeesAsync()).ToList();
        _unitKerjaList = (await EmployeeService.GetUnitKerjaListAsync()).ToList();
    }

    public void Dispose()
    {
        if (_langHandler != null)
            _loc.OnLanguageChanged -= _langHandler;
    }
}
