    <p class="text-xs text-gray-400 mb-5">Resizable split panel dan grouped buttons.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <p class="text-sm font-medium text-gray-700 mb-2">AppSplitter (Horizontal)</p>
            <AppSplitter Orientation="Horizontal" CssClass="h-48">
                <DxSplitterPane Size="40%" MinSize="100px" AllowResize="true" AllowCollapse="true">
                    <div class="p-4 text-sm text-gray-700">
