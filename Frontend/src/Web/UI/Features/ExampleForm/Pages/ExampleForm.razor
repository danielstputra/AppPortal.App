@* ═══════════════════════════════════════════════════════════════════
   SECTION 12: AppPopup, AppWindow & AppMessageBox
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-pink-600">●</span> AppPopup, AppWindow & AppMessageBox
        <span class="text-xs text-gray-400 font-normal">(DxPopup, DxWindow, DxMessageBox)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Modal popup, draggable window, dan dialog box.</p>

    <div class="flex flex-wrap gap-3">
        <AppButton Text="Open Popup" Variant="AppButtonVariant.Primary" OnClick="@(() => _popupVisible = true)" />
        <AppButton Text="Open Window" Variant="AppButtonVariant.Secondary" OnClick="@(() => _winVisible = true)" />
        <AppButton Text="Show Message" Variant="AppButtonVariant.Outline" OnClick="@(() => _msgVisible = true)" />
    </div>

    <AppPopup HeaderText="Popup Example" @bind-Visible="_popupVisible" Width="400px" Height="auto">
        <BodyContent><p class="text-sm text-gray-600">Ini adalah contoh popup dengan layout Flowbite styling.</p></BodyContent>
    </AppPopup>

    <AppWindow HeaderText="Window Example" @bind-Visible="_winVisible" Width="500px" Height="300px">
        <BodyContent><p class="text-sm text-gray-600">Draggable window dengan header dan body.</p></BodyContent>
    </AppWindow>

    <AppMessageBox @bind-Visible="_msgVisible">
        <BodyContent><p class="text-sm text-gray-600">Konfirmasi aksi ini?</p></BodyContent>
    </AppMessageBox>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcDialogs" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 13: AppSplitter & AppButtonGroup
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
