@implements IDisposable
@page "/example-form"
@attribute [StreamRendering(true)]

<PageTitle>Component Showcase — @_loc.T("app.title")</PageTitle>

<!-- Breadcrumb -->
<nav class="flex items-center gap-2 text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
    <a href="" class="hover:text-green-700 transition-colors">@_loc.T("common.home")</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-800 font-medium">Component Showcase</span>
</nav>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">🎨 UI Component Showcase</h1>
        <p class="text-sm text-gray-500 mt-1">Demo 20+ komponen UI base dengan engine DevExpress & styling Flowbite/Tailwind.</p>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 1: AppTextBox
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-green-600">●</span> AppTextBox
        <span class="text-xs text-gray-400 font-normal">(DxTextBox Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Komponen input teks dengan variasi: default, icon, addon, readonly, disabled, validation.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <AppTextBox Label="Default TextBox" @bind-Value="_txtDefault" Placeholder="Masukkan teks..." InputId="txt-default" WrapperCssClass="w-full" />
        <AppTextBox Label="Required + Helper" @bind-Value="_txtRequired" Placeholder="Wajib diisi" InputId="txt-required" IsRequired="true" HelperText="Field ini wajib diisi." WrapperCssClass="w-full" />
        <AppTextBox Label="Left Icon (Inset)" @bind-Value="_txtLeftIcon" Placeholder="Cari sesuatu..." InputId="txt-left-icon" LeftIcon="🔍" WrapperCssClass="w-full" />
        <AppTextBox Label="Right Icon (Inset)" @bind-Value="_txtRightIcon" Placeholder="Masukkan email" InputId="txt-right-icon" RightIcon="✉️" WrapperCssClass="w-full" />
        <AppTextBox Label="Both Icons (Left + Right)" @bind-Value="_txtBothIcons" Placeholder="username" InputId="txt-both-icons" LeftIcon="👤" RightIcon="✅" WrapperCssClass="w-full" />
        <AppTextBox Label="Left Addon (Input Group)" @bind-Value="_txtLeftAddon" Placeholder="website.com" InputId="txt-left-addon" LeftAddon="https://" WrapperCssClass="w-full" />
        <AppTextBox Label="Right Addon (Input Group)" @bind-Value="_txtRightAddon" Placeholder="0.00" InputId="txt-right-addon" RightAddon=".00" WrapperCssClass="w-full" />
        <AppTextBox Label="Both Addons" @bind-Value="_txtBothAddons" Placeholder="amount" InputId="txt-both-addons" LeftAddon="Rp" RightAddon=",00" WrapperCssClass="w-full" />
        <AppTextBox Label="Addon + Icon Combo" @bind-Value="_txtAddonIcon" Placeholder="812-3456-7890" InputId="txt-addon-icon" LeftAddon="+62" LeftIcon="📱" WrapperCssClass="w-full" />
        <AppTextBox Label="ReadOnly State" Value="Data readonly (tidak bisa diedit)" InputId="txt-readonly" IsReadOnly="true" LeftIcon="🔒" WrapperCssClass="w-full" />
        <AppTextBox Label="Disabled State" Value="Input ini disabled" InputId="txt-disabled" IsDisabled="true" WrapperCssClass="w-full" />
        <AppTextBox Label="Validation Error" @bind-Value="_txtValidation" Placeholder="Email..." InputId="txt-validation" LeftIcon="✉️" ValidationMessage="Format email tidak valid." WrapperCssClass="w-full" />
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcTextBox" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 2: AppTextArea
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-blue-600">●</span> AppTextArea
        <span class="text-xs text-gray-400 font-normal">(DxMemo Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Multi-line text input area.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <AppTextArea Label="Default TextArea" @bind-Value="_txtAreaDefault" Placeholder="Tulis komentar..." InputId="ta-default" WrapperCssClass="w-full" />
        <AppTextArea Label="Required + 5 Rows" @bind-Value="_txtAreaRequired" Placeholder="Masukkan deskripsi lengkap..." InputId="ta-required" IsRequired="true" Rows="5" HelperText="Minimum 50 karakter." WrapperCssClass="w-full" />
        <AppTextArea Label="Disabled TextArea" Value="Konten ini tidak dapat diedit." InputId="ta-disabled" IsDisabled="true" WrapperCssClass="w-full" />
        <AppTextArea Label="ReadOnly TextArea" Value="Ini adalah catatan yang sudah diverifikasi dan tidak bisa diubah." InputId="ta-readonly" IsReadOnly="true" WrapperCssClass="w-full" />
        <AppTextArea Label="Validation Error" @bind-Value="_txtAreaValidation" Placeholder="Tulis alasan..." InputId="ta-validation" ValidationMessage="Alasan harus diisi minimal 10 karakter." WrapperCssClass="w-full" />
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcTextArea" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 3: AppComboBox & AppTagBox
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-purple-600">●</span> AppComboBox & AppTagBox
        <span class="text-xs text-gray-400 font-normal">(DxComboBox & DxTagBox Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Dropdown single-select dan multi-select tag input.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <AppComboBox Label="Default ComboBox" @bind-SelectedValue="_cboDefault" Data="@_unitKerjaOptions" NullText="Pilih Unit Kerja..." WrapperCssClass="w-full" />
        <AppComboBox Label="Required ComboBox" @bind-SelectedValue="_cboRequired" Data="@_statusOptions" NullText="Pilih Status..." IsRequired="true" WrapperCssClass="w-full" />
        <AppComboBox Label="Validation Error" @bind-SelectedValue="_cboValidation" Data="@_statusOptions" NullText="Pilih..." ValidationMessage="Status wajib dipilih." WrapperCssClass="w-full" />
        
        <AppTagBox TData="string" TValue="string" Label="Multi-Select TagBox" Data="@_tagOptions" @bind-Values="_tagSelected" Placeholder="Pilih keahlian..." WrapperCssClass="w-full" />
        <AppTagBox TData="string" TValue="string" Label="Custom Tags Enabled" Data="@_tagOptions" @bind-Values="_tagSelectedCustom" AllowCustomTags="true" Placeholder="Ketik untuk buat tag baru..." WrapperCssClass="w-full" />
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcComboBox" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 4: AppMaskedInput, AppSpinEdit & Date/Time Editors
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-teal-600">●</span> Specialized Inputs: Mask, Spin, Time & Date Range
        <span class="text-xs text-gray-400 font-normal">(DxMaskedInput, DxSpinEdit, DxTimeEdit, DxDateEdit, DxDateRangePicker)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Komponen input khusus angka, tanggal, waktu, dan format tersaring.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <AppMaskedInput Label="No. Telepon (Masked)" @bind-Value="_maskPhone" Mask="(0000) 0000-0000" Placeholder="(0812) 3456-7890" HelperText="Format telepon seluler" WrapperCssClass="w-full" />
        <AppMaskedInput Label="NIK KTP (Masked)" @bind-Value="_maskNik" Mask="0000 0000 0000 0000" Placeholder="16 digit NIK" IsRequired="true" WrapperCssClass="w-full" />
        <AppSpinEdit T="int?" Label="Jumlah Unit (SpinEdit)" @bind-Value="_spinInt" MinValue="1" MaxValue="100" Increment="1" WrapperCssClass="w-full" />
        <AppSpinEdit T="decimal?" Label="Harga / Nominal (SpinEdit)" @bind-Value="_spinDecimal" MinValue="0m" MaxValue="1000000m" Increment="5000m" WrapperCssClass="w-full" />
        <AppDateEdit Label="Tanggal Lahir (DateEdit)" @bind-Value="_dateValue" Placeholder="Pilih tanggal..." WrapperCssClass="w-full" />
        <AppTimeEdit Label="Jam Operasional (TimeEdit)" @bind-Time="_timeValue" Placeholder="Pilih jam..." WrapperCssClass="w-full" />
        <AppDateRangePicker Label="Rentang Tanggal (DateRangePicker)" @bind-StartDate="_startDate" @bind-EndDate="_endDate" WrapperCssClass="w-full md:col-span-2 xl:col-span-3" />
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcSpecializedInputs" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 5: AppCheckBox & AppRadioButtonList
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-orange-600">●</span> Selection Controls: AppCheckBox & AppRadioButtonList
    </h2>
    <p class="text-xs text-gray-400 mb-5">Pilihan biner (toggle) dan kelompok pilihan tunggal.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <div class="space-y-3">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Checkboxes</p>
            <AppCheckBox Text="Saya setuju dengan Syarat & Ketentuan" @bind-Checked="_chkAgree" />
            <AppCheckBox Text="Berlangganan newsletter mingguan" @bind-Checked="_chkNewsletter" />
            <AppCheckBox Text="Aktifkan notifikasi email" @bind-Checked="_chkNotif" />
            <AppCheckBox Text="Disabled Checkbox" Checked="true" IsDisabled="true" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Jenis Kelamin (RadioList)</label>
            <AppRadioButtonList TValue="string" Data="@_genderOptions" @bind-Value="_radioGender" />
            <p class="mt-2 text-xs text-gray-400">Terpilih: <strong>@(_radioGender ?? "-")</strong></p>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Tingkat Prioritas (RadioList)</label>
            <AppRadioButtonList TValue="string" Data="@_priorityOptions" @bind-Value="_radioPriority" />
            <p class="mt-2 text-xs text-gray-400">Terpilih: <strong>@(_radioPriority ?? "-")</strong></p>
        </div>
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcCheckBox" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 6: AppTabs, AppAccordion & AppCarousel
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-pink-600">●</span> Navigation & Containers: AppTabs, AppAccordion & AppCarousel
        <span class="text-xs text-gray-400 font-normal">(DxTabs, DxAccordion, DxCarousel Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Komponen kontainer dan tab navigasi interaktif.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @* AppTabs *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppTabs (DxTabs)</h3>
            <AppTabs @bind-ActiveTabIndex="_activeTab">
                <DxTab Text="Overview" />
                <DxTab Text="Spesifikasi" />
                <DxTab Text="Dokumen" />
            </AppTabs>
            <div class="p-4 bg-gray-50 rounded-b-lg border border-t-0 border-gray-200 text-xs text-gray-600">
                @if (_activeTab == 0)
                {
                    <p>Tab Overview: Menampilkan rangkuman informasi sistem.</p>
                }
                else if (_activeTab == 1)
                {
                    <p>Tab Spesifikasi: Menampilkan detail teknis infrastruktur.</p>
                }
                else
                {
                    <p>Tab Dokumen: Daftar lampiran dan berkas pendukung.</p>
                }
            </div>
        </div>

        @* AppAccordion *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppAccordion (DxAccordion)</h3>
            <AppAccordion ExpandMode="AccordionExpandMode.SingleOrNone">
                <DxAccordionItem Text="Pertanyaan 1: Apakah sistem aman?">
                    <ContentTemplate>
                        <p class="text-xs text-gray-600 p-2">Ya, sistem menggunakan enkripsi HMAC-SHA256 & AES-256-GCM.</p>
                    </ContentTemplate>
                </DxAccordionItem>
                <DxAccordionItem Text="Pertanyaan 2: Berapa batas layar simultan?">
                    <ContentTemplate>
                        <p class="text-xs text-gray-600 p-2">Akun standar mendukung hingga 5 sub-profil aktif.</p>
                    </ContentTemplate>
                </DxAccordionItem>
            </AppAccordion>
        </div>
    </div>

    @* AppCarousel *@
    <div class="mt-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">AppCarousel (DxCarousel)</h3>
        <AppCarousel TData="CarouselCard" Data="@_carouselCards" Height="140px">
            <ItemTemplate>
                <div class="h-full flex flex-col justify-center px-8 text-white rounded-lg p-4" style="background: @_carouselBgColor(context.Id)">
                    <h4 class="text-base font-bold">@context.Title</h4>
                    <p class="text-xs opacity-90 mt-1">@context.Description</p>
                </div>
            </ItemTemplate>
        </AppCarousel>
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcNavigationContainers" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 7: AppProgressBar, AppToast, AppCalendar & AppColorPalette
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-yellow-600">●</span> Feedback & Display: ProgressBar, Toast, Calendar & ColorPalette
    </h2>
    <p class="text-xs text-gray-400 mb-5">Komponen umpan balik visual dan selektor warna/kalender.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
        @* AppProgressBar *@
        <div class="space-y-3">
            <h3 class="text-sm font-semibold text-gray-700">AppProgressBar</h3>
            <AppProgressBar Value="@_progressValue" ShowLabel="true" Label="Progress Pengunggahan" />
            <div class="flex gap-2">
                <AppButton Text="-" Size="AppButtonSize.Small" Variant="AppButtonVariant.Secondary" OnClick="@(() => _progressValue = Math.Max(0, _progressValue - 10))" />
                <AppButton Text="+" Size="AppButtonSize.Small" Variant="AppButtonVariant.Primary" OnClick="@(() => _progressValue = Math.Min(100, _progressValue + 10))" />
            </div>
        </div>

        @* AppToast Trigger *@
        <div class="space-y-3">
            <h3 class="text-sm font-semibold text-gray-700">AppToast Trigger</h3>
            <p class="text-xs text-gray-400">Klik tombol untuk menampilkan notifikasi toast.</p>
            <AppButton Text="Tampilkan Toast Success" Variant="AppButtonVariant.Primary" OnClick="@TriggerSuccessToast" />
        </div>

        @* AppCalendar *@
        <div class="space-y-3">
            <h3 class="text-sm font-semibold text-gray-700">AppCalendar</h3>
            <AppCalendar @bind-SelectedDate="@_calSelected" />
            <p class="text-xs text-gray-400">Tanggal: <strong>@(_calSelected?.ToString("dd MMM yyyy") ?? "-")</strong></p>
        </div>

        @* AppColorPalette *@
        <div class="space-y-3">
            <h3 class="text-sm font-semibold text-gray-700">AppColorPalette</h3>
            <AppColorPalette @bind-Value="@_colorSelected" Label="Pilih Warna Tema" />
            <div class="flex items-center gap-2 text-xs text-gray-500 mt-2">
                <span>Warna aktif:</span>
                <span class="w-4 h-4 rounded-full border border-gray-300 inline-block" style="background-color: @_colorSelected"></span>
                <strong>@_colorSelected</strong>
            </div>
        </div>
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcFeedbackDisplay" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 8: AppChart & AppPivotGrid
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-indigo-600">●</span> Analytics: AppChart & AppPivotGrid
        <span class="text-xs text-gray-400 font-normal">(DxChart & DxPivotGrid Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Visualisasi data grafik dan agregasi multi-dimensi.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @* AppChart *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppChart (Bar & Line Series)</h3>
            <AppChart TData="ChartRecord" Data="@_chartRecords" Height="260px">
                <DxChartBarSeries T="ChartRecord" TArgument="string" TValue="int" Name="Target" ArgumentField="@(s => s.Bulan)" ValueField="@(s => s.Target)" />
                <DxChartLineSeries T="ChartRecord" TArgument="string" TValue="int" Name="Realisasi" ArgumentField="@(s => s.Bulan)" ValueField="@(s => s.Realisasi)" />
            </AppChart>
        </div>

        @* AppPivotGrid *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppPivotGrid</h3>
            <AppPivotGrid TData="PivotRecord" Data="@_pivotRecords" Height="260px">
                <DxPivotGridField Field="@nameof(PivotRecord.Wilayah)" Area="PivotGridFieldArea.Row" />
                <DxPivotGridField Field="@nameof(PivotRecord.Kategori)" Area="PivotGridFieldArea.Column" />
                <DxPivotGridField Field="@nameof(PivotRecord.Total)" Area="PivotGridFieldArea.Data" SummaryType="PivotGridSummaryType.Sum" />
            </AppPivotGrid>
        </div>
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcAnalytics" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 9: AppTreeList, AppHtmlEditor & AppFileInput
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-emerald-600">●</span> Advanced Components: AppTreeList, AppHtmlEditor & AppFileInput
    </h2>
    <p class="text-xs text-gray-400 mb-5">Struktur hirarki data, WYSIWYG editor HTML, dan pengunggah berkas.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        @* AppTreeList *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppTreeList (Struktur Organisasi)</h3>
            <AppTreeList TData="OrgNode" Data="@_orgNodes" KeyFieldName="Id" ParentKeyFieldName="ParentId">
                <DxTreeListDataColumn FieldName="Nama" Caption="Nama Pegawai" />
                <DxTreeListDataColumn FieldName="Jabatan" Caption="Jabatan" />
            </AppTreeList>
        </div>

        @* AppFileInput *@
        <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">AppFileInput (File Upload)</h3>
            <AppFileInput Label="Unggah Dokumen Lampiran" AllowMultiFileUpload="true" MaxFileSize="5000000" HelperText="Format: PDF, PNG, JPG (Maks. 5MB)" FilesUploading="@HandleFilesUploading" />
            @if (!string.IsNullOrEmpty(_uploadStatus))
            {
                <AppAlertBox Text="@_uploadStatus" Variant="AppAlertVariant.Info" CssClass="mt-3" />
            }
        </div>
    </div>

    @* AppHtmlEditor *@
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">AppHtmlEditor (WYSIWYG Rich Editor)</h3>
        <AppHtmlEditor @bind-Markup="@_htmlMarkup" Height="220px" Label="Catatan Dokumen Official" />
    </div>
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcAdvancedComponents" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 10: AppGrid dengan Integration DxContextMenu
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-indigo-600">●</span> AppGrid dengan Right-Click Context Menu
        <span class="text-xs text-gray-400 font-normal">(DxGrid + DxContextMenu Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Klik kanan pada baris tabel untuk menampilkan aksi Context Menu.</p>

    <AppGrid Data="@_gridData" PageSize="5" ShowPagination="true" ContextMenuItems="@_contextMenuItems" OnContextMenuItemClick="@HandleContextMenuClick" CssClass="w-full">
        <DxGridDataColumn FieldName="Id" Caption="ID" Width="60px" />
        <DxGridDataColumn FieldName="Nama" Caption="Nama Karyawan" Width="180px" />
        <DxGridDataColumn FieldName="Email" Caption="Email" Width="200px" />
        <DxGridDataColumn FieldName="UnitKerja" Caption="Unit Kerja" Width="200px" />
        <DxGridDataColumn FieldName="Status" Caption="Status" Width="100px" />
    </AppGrid>

    @if (!string.IsNullOrEmpty(_contextFeedback))
    {
        <AppAlertBox Text="@_contextFeedback" Variant="AppAlertVariant.Success" CssClass="mt-3" />
    }
    <div class="border-t border-gray-100 pt-4 mt-4">
        <AppSourceViewer Code="@_srcGrid" />
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════
   SECTION 11: AppMenu, AppToolbar & AppDropDown
   ═══════════════════════════════════════════════════════════════════ *@
<div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center gap-2">
        <span class="text-orange-600">●</span> AppMenu, AppToolbar & AppDropDown
        <span class="text-xs text-gray-400 font-normal">(DxMenu, DxToolbar, DxDropDown Engine)</span>
    </h2>
    <p class="text-xs text-gray-400 mb-5">Navigation menu, toolbar, dan dropdown panel.</p>

