        </div>
        <div>
            <p class="text-sm font-medium text-gray-700 mb-2">AppWaitIndicator</p>
            <AppButton Text="Toggle Wait" Variant="AppButtonVariant.Secondary" Size="AppButtonSize.Small" OnClick="@(() => _waitVisible = !_waitVisible)" />
