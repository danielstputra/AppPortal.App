@page "/logout"
@attribute [AllowAnonymous]

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="flex items-center justify-center min-h-screen bg-gradient-to-br from-green-700 via-green-800 to-green-900">
    <div class="text-center">
        <div class="w-10 h-10 border-2 border-white border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
        <p class="text-white/70">Logging out...</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.Logout();
        try { await JS.InvokeVoidAsync("localStorage.removeItem", "access_token"); } catch { }
        try { await JS.InvokeVoidAsync("localStorage.removeItem", "refresh_token"); } catch { }
        try { await JS.InvokeVoidAsync("localStorage.clear"); } catch { }
        Navigation.NavigateTo("/login?force=1");
    }
}
