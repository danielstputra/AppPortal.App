@page "/login"
@layout AuthLayout
@implements IDisposable
@attribute [AllowAnonymous]

@inject IAuthService AuthService
@inject LocalizationService _loc
@inject NavigationManager Navigation

<PageTitle>@_loc.T("login.pageTitle") — AppPortal</PageTitle>

<div class="flex min-h-screen items-center justify-center px-4 py-8 md:py-12">
    <div class="w-full max-w-4xl">

        @* ─── Logo / Brand (mobile only, above card) ─── *@
        <div class="text-center mb-6 md:hidden">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm mb-3">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">AppPortal</h1>
            <p class="text-sm text-white/70 mt-1">@_loc.T("login.subtitle")</p>
        </div>

        @* ─── Unified Card — Left (login) + Right (slider) ─── *@
        <AppCard CssClass="overflow-hidden p-0">
            <div class="grid grid-cols-1 md:grid-cols-2">

                @* ─── LEFT: Login Form ─── *@
                <div class="p-6 sm:p-8">
                    @* Logo / Brand (desktop, inside card) *@
                    <div class="hidden md:block mb-6">
                        <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gradient-to-br from-green-100 to-green-50 mb-3">
                            <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                            </svg>
                        </div>
                        <h2 class="text-lg font-bold text-gray-900">@_loc.T("login.welcomeBack")</h2>
                        <p class="text-sm text-gray-500 mt-0.5">@_loc.T("login.signInPrompt")</p>
                    </div>

                    @if (_isError)
                    {
                        <div class="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg flex items-start gap-2">
                            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                            <span>@_errorMessage</span>
                        </div>
                    }

                    <div class="space-y-5">
                        <AppTextBox Label="@_loc.T("login.email")"
                                    @bind-Value="_email"
                                    InputType="email"
                                    Placeholder="you@example.com"
                                    WrapperCssClass="w-full" />

                        <AppTextBox Label="@_loc.T("login.password")"
                                    @bind-Value="_password"
                                    InputType="password"
                                    Placeholder="••••••••"
                                    WrapperCssClass="w-full" />

                        <div class="flex items-center justify-between">
                            <AppCheckBox @bind-Checked="_remember" Text="@_loc.T("login.rememberMe")" />
                            <a href="#" class="text-sm text-green-700 hover:text-green-800 font-medium">@_loc.T("login.forgotPassword")</a>
                        </div>

                        <AppButton Text="@_loc.T("login.signIn")"
                                   Variant="AppButtonVariant.Primary"
                                   IsLoading="@_isLoading"
                                   CssClass="w-full justify-center py-2.5"
                                   OnClick="@HandleLogin" />
                    </div>

                    <div class="mt-6 text-center">
                        <p class="text-sm text-gray-500">
                            @_loc.T("login.noAccount")
                            <a href="#" class="text-green-700 hover:text-green-800 font-medium">@_loc.T("login.signUp")</a>
                        </p>
                    </div>
                </div>

                @* ─── Vertical Divider ─── *@
                <div class="hidden md:block w-px bg-gray-200"></div>

                @* ─── RIGHT: Feature Slider ─── *@
                <div class="hidden md:flex flex-col justify-center p-6 sm:p-8 bg-gradient-to-br from-green-50 via-white to-green-50">
                    <div class="relative">
                        @foreach (var (slide, idx) in _slides.Select((s, i) => (s, i)))
                        {
                            <div class="transition-all duration-500 @(idx == _currentSlide ? "opacity-100 visible" : "opacity-0 invisible absolute inset-0")">
                                <div class="text-center">
                                    <div class="w-16 h-16 rounded-2xl bg-white shadow-sm border border-green-100 flex items-center justify-center mx-auto mb-5">
                                        <span class="text-3xl">@slide.Icon</span>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900 mb-3">@slide.Title</h3>
                                    <p class="text-sm text-gray-500 leading-relaxed mb-6">@slide.Description</p>
                                    <ul class="space-y-2.5 text-left max-w-xs mx-auto">
                                        @foreach (var feature in slide.Features)
                                        {
                                            <li class="flex items-start gap-2.5 text-sm text-gray-600">
                                                <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                <span>@feature</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }

                        <div class="flex items-center justify-center gap-2 pt-6">
                            @for (var i = 0; i < _slides.Length; i++)
                            {
                                <button type="button" class="w-2 h-2 rounded-full transition-all duration-300 @(i == _currentSlide ? "bg-green-700 w-6" : "bg-gray-300 hover:bg-gray-400")"
                                        @onclick="@(() => GoToSlide(i))" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </AppCard>

        @* ─── Footer ─── *@
        <p class="text-center text-xs text-white/50 mt-6">
            &copy; 2026 AppPortal. All rights reserved.
        </p>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _remember;
    private bool _isLoading;
    private bool _isError;
    private string _errorMessage = "";
    private int _currentSlide;
    private Timer? _slideTimer;
    private const int SLIDE_INTERVAL_MS = 4500;

    private readonly Slide[] _slides = new[]
    {
        new Slide { Icon = "🚀", Title = "Enterprise Performance",
            Description = "Lightning-fast data processing & real-time sync for enterprise apps.",
            Features = new[] { "Optimized server-side rendering", "Real-time data synchronization", "Scalable microservices architecture" } },
        new Slide { Icon = "🎨", Title = "Modern UI/UX",
            Description = "Flowbite-inspired design with Tailwind CSS — responsive across all devices.",
            Features = new[] { "Mobile-first responsive layout", "Accessible WCAG 2.1 compliant", "Consistent design system" } },
        new Slide { Icon = "🔒", Title = "Enterprise Security",
            Description = "End-to-end encryption with AES-256-GCM & HMAC-SHA256 signing.",
            Features = new[] { "AES-256-GCM data encryption", "HMAC-SHA256 API signing", "Role-based access control" } },
        new Slide { Icon = "📊", Title = "Advanced Analytics",
            Description = "Interactive dashboards with pivot grids, charts & real-time reporting.",
            Features = new[] { "Interactive pivot tables", "Real-time chart updates", "Export to PDF & XLSX" } },
    };

    protected override void OnInitialized()
    {
        _slideTimer = new Timer(_ => { InvokeAsync(() => NextSlide()); }, null, SLIDE_INTERVAL_MS, SLIDE_INTERVAL_MS);
    }

    private void NextSlide() => _currentSlide = (_currentSlide + 1) % _slides.Length;
    private void GoToSlide(int idx) { _currentSlide = idx; ResetTimer(); }
    private void ResetTimer() => _slideTimer?.Change(SLIDE_INTERVAL_MS, SLIDE_INTERVAL_MS);

    private async Task HandleLogin()
    {
        _isError = false; _isLoading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            { _isError = true; _errorMessage = _loc.T("login.validationRequired"); return; }

            var result = await AuthService.LoginAsync(_email, _password);
            if (result != null)
                Navigation.NavigateTo("/dashboard");
            else
            { _isError = true; _errorMessage = _loc.T("login.invalidCredentials"); }
        }
        catch { _isError = true; _errorMessage = _loc.T("login.errorUnexpected"); }
        finally { _isLoading = false; }
    }

    public void Dispose() => _slideTimer?.Dispose();

    private record Slide
    {
        public string Icon { get; init; } = "";
        public string Title { get; init; } = "";
        public string Description { get; init; } = "";
        public string[] Features { get; init; } = Array.Empty<string>();
    }
}
