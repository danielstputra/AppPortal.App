@implements IDisposable
@page "/employee-data/{Id:int}"
@attribute [StreamRendering(true)]
@attribute [Authorize]

<PageTitle>Detail Karyawan — @_loc.T("app.title")</PageTitle>

<AppPageNav Title="Detail Karyawan"
            Subtitle="Informasi lengkap data karyawan."
            BreadcrumbItems="@_bc">
    <Actions>
        <a href="@($"/employee-data/{Id}/edit")" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-700 rounded-lg hover:bg-green-800 transition-colors">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edit
        </a>
    </Actions>
</AppPageNav>

@if (_emp is null)
{
    <div class="text-center py-12 text-gray-400">Memuat data...</div>
}
else
{
    <div class="max-w-2xl">
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-900">@_emp.NamaKaryawan</h2>
                <span class="px-3 py-1 rounded-full text-xs font-medium
                    @(_emp.Status == StatusKaryawan.Active ? "bg-green-100 text-green-700" :
                      _emp.Status == StatusKaryawan.Resigned ? "bg-red-100 text-red-700" :
                      "bg-yellow-100 text-yellow-700")">
                    @_emp.Status
                </span>
            </div>

            <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div><dt class="text-gray-400">NIK</dt><dd class="font-medium text-gray-900">@_emp.Nik</dd></div>
                <div><dt class="text-gray-400">Jabatan</dt><dd class="font-medium text-gray-900">@_emp.Jabatan</dd></div>
                <div><dt class="text-gray-400">Unit Kerja</dt><dd class="font-medium text-gray-900">@_emp.UnitKerja</dd></div>
                <div><dt class="text-gray-400">Organisasi</dt><dd class="font-medium text-gray-900">@_emp.Organisasi</dd></div>
                <div><dt class="text-gray-400">Sumber Data</dt><dd class="font-medium text-gray-900">@_emp.SumberData</dd></div>
            </dl>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private LocalizationService _loc { get; set; } = default!;

    private Employee? _emp;
    private Action? _langHandler;

    private List<BreadcrumbItem> _bc = new()
    {
        new() { Text = "Home", Url = "" },
        new() { Text = "Employee Data", Url = "/employee-data" },
        new() { Text = "Detail" }
    };

    protected override void OnInitialized()
    {
        _langHandler = () => InvokeAsync(StateHasChanged);
        _loc.OnLanguageChanged += _langHandler;
    }

    protected override async Task OnParametersSetAsync()
    {
        var all = await EmployeeService.GetEmployeesAsync();
        _emp = all.FirstOrDefault(e => e.No == Id);
    }

    public void Dispose()
    {
        if (_langHandler != null)
            _loc.OnLanguageChanged -= _langHandler;
    }
}
