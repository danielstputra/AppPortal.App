@namespace AppPortal.App.Components.BumitamaKit.Actions.BumiButtonGroup

@using DevExpress.Blazor
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton

<div class="bumi-button-group-theme bumi-theme-@Theme.ToString().ToLower()" 
     style="@GetWrapperStyle()">
    <DxButtonGroup RenderStyle="@DxRenderStyle"
                   RenderStyleMode="@DxRenderStyleMode"
                   SizeMode="@DxSizeMode"
                   SelectionMode="@SelectionMode"
                   Orientation="@Orientation">
        <Items>
            @ChildContent
        </Items>
    </DxButtonGroup>
</div>

@code {
    private string GetWrapperStyle()
    {
        const string brandColor = "#00bf63";

        if (Color == ButtonColor.Brand)
        {
            return $"--dx-color-primary: {brandColor} !important;";
        }

        if (Color == ButtonColor.Custom && !string.IsNullOrEmpty(CustomColor))
        {
            return $"--dx-color-primary: {CustomColor} !important;";
        }

        return "";
    }
}

