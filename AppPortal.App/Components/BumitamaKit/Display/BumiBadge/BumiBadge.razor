@namespace AppPortal.App.Components.BumitamaKit.Display.BumiBadge

<span class="bumi-badge bumi-badge-@Color.ToString().ToLower() bumi-badge-@Variant.ToString().ToLower() bumi-badge-@Size.ToString().ToLower() bumi-theme-@Theme.ToString().ToLower() @CssClass"
      style="@GetBadgeStyle()">
    @if (!string.IsNullOrEmpty(IconCssClass))
    {
        <i class="@IconCssClass bumi-badge-icon"></i>
    }
    @Text
    @ChildContent
</span>

@code {
    private string GetBadgeStyle()
    {
        var styles = new List<string>();

        if (Color == BadgeColor.Custom && !string.IsNullOrEmpty(CustomColor))
        {
            styles.Add($"background-color: {CustomColor}");
            styles.Add("color: #ffffff");
        }

        if (!string.IsNullOrEmpty(CustomStyle))
        {
            styles.Add(CustomStyle);
        }

        return string.Join("; ", styles);
    }
}
