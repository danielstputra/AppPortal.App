@namespace AppPortal.App.Components.BumitamaKit.Display.BumiCard

<div class="bumi-card bumi-card-@Variant.ToString().ToLower() bumi-theme-@Theme.ToString().ToLower() @CssClass"
     style="@GetCardStyle()">
    @if (!string.IsNullOrEmpty(Header) || HeaderContent != null)
    {
        <div class="bumi-card-header">
            @if (HeaderContent != null)
            {
                @HeaderContent
            }
            else
            {
                @Header
            }
        </div>
    }
    
    <div class="bumi-card-body">
        @ChildContent
    </div>
    
    @if (!string.IsNullOrEmpty(Footer) || FooterContent != null)
    {
        <div class="bumi-card-footer">
            @if (FooterContent != null)
            {
                @FooterContent
            }
            else
            {
                @Footer
            }
        </div>
    }
</div>

@code {
    private string GetCardStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrEmpty(Width))
        {
            styles.Add($"width: {Width}");
        }

        if (!string.IsNullOrEmpty(Height))
        {
            styles.Add($"height: {Height}");
        }

        if (!string.IsNullOrEmpty(CustomStyle))
        {
            styles.Add(CustomStyle);
        }

        return string.Join("; ", styles);
    }
}
