@namespace AppPortal.App.Components.BumitamaKit.Indicator.BumiSteps

<div class="bumi-steps bumi-steps-@Orientation.ToString().ToLower() bumi-theme-@Theme.ToString().ToLower() @CssClass"
     style="@GetStepsStyle()">
    @ChildContent
</div>

@code {
    private string GetStepsStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrEmpty(Width))
        {
            styles.Add($"width: {Width}");
        }

        return string.Join("; ", styles);
    }
}
