@namespace AppPortal.App.Components.BumitamaKit.Indicator.BumiSteps

<div class="bumi-steps-item @(IsCompleted ? "bumi-steps-completed" : "") @(IsActive ? "bumi-steps-active" : "")">
    <div class="bumi-steps-icon">
        @if (IsCompleted)
        {
            <i class="fas fa-check"></i>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <i class="@Icon"></i>
        }
        else
        {
            <span>@StepNumber</span>
        }
    </div>
    <div class="bumi-steps-content">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="bumi-steps-title">@Title</div>
        }
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="bumi-steps-description">@Description</div>
        }
    </div>
</div>
