@namespace AppPortal.App.Components.BumitamaKit.Input.BumiCheckbox

<label class="@GetCheckboxClasses()" style="@CustomStyle">
    <input type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           @onchange="HandleChange"
           class="bumi-checkbox-input" />
    
    <span class="bumi-checkbox-box">
        @if (Checked && !Indeterminate)
        {
            @if (!string.IsNullOrEmpty(IconCssClass))
            {
                <i class="@IconCssClass"></i>
            }
            else
            {
                <i class="fas fa-check"></i>
            }
        }
        else if (Indeterminate)
        {
            <i class="fas fa-minus"></i>
        }
    </span>

    @if (LabelContent != null)
    {
        <span class="bumi-checkbox-label">
            @LabelContent
        </span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span class="bumi-checkbox-label">@Label</span>
    }
</label>
