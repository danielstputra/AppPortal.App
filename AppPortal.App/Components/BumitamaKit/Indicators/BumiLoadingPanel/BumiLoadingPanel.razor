@namespace AppPortal.App.Components.BumitamaKit.Indicators.BumiLoadingPanel

@using DevExpress.Blazor

<div class="bumi-loadingpanel-theme bumi-theme-@Theme.ToString().ToLower()" style="@GetWrapperStyle()">
    <DxLoadingPanel CssClass="@GetDynamicCssClass()" style="@GetComponentStyle()">
        @ChildContent
    </DxLoadingPanel>
</div>

@code {
    private string GetWrapperStyle()
    {
        if (!string.IsNullOrEmpty(CustomColor))
        {
            return $"--bumi-custom-color: {CustomColor};";
        }
        return "";
    }

    private string GetComponentStyle()
    {
        var styles = new List<string>();
        return string.Join("; ", styles);
    }

    private string GetDynamicCssClass()
    {
        var classes = $"bumi-loadingpanel bumi-loadingpanel-{Theme.ToString().ToLower()}";
        if (!string.IsNullOrEmpty(CssClass))
        {
            classes += $" {CssClass}";
        }
        return classes.Trim();
    }
}
