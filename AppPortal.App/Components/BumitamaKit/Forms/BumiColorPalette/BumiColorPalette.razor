@namespace AppPortal.App.Components.BumitamaKit.Forms.BumiColorPalette

@using DevExpress.Blazor

<div class="bumi-colorpalette-theme bumi-theme-@Theme.ToString().ToLower()" style="@GetWrapperStyle()">
    <DxColorPalette CssClass="@GetDynamicCssClass()" 
                    style="@GetComponentStyle()"
                    @bind-Value="@Value">
        @ChildContent
    </DxColorPalette>
</div>

@code {
    private string GetWrapperStyle()
    {
        if (!string.IsNullOrEmpty(CustomColor))
        {
            return $"--bumi-custom-color: {CustomColor};";
        }
        return "";
    }

    private string GetComponentStyle()
    {
        var styles = new List<string>();
        return string.Join("; ", styles);
    }

    private string GetDynamicCssClass()
    {
        var classes = $"bumi-colorpalette bumi-colorpalette-{Theme.ToString().ToLower()}";
        if (!string.IsNullOrEmpty(CssClass))
        {
            classes += $" {CssClass}";
        }
        return classes.Trim();
    }
}
