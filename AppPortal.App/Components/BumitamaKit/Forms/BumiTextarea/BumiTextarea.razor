@namespace AppPortal.App.Components.BumitamaKit.Forms.BumiTextarea

@using DevExpress.Blazor

<div class="bumi-textarea-theme bumi-theme-@Theme.ToString().ToLower()">
    <DxMemo Text="@Value"
            TextChanged="@HandleTextChanged"
            Enabled="@(!Disabled && !ReadOnly)"
            ReadOnly="@ReadOnly"
            SizeMode="@DxSizeMode"
            CssClass="@GetDynamicCssClass()"
            style="@GetTextareaStyle()"
            NullText="@Placeholder"
            Rows="@Rows"
            MaxLength="@MaxLength">
        @if (!string.IsNullOrEmpty(Label))
        {
            <DxMemoLabel Text="@Label" />
        }
    </DxMemo>
    @if (ShowCharacterCount && MaxLength.HasValue)
    {
        <div class="bumi-textarea-count">
            @(Value?.Length ?? 0) / @MaxLength
        </div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bumi-textarea-error">@ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="bumi-textarea-helper">@HelperText</div>
    }
</div>

@code {
    private string GetTextareaStyle()
    {
        var styles = new List<string>();
        
        if (!string.IsNullOrEmpty(Width))
        {
            styles.Add($"width: {Width}");
        }

        if (!string.IsNullOrEmpty(Height))
        {
            styles.Add($"height: {Height}");
        }

        if (HasError)
        {
            styles.Add("border-color: #dc3545 !important");
        }

        return string.Join("; ", styles);
    }

    private string GetDynamicCssClass()
    {
        var classes = $"bumi-textarea bumi-textarea-{Theme.ToString().ToLower()}";

        if (HasError)
        {
            classes += " bumi-textarea-error-state";
        }

        if (!string.IsNullOrEmpty(CssClass))
        {
            classes += $" {CssClass}";
        }

        return classes.Trim();
    }

    private async Task HandleTextChanged(string newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}
