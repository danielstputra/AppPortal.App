@namespace AppPortal.App.Components.BumitamaKit.Forms.BumiInput

@using DevExpress.Blazor

<div class="bumi-input-theme bumi-theme-@Theme.ToString().ToLower()" 
     style="@GetWrapperStyle()">
    <DxTextBox Text="@Value"
               TextChanged="@HandleTextChanged"
               TextExpression="@ValueExpression"
               Enabled="@(!Disabled && !ReadOnly)"
               ReadOnly="@ReadOnly"
               SizeMode="@DxSizeMode"
               CssClass="@GetDynamicCssClass()"
               style="@GetInputStyle()"
               NullText="@Placeholder">
        @if (!string.IsNullOrEmpty(Label))
        {
            <DxTextBoxLabel Text="@Label" />
        }
    </DxTextBox>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bumi-input-error">@ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="bumi-input-helper">@HelperText</div>
    }
</div>

@code {
    private string GetWrapperStyle()
    {
        if (!string.IsNullOrEmpty(CustomColor))
        {
            return $"--bumi-custom-color: {CustomColor};";
        }
        return "";
    }

    private string GetInputStyle()
    {
        var styles = new List<string>();
        
        if (!string.IsNullOrEmpty(Width))
        {
            styles.Add($"width: {Width}");
        }

        if (HasError)
        {
            styles.Add("border-color: #dc3545 !important");
        }

        return string.Join("; ", styles);
    }

    private string GetDynamicCssClass()
    {
        var classes = $"bumi-input bumi-input-{Theme.ToString().ToLower()}";

        if (HasError)
        {
            classes += " bumi-input-error-state";
        }

        if (!string.IsNullOrEmpty(CssClass))
        {
            classes += $" {CssClass}";
        }

        return classes.Trim();
    }

    private async Task HandleTextChanged(string newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}
