@using AppPortal.App.Components.BumitamaKit.Forms.BumiDateRangePicker

@page "/bumitama/date-range-picker"

<PageTitle>Date Range Picker - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / BumiDateRangePicker</p>
        <h1 class="bumitama-title">📅 BumiDateRangePicker</h1>
        <p class="bumitama-subtitle">DxDateRangeEdit component for selecting date ranges with calendar picker.</p>
    </div>

    <!-- Basic Date Range Picker -->
    <div class="bumitama-section">
        <h2>Basic Date Range Picker</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <BumiDateRangePicker @bind-StartDate="@startDate1" 
                                    @bind-EndDate="@endDate1" />
                
                @if (startDate1 != null && endDate1 != null)
                {
                    <div style="margin-top: 15px; padding: 15px; background-color: #e7f5ff; border-radius: 8px;">
                        <strong>Selected Range:</strong><br/>
                        From: @startDate1.Value.ToString("MMM dd, yyyy")<br/>
                        To: @endDate1.Value.ToString("MMM dd, yyyy")<br/>
                        <strong>Duration:</strong> @((endDate1.Value - startDate1.Value).Days + 1) days
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- With Labels -->
    <div class="bumitama-section">
        <h2>With Labels</h2>
        <div class="bumitama-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Project Duration</label>
                    <BumiDateRangePicker @bind-StartDate="@projectStart" 
                                        @bind-EndDate="@projectEnd" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Vacation Period</label>
                    <BumiDateRangePicker @bind-StartDate="@vacationStart" 
                                        @bind-EndDate="@vacationEnd" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Reporting Period</label>
                    <BumiDateRangePicker @bind-StartDate="@reportStart" 
                                        @bind-EndDate="@reportEnd" />
                </div>
            </div>
        </div>
    </div>

    <!-- Themes -->
    <div class="bumitama-section">
        <h2>Themes</h2>
        <div class="bumitama-card">
            <h3 style="margin-bottom: 15px;">Light Theme</h3>
            <div style="max-width: 400px; margin-bottom: 30px;">
                <BumiDateRangePicker Theme="BumiDateRangePickerTheme.Light"
                                    @bind-StartDate="@themeStartLight" 
                                    @bind-EndDate="@themeEndLight" />
            </div>

            <h3 style="margin-bottom: 15px;">Dark Theme</h3>
            <div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px;">
                <div style="max-width: 400px;">
                    <BumiDateRangePicker Theme="BumiDateRangePickerTheme.Dark"
                                        @bind-StartDate="@themeStartDark" 
                                        @bind-EndDate="@themeEndDark" />
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled State -->
    <div class="bumitama-section">
        <h2>Disabled State</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <BumiDateRangePicker Disabled="true"
                                    @bind-StartDate="@disabledStart" 
                                    @bind-EndDate="@disabledEnd" />
            </div>
        </div>
    </div>

    <!-- Preset Ranges -->
    <div class="bumitama-section">
        <h2>Quick Preset Ranges</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <div style="margin-bottom: 15px;">
                    <BumiDateRangePicker @bind-StartDate="@presetStart" 
                                        @bind-EndDate="@presetEnd" />
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetToday">Today</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetYesterday">Yesterday</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetThisWeek">This Week</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetLastWeek">Last Week</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetThisMonth">This Month</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetLastMonth">Last Month</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetLast7Days">Last 7 Days</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetLast30Days">Last 30 Days</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetThisYear">This Year</button>
                </div>

                @if (presetStart != null && presetEnd != null)
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #f9fafb; border-radius: 8px;">
                        <strong>Selected:</strong> @presetStart.Value.ToString("MMM dd, yyyy") - @presetEnd.Value.ToString("MMM dd, yyyy")
                        (@((presetEnd.Value - presetStart.Value).Days + 1) days)
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Form Example -->
    <div class="bumitama-section">
        <h2>Form Example</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <h3 style="margin-bottom: 20px;">Event Registration Form</h3>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Event Name *</label>
                    <input type="text" class="form-control" @bind="eventName" placeholder="Enter event name" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Event Date Range *</label>
                    <BumiDateRangePicker @bind-StartDate="@eventStart" 
                                        @bind-EndDate="@eventEnd" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Description</label>
                    <textarea class="form-control" @bind="eventDescription" rows="3" placeholder="Enter event description"></textarea>
                </div>

                <button class="btn btn-primary" @onclick="SubmitEvent">Register Event</button>

                @if (showEventConfirmation)
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724;">
                        <strong>✓ Event Registered Successfully!</strong><br/>
                        <strong>@eventName</strong><br/>
                        @eventStart?.ToString("MMM dd, yyyy") - @eventEnd?.ToString("MMM dd, yyyy")
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Multiple Date Ranges -->
    <div class="bumitama-section">
        <h2>Multiple Date Ranges Comparison</h2>
        <div class="bumitama-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
                <div>
                    <h4 style="margin-bottom: 15px; color: #007bff;">Current Period</h4>
                    <BumiDateRangePicker @bind-StartDate="@current1Start" 
                                        @bind-EndDate="@current1End" />
                    @if (current1Start != null && current1End != null)
                    {
                        <p style="margin-top: 10px; font-size: 0.875rem; color: #6c757d;">
                            @((current1End.Value - current1Start.Value).Days + 1) days
                        </p>
                    }
                </div>

                <div>
                    <h4 style="margin-bottom: 15px; color: #28a745;">Comparison Period</h4>
                    <BumiDateRangePicker @bind-StartDate="@current2Start" 
                                        @bind-EndDate="@current2End" />
                    @if (current2Start != null && current2End != null)
                    {
                        <p style="margin-top: 10px; font-size: 0.875rem; color: #6c757d;">
                            @((current2End.Value - current2Start.Value).Days + 1) days
                        </p>
                    }
                </div>
            </div>

            @if (current1Start != null && current1End != null && current2Start != null && current2End != null)
            {
                <div style="margin-top: 30px; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
                    <h4 style="margin-bottom: 15px;">Comparison Summary</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Period 1 Duration</div>
                            <div style="font-size: 1.5rem; font-weight: 600; color: #007bff;">
                                @((current1End.Value - current1Start.Value).Days + 1) days
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Period 2 Duration</div>
                            <div style="font-size: 1.5rem; font-weight: 600; color: #28a745;">
                                @((current2End.Value - current2Start.Value).Days + 1) days
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Difference</div>
                            <div style="font-size: 1.5rem; font-weight: 600; color: #6c757d;">
                                @Math.Abs(((current1End.Value - current1Start.Value).Days) - ((current2End.Value - current2Start.Value).Days)) days
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

@code {
    // Basic
    private DateTime? startDate1 = DateTime.Now;
    private DateTime? endDate1 = DateTime.Now.AddDays(7);

    // With Labels
    private DateTime? projectStart = DateTime.Now;
    private DateTime? projectEnd = DateTime.Now.AddMonths(3);
    private DateTime? vacationStart = DateTime.Now.AddMonths(1);
    private DateTime? vacationEnd = DateTime.Now.AddMonths(1).AddDays(10);
    private DateTime? reportStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime? reportEnd = DateTime.Now;

    // Themes
    private DateTime? themeStartLight = DateTime.Now;
    private DateTime? themeEndLight = DateTime.Now.AddDays(5);
    private DateTime? themeStartDark = DateTime.Now;
    private DateTime? themeEndDark = DateTime.Now.AddDays(5);

    // Disabled
    private DateTime? disabledStart = DateTime.Now.AddDays(-7);
    private DateTime? disabledEnd = DateTime.Now;

    // Presets
    private DateTime? presetStart = DateTime.Now;
    private DateTime? presetEnd = DateTime.Now.AddDays(7);

    // Form
    private string eventName = "";
    private DateTime? eventStart = DateTime.Now.AddDays(7);
    private DateTime? eventEnd = DateTime.Now.AddDays(10);
    private string eventDescription = "";
    private bool showEventConfirmation = false;

    // Comparison
    private DateTime? current1Start = DateTime.Now.AddDays(-30);
    private DateTime? current1End = DateTime.Now;
    private DateTime? current2Start = DateTime.Now.AddDays(-60);
    private DateTime? current2End = DateTime.Now.AddDays(-30);

    private void SetToday()
    {
        presetStart = DateTime.Now.Date;
        presetEnd = DateTime.Now.Date;
    }

    private void SetYesterday()
    {
        presetStart = DateTime.Now.Date.AddDays(-1);
        presetEnd = DateTime.Now.Date.AddDays(-1);
    }

    private void SetThisWeek()
    {
        var today = DateTime.Now.Date;
        var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
        presetStart = startOfWeek;
        presetEnd = startOfWeek.AddDays(6);
    }

    private void SetLastWeek()
    {
        var today = DateTime.Now.Date;
        var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
        presetStart = startOfWeek.AddDays(-7);
        presetEnd = startOfWeek.AddDays(-1);
    }

    private void SetThisMonth()
    {
        var today = DateTime.Now;
        presetStart = new DateTime(today.Year, today.Month, 1);
        presetEnd = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
    }

    private void SetLastMonth()
    {
        var today = DateTime.Now;
        var lastMonth = today.AddMonths(-1);
        presetStart = new DateTime(lastMonth.Year, lastMonth.Month, 1);
        presetEnd = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
    }

    private void SetLast7Days()
    {
        presetEnd = DateTime.Now.Date;
        presetStart = presetEnd.Value.AddDays(-6);
    }

    private void SetLast30Days()
    {
        presetEnd = DateTime.Now.Date;
        presetStart = presetEnd.Value.AddDays(-29);
    }

    private void SetThisYear()
    {
        var today = DateTime.Now;
        presetStart = new DateTime(today.Year, 1, 1);
        presetEnd = new DateTime(today.Year, 12, 31);
    }

    private void SubmitEvent()
    {
        if (!string.IsNullOrWhiteSpace(eventName) && eventStart != null && eventEnd != null)
        {
            showEventConfirmation = true;
            StateHasChanged();
        }
    }
}
