@using DevExpress.Blazor

@page "/bumitama/combobox"

<PageTitle>ComboBox - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / DxComboBox</p>
        <h1 class="bumitama-title">📋 DxComboBox</h1>
        <p class="bumitama-subtitle">DxComboBox component for dropdown selection with search and filtering.</p>
    </div>

    <!-- Basic ComboBox -->
    <div class="bumitama-section">
        <h2>Basic ComboBox</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <DxComboBox Data="@countries" 
                           @bind-Value="@selectedCountry"
                           TextFieldName="Name" />
                
                @if (!string.IsNullOrEmpty(selectedCountry))
                {
                    <div style="margin-top: 15px; padding: 15px; background-color: #e7f5ff; border-radius: 8px;">
                        <strong>Selected Country:</strong> @selectedCountry
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- With Labels -->
    <div class="bumitama-section">
        <h2>With Labels</h2>
        <div class="bumitama-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Country</label>
                    <DxComboBox Data="@countries" 
                               @bind-Value="@country1"
                               TextFieldName="Name" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">City</label>
                    <DxComboBox Data="@cities" 
                               @bind-Value="@city1"
                               TextFieldName="Name" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Department</label>
                    <DxComboBox Data="@departments" 
                               @bind-Value="@department1"
                               TextFieldName="Name" />
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled State -->
    <div class="bumitama-section">
        <h2>Disabled State</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <DxComboBox Data="@countries"
                           Value="@disabledValue"
                           Enabled="false"
                           TextFieldName="Name" />
            </div>
        </div>
    </div>

    <!-- Form Example -->
    <div class="bumitama-section">
        <h2>Form Example</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <h3 style="margin-bottom: 20px;">User Registration Form</h3>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Full Name *</label>
                    <input type="text" class="form-control" @bind="userName" placeholder="Enter your name" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Email *</label>
                    <input type="email" class="form-control" @bind="userEmail" placeholder="Enter your email" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Country *</label>
                    <DxComboBox Data="@countries" 
                               @bind-Value="@userCountry"
                               TextFieldName="Name" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Role *</label>
                    <DxComboBox Data="@roles" 
                               @bind-Value="@userRole"
                               TextFieldName="Name" />
                </div>

                <button class="btn btn-primary" @onclick="SubmitUser">Register User</button>

                @if (showUserConfirmation)
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724;">
                        <strong>✓ User Registered Successfully!</strong><br/>
                        <strong>Name:</strong> @userName<br/>
                        <strong>Email:</strong> @userEmail<br/>
                        <strong>Country:</strong> @userCountry<br/>
                        <strong>Role:</strong> @userRole
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Dependent ComboBoxes -->
    <div class="bumitama-section">
        <h2>Dependent ComboBoxes</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <h3 style="margin-bottom: 20px;">Location Selection</h3>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Select Country</label>
                    <DxComboBox Data="@countries" 
                               Value="@selectedCountryForCity"
                               ValueChanged="@((string value) => OnCountryChanged(value))"
                               TextFieldName="Name" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Select City</label>
                    <DxComboBox Data="@filteredCities" 
                               @bind-Value="@selectedCityDependent"
                               TextFieldName="Name"
                               Enabled="@(!string.IsNullOrEmpty(selectedCountryForCity))" />
                </div>

                @if (!string.IsNullOrEmpty(selectedCountryForCity) && !string.IsNullOrEmpty(selectedCityDependent))
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 8px;">
                        <strong>Selected Location:</strong> @selectedCityDependent, @selectedCountryForCity
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Multiple ComboBoxes -->
    <div class="bumitama-section">
        <h2>Multiple Selections</h2>
        <div class="bumitama-card">
            <div style="max-width: 800px;">
                <h3 style="margin-bottom: 20px;">Preferences Selection</h3>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Language</label>
                        <DxComboBox Data="@languages" 
                                   @bind-Value="@prefLanguage"
                                   TextFieldName="Name" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Time Zone</label>
                        <DxComboBox Data="@timeZones" 
                                   @bind-Value="@prefTimeZone"
                                   TextFieldName="Name" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Currency</label>
                        <DxComboBox Data="@currencies" 
                                   @bind-Value="@prefCurrency"
                                   TextFieldName="Name" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Date Format</label>
                        <DxComboBox Data="@dateFormats" 
                                   @bind-Value="@prefDateFormat"
                                   TextFieldName="Name" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(prefLanguage))
                {
                    <div style="margin-top: 30px; padding: 20px; background-color: #e7f5ff; border-radius: 8px;">
                        <h4 style="margin-bottom: 15px;">Your Preferences</h4>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                            <div>
                                <div style="font-size: 0.875rem; color: #6c757d;">Language</div>
                                <div style="font-weight: 600;">@prefLanguage</div>
                            </div>
                            <div>
                                <div style="font-size: 0.875rem; color: #6c757d;">Time Zone</div>
                                <div style="font-weight: 600;">@prefTimeZone</div>
                            </div>
                            <div>
                                <div style="font-size: 0.875rem; color: #6c757d;">Currency</div>
                                <div style="font-weight: 600;">@prefCurrency</div>
                            </div>
                            <div>
                                <div style="font-size: 0.875rem; color: #6c757d;">Date Format</div>
                                <div style="font-weight: 600;">@prefDateFormat</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    // Data sources
    private List<Country> countries = new()
    {
        new Country { Id = 1, Name = "Indonesia", Code = "ID" },
        new Country { Id = 2, Name = "Singapore", Code = "SG" },
        new Country { Id = 3, Name = "Malaysia", Code = "MY" },
        new Country { Id = 4, Name = "Thailand", Code = "TH" },
        new Country { Id = 5, Name = "Philippines", Code = "PH" },
        new Country { Id = 6, Name = "Vietnam", Code = "VN" },
        new Country { Id = 7, Name = "Japan", Code = "JP" },
        new Country { Id = 8, Name = "South Korea", Code = "KR" }
    };

    private List<City> cities = new()
    {
        new City { Id = 1, Name = "Jakarta", CountryId = 1 },
        new City { Id = 2, Name = "Surabaya", CountryId = 1 },
        new City { Id = 3, Name = "Singapore", CountryId = 2 },
        new City { Id = 4, Name = "Kuala Lumpur", CountryId = 3 },
        new City { Id = 5, Name = "Bangkok", CountryId = 4 },
        new City { Id = 6, Name = "Manila", CountryId = 5 }
    };

    private List<Department> departments = new()
    {
        new Department { Id = 1, Name = "IT" },
        new Department { Id = 2, Name = "HR" },
        new Department { Id = 3, Name = "Finance" },
        new Department { Id = 4, Name = "Marketing" },
        new Department { Id = 5, Name = "Operations" }
    };

    private List<Role> roles = new()
    {
        new Role { Id = 1, Name = "Administrator" },
        new Role { Id = 2, Name = "Manager" },
        new Role { Id = 3, Name = "User" },
        new Role { Id = 4, Name = "Guest" }
    };

    private List<Language> languages = new()
    {
        new Language { Id = 1, Name = "English" },
        new Language { Id = 2, Name = "Bahasa Indonesia" },
        new Language { Id = 3, Name = "中文 (Chinese)" },
        new Language { Id = 4, Name = "日本語 (Japanese)" }
    };

    private List<TimeZone> timeZones = new()
    {
        new TimeZone { Id = 1, Name = "GMT+7 (Bangkok)" },
        new TimeZone { Id = 2, Name = "GMT+8 (Singapore)" },
        new TimeZone { Id = 3, Name = "GMT+9 (Tokyo)" }
    };

    private List<Currency> currencies = new()
    {
        new Currency { Id = 1, Name = "USD - US Dollar" },
        new Currency { Id = 2, Name = "IDR - Indonesian Rupiah" },
        new Currency { Id = 3, Name = "SGD - Singapore Dollar" },
        new Currency { Id = 4, Name = "MYR - Malaysian Ringgit" }
    };

    private List<DateFormat> dateFormats = new()
    {
        new DateFormat { Id = 1, Name = "DD/MM/YYYY" },
        new DateFormat { Id = 2, Name = "MM/DD/YYYY" },
        new DateFormat { Id = 3, Name = "YYYY-MM-DD" }
    };

    // Basic
    private string selectedCountry = "Indonesia";

    // With Labels
    private string country1 = "Singapore";
    private string city1 = "Jakarta";
    private string department1 = "IT";

    // Disabled
    private string disabledValue = "Malaysia";

    // Form
    private string userName = "";
    private string userEmail = "";
    private string userCountry = "";
    private string userRole = "";
    private bool showUserConfirmation = false;

    // Dependent
    private string selectedCountryForCity = "";
    private string selectedCityDependent = "";
    private List<City> filteredCities = new();

    // Preferences
    private string prefLanguage = "English";
    private string prefTimeZone = "GMT+7 (Bangkok)";
    private string prefCurrency = "USD - US Dollar";
    private string prefDateFormat = "DD/MM/YYYY";

    private void OnCountryChanged(string value)
    {
        selectedCountryForCity = value;
        selectedCityDependent = "";
        
        var country = countries.FirstOrDefault(c => c.Name == value);
        if (country != null)
        {
            filteredCities = cities.Where(c => c.CountryId == country.Id).ToList();
        }
        else
        {
            filteredCities = new List<City>();
        }
    }

    private void SubmitUser()
    {
        if (!string.IsNullOrWhiteSpace(userName) && 
            !string.IsNullOrWhiteSpace(userEmail) && 
            !string.IsNullOrWhiteSpace(userCountry) && 
            !string.IsNullOrWhiteSpace(userRole))
        {
            showUserConfirmation = true;
            StateHasChanged();
        }
    }

    public class Country
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
    }

    public class City
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int CountryId { get; set; }
    }

    public class Department
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class Role
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class Language
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class TimeZone
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class Currency
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class DateFormat
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
}
