@page "/bumitama/calendar"
@using AppPortal.App.Components.BumitamaKit.Forms.BumiCalendar

<PageTitle>Calendar - Bumitama Kit</PageTitle>

<div class="demo-page">
    <h1>BumiCalendar</h1>
    <p class="lead">Example demonstrations of the BumiCalendar component with various configurations.</p>
    
    <div class="demo-section">
        <h2>Basic Example</h2>
        <div class="demo-container">
            <BumiCalendar>
            </BumiCalendar>
        </div>
    </div>
    
    <div class="demo-section">
        <h2>Light Theme</h2>
        <div class="demo-container">
            <BumiCalendar Theme="BumiCalendarTheme.Light">
            </BumiCalendar>
        </div>
    </div>
    
    <div class="demo-section">
        <h2>Dark Theme</h2>
        <div class="demo-container" style="background: #1a1a1a; padding: 20px;">
            <BumiCalendar Theme="BumiCalendarTheme.Dark">
            </BumiCalendar>
        </div>
    </div>
    
    <div class="demo-section">
        <h2>Custom Color</h2>
        <div class="demo-container">
            <BumiCalendar CustomColor="#00bf63">
            </BumiCalendar>
        </div>
    </div>

    <div class="demo-section">
        <h2>With Custom CSS Class</h2>
        <div class="demo-container">
            <BumiCalendar CssClass="my-custom-calendar">
            </BumiCalendar>
        </div>
    </div>
</div>

<style>
    .demo-page {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .demo-page h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: #1a1a1a;
    }
    
    .demo-page .lead {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 2rem;
    }
    
    .demo-section {
        margin-bottom: 3rem;
    }
    
    .demo-section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #333;
        border-bottom: 2px solid #00bf63;
        padding-bottom: 0.5rem;
    }
    
    .demo-container {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 1rem;
    }

    .my-custom-calendar {
        border: 2px solid #007bff;
        border-radius: 12px;
    }
</style>

