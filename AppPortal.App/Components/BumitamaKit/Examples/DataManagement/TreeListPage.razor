@page "/bumitama/data-management/treelist"
@using AppPortal.App.Components.BumitamaKit.DataManagement.BumiTreeList

<PageTitle>TreeList - Bumitama Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / Data Management / BumiTreeList</p>
        <h1 class="bumitama-title">🌳 BumiTreeList</h1>
        <p class="bumitama-subtitle">DxTreeList component wrapper — hierarchical data display with expand/collapse functionality.</p>
    </div>

    <!-- Basic Example -->
    <div class="bumitama-section">
        <h2>Basic TreeList</h2>
        <div class="bumitama-card">
            <BumiTreeList Theme="BumiTreeListTheme.Light">
                <Columns>
                    <DxTreeListDataColumn FieldName="Name" Caption="Name" />
                    <DxTreeListDataColumn FieldName="Position" Caption="Position" />
                    <DxTreeListDataColumn FieldName="Department" Caption="Department" />
                    <DxTreeListDataColumn FieldName="Email" Caption="Email" />
                </Columns>
                <Data>@organizationData</Data>
                <KeyFieldName>Id</KeyFieldName>
                <ParentKeyFieldName>ParentId</ParentKeyFieldName>
            </BumiTreeList>
        </div>
    </div>

    <!-- Company Structure -->
    <div class="bumitama-section">
        <h2>Company Structure</h2>
        <div class="bumitama-card">
            <BumiTreeList Theme="BumiTreeListTheme.Light">
                <Columns>
                    <DxTreeListDataColumn FieldName="Name" Caption="Division / Unit" />
                    <DxTreeListDataColumn FieldName="Manager" Caption="Manager" />
                    <DxTreeListDataColumn FieldName="Location" Caption="Location" />
                    <DxTreeListDataColumn FieldName="Employees" Caption="Employees" />
                </Columns>
                <Data>@companyStructure</Data>
                <KeyFieldName>Id</KeyFieldName>
                <ParentKeyFieldName>ParentId</ParentKeyFieldName>
            </BumiTreeList>
        </div>
    </div>

    <!-- Dark Theme -->
    <div class="bumitama-section">
        <h2>Dark Theme</h2>
        <div class="bumitama-card" style="background: #1a1a1a; padding: 20px;">
            <BumiTreeList Theme="BumiTreeListTheme.Dark">
                <Columns>
                    <DxTreeListDataColumn FieldName="Name" Caption="Name" />
                    <DxTreeListDataColumn FieldName="Position" Caption="Position" />
                    <DxTreeListDataColumn FieldName="Department" Caption="Department" />
                </Columns>
                <Data>@organizationData</Data>
                <KeyFieldName>Id</KeyFieldName>
                <ParentKeyFieldName>ParentId</ParentKeyFieldName>
            </BumiTreeList>
        </div>
    </div>

    <!-- Custom Color -->
    <div class="bumitama-section">
        <h2>Custom Brand Color</h2>
        <div class="bumitama-card">
            <BumiTreeList Theme="BumiTreeListTheme.Light" CustomColor="#00bf63">
                <Columns>
                    <DxTreeListDataColumn FieldName="Name" Caption="Division" />
                    <DxTreeListDataColumn FieldName="Manager" Caption="Manager" />
                    <DxTreeListDataColumn FieldName="Location" Caption="Location" />
                </Columns>
                <Data>@companyStructure</Data>
                <KeyFieldName>Id</KeyFieldName>
                <ParentKeyFieldName>ParentId</ParentKeyFieldName>
            </BumiTreeList>
        </div>
    </div>

</div>

