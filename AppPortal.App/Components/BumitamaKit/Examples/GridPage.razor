@page "/bumitama/data-management/grid"
@using AppPortal.App.Components.BumitamaKit.DataManagement.BumiGrid

<PageTitle>Grid - Bumitama Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / Data Management / BumiGrid</p>
        <h1 class="bumitama-title">📊 BumiGrid</h1>
        <p class="bumitama-subtitle">DxGrid component wrapper — powerful data grid with sorting, filtering, and editing.</p>
    </div>

    <!-- Basic Example -->
    <div class="bumitama-section">
        <h2>Basic Grid</h2>
        <div class="bumitama-card">
            <BumiGrid Theme="BumiGridTheme.Light">
                <Columns>
                    <DxGridDataColumn FieldName="Id" Caption="ID" Width="80px" />
                    <DxGridDataColumn FieldName="Name" Caption="Name" />
                    <DxGridDataColumn FieldName="Email" Caption="Email" />
                    <DxGridDataColumn FieldName="Department" Caption="Department" />
                    <DxGridDataColumn FieldName="Status" Caption="Status" />
                </Columns>
                <Data>@employees</Data>
            </BumiGrid>
        </div>
    </div>

    <!-- With Paging -->
    <div class="bumitama-section">
        <h2>Grid with Paging</h2>
        <div class="bumitama-card">
            <BumiGrid Theme="BumiGridTheme.Light">
                <Columns>
                    <DxGridDataColumn FieldName="Id" Caption="ID" Width="80px" />
                    <DxGridDataColumn FieldName="ProductName" Caption="Product" />
                    <DxGridDataColumn FieldName="Category" Caption="Category" />
                    <DxGridDataColumn FieldName="Price" Caption="Price" DisplayFormat="c2" />
                    <DxGridDataColumn FieldName="Stock" Caption="Stock" />
                </Columns>
                <Data>@products</Data>
                <PageSize>5</PageSize>
            </BumiGrid>
        </div>
    </div>

    <!-- Dark Theme -->
    <div class="bumitama-section">
        <h2>Dark Theme</h2>
        <div class="bumitama-card" style="background: #1a1a1a; padding: 20px;">
            <BumiGrid Theme="BumiGridTheme.Dark">
                <Columns>
                    <DxGridDataColumn FieldName="Id" Caption="ID" Width="80px" />
                    <DxGridDataColumn FieldName="Name" Caption="Name" />
                    <DxGridDataColumn FieldName="Email" Caption="Email" />
                    <DxGridDataColumn FieldName="Status" Caption="Status" />
                </Columns>
                <Data>@employees</Data>
                <PageSize>5</PageSize>
            </BumiGrid>
        </div>
    </div>

    <!-- Custom Color -->
    <div class="bumitama-section">
        <h2>Custom Brand Color</h2>
        <div class="bumitama-card">
            <BumiGrid Theme="BumiGridTheme.Light" CustomColor="#00bf63">
                <Columns>
                    <DxGridDataColumn FieldName="Id" Caption="ID" Width="80px" />
                    <DxGridDataColumn FieldName="Name" Caption="Customer Name" />
                    <DxGridDataColumn FieldName="Email" Caption="Email" />
                    <DxGridDataColumn FieldName="Department" Caption="Department" />
                </Columns>
                <Data>@employees</Data>
                <PageSize>5</PageSize>
            </BumiGrid>
        </div>
    </div>

</div>

