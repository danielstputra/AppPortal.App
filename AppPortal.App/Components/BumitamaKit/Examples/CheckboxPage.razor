@using AppPortal.App.Components.BumitamaKit.Input.BumiCheckbox

@page "/bumitama/checkbox"

<PageTitle>Checkbox - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / BumiCheckbox</p>
        <h1 class="bumitama-title">☑️ BumiCheckbox</h1>
        <p class="bumitama-subtitle">Versatile checkbox component with multiple states and styles.</p>
    </div>

    <!-- Basic Checkboxes -->
    <div class="bumitama-section">
        <h2>Basic Checkboxes</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox Label="Unchecked checkbox"
                             @bind-Checked="@checkbox1" />

                <BumiCheckbox Label="Checked checkbox"
                             @bind-Checked="@checkbox2" />

                <BumiCheckbox Label="Checkbox without label"
                             @bind-Checked="@checkbox3" />
            </div>
        </div>
    </div>

    <!-- Colors -->
    <div class="bumitama-section">
        <h2>Colors</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox Label="Primary"
                             Color="CheckboxColor.Primary"
                             Checked="true" />

                <BumiCheckbox Label="Brand"
                             Color="CheckboxColor.Brand"
                             Checked="true" />

                <BumiCheckbox Label="Secondary"
                             Color="CheckboxColor.Secondary"
                             Checked="true" />

                <BumiCheckbox Label="Success"
                             Color="CheckboxColor.Success"
                             Checked="true" />

                <BumiCheckbox Label="Danger"
                             Color="CheckboxColor.Danger"
                             Checked="true" />

                <BumiCheckbox Label="Warning"
                             Color="CheckboxColor.Warning"
                             Checked="true" />

                <BumiCheckbox Label="Info"
                             Color="CheckboxColor.Info"
                             Checked="true" />
            </div>
        </div>
    </div>

    <!-- Sizes -->
    <div class="bumitama-section">
        <h2>Sizes</h2>
        <div class="bumitama-card">
            <div style="display: flex; align-items: center; gap: 30px;">
                <BumiCheckbox Label="Small"
                             Size="CheckboxSize.Small"
                             Checked="true" />

                <BumiCheckbox Label="Medium"
                             Size="CheckboxSize.Medium"
                             Checked="true" />

                <BumiCheckbox Label="Large"
                             Size="CheckboxSize.Large"
                             Checked="true" />
            </div>
        </div>
    </div>

    <!-- Indeterminate State -->
    <div class="bumitama-section">
        <h2>Indeterminate State</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox Label="Select all items"
                             Indeterminate="@isIndeterminate"
                             Checked="@isAllChecked"
                             CheckedChanged="@HandleSelectAll"
                             Color="CheckboxColor.Brand" />

                <div style="margin-left: 30px; display: flex; flex-direction: column; gap: 10px;">
                    <BumiCheckbox Label="Item 1"
                                 Checked="@item1"
                                 CheckedChanged="@(val => { item1 = val; UpdateSelectAll(val); })" />

                    <BumiCheckbox Label="Item 2"
                                 Checked="@item2"
                                 CheckedChanged="@(val => { item2 = val; UpdateSelectAll(val); })" />

                    <BumiCheckbox Label="Item 3"
                                 Checked="@item3"
                                 CheckedChanged="@(val => { item3 = val; UpdateSelectAll(val); })" />
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled State -->
    <div class="bumitama-section">
        <h2>Disabled State</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox Label="Disabled unchecked"
                             Disabled="true" />

                <BumiCheckbox Label="Disabled checked"
                             Checked="true"
                             Disabled="true" />

                <BumiCheckbox Label="Disabled indeterminate"
                             Indeterminate="true"
                             Disabled="true" />
            </div>
        </div>
    </div>

    <!-- Custom Icons -->
    <div class="bumitama-section">
        <h2>Custom Icons</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox Label="Heart icon"
                             IconCssClass="fas fa-heart"
                             Color="CheckboxColor.Danger"
                             Checked="true" />

                <BumiCheckbox Label="Star icon"
                             IconCssClass="fas fa-star"
                             Color="CheckboxColor.Warning"
                             Checked="true" />

                <BumiCheckbox Label="Thumbs up"
                             IconCssClass="fas fa-thumbs-up"
                             Color="CheckboxColor.Success"
                             Checked="true" />

                <BumiCheckbox Label="Lock icon"
                             IconCssClass="fas fa-lock"
                             Color="CheckboxColor.Secondary"
                             Checked="true" />
            </div>
        </div>
    </div>

    <!-- Custom Label Content -->
    <div class="bumitama-section">
        <h2>Custom Label Content</h2>
        <div class="bumitama-card">
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <BumiCheckbox @bind-Checked="@acceptTerms">
                    <LabelContent>
                        I accept the <a href="#" style="color: #007bff; text-decoration: none;">Terms and Conditions</a>
                    </LabelContent>
                </BumiCheckbox>

                <BumiCheckbox @bind-Checked="@subscribe" Color="CheckboxColor.Brand">
                    <LabelContent>
                        <div>
                            <strong>Subscribe to newsletter</strong>
                            <div style="font-size: 0.75rem; color: #6c757d; margin-top: 2px;">
                                Get weekly updates about new features
                            </div>
                        </div>
                    </LabelContent>
                </BumiCheckbox>

                <BumiCheckbox @bind-Checked="@premium" Color="CheckboxColor.Warning">
                    <LabelContent>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="fas fa-crown" style="color: #ffc107;"></i>
                            <span><strong>Premium Plan</strong> - $9.99/month</span>
                        </div>
                    </LabelContent>
                </BumiCheckbox>
            </div>
        </div>
    </div>

    <!-- Themes -->
    <div class="bumitama-section">
        <h2>Themes</h2>
        <div class="bumitama-card">
            <h3>Light Theme</h3>
            <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 30px;">
                <BumiCheckbox Label="Light theme checkbox"
                             Theme="CheckboxTheme.Light"
                             Color="CheckboxColor.Brand"
                             Checked="true" />
            </div>

            <h3>Dark Theme</h3>
            <div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px;">
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    <BumiCheckbox Label="Dark theme checkbox"
                                 Theme="CheckboxTheme.Dark"
                                 Color="CheckboxColor.Brand"
                                 Checked="true" />

                    <BumiCheckbox Label="Dark theme unchecked"
                                 Theme="CheckboxTheme.Dark" />
                </div>
            </div>
        </div>
    </div>

    <!-- Checkbox Groups -->
    <div class="bumitama-section">
        <h2>Checkbox Groups</h2>
        <div class="bumitama-card">
            <h3 style="margin-bottom: 15px;">Select Your Interests</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <BumiCheckbox Label="Technology"
                             @bind-Checked="@interest1"
                             Color="CheckboxColor.Brand" />

                <BumiCheckbox Label="Design"
                             @bind-Checked="@interest2"
                             Color="CheckboxColor.Brand" />

                <BumiCheckbox Label="Marketing"
                             @bind-Checked="@interest3"
                             Color="CheckboxColor.Brand" />

                <BumiCheckbox Label="Business"
                             @bind-Checked="@interest4"
                             Color="CheckboxColor.Brand" />

                <BumiCheckbox Label="Finance"
                             @bind-Checked="@interest5"
                             Color="CheckboxColor.Brand" />

                <BumiCheckbox Label="Health"
                             @bind-Checked="@interest6"
                             Color="CheckboxColor.Brand" />
            </div>

            @if (GetSelectedCount() > 0)
            {
                <div style="margin-top: 20px; padding: 15px; background-color: #e7f5ff; border-radius: 8px; color: #0c4a6e;">
                    <strong>@GetSelectedCount()</strong> interest(s) selected
                </div>
            }
        </div>
    </div>

    <!-- Form Example -->
    <div class="bumitama-section">
        <h2>Form Example</h2>
        <div class="bumitama-card">
            <div style="max-width: 500px;">
                <h3 style="margin-bottom: 20px;">Account Settings</h3>
                
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div>
                        <h4 style="margin-bottom: 10px; font-size: 0.875rem; font-weight: 600;">Notifications</h4>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <BumiCheckbox Label="Email notifications"
                                         @bind-Checked="@emailNotif" />
                            <BumiCheckbox Label="Push notifications"
                                         @bind-Checked="@pushNotif" />
                            <BumiCheckbox Label="SMS notifications"
                                         @bind-Checked="@smsNotif" />
                        </div>
                    </div>

                    <div>
                        <h4 style="margin-bottom: 10px; font-size: 0.875rem; font-weight: 600;">Privacy</h4>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <BumiCheckbox Label="Show profile publicly"
                                         @bind-Checked="@publicProfile" />
                            <BumiCheckbox Label="Allow search engines to index"
                                         @bind-Checked="@searchIndex" />
                        </div>
                    </div>

                    <div style="padding-top: 10px; border-top: 1px solid #e5e7eb;">
                        <BumiCheckbox Label="I agree to receive marketing emails"
                                     @bind-Checked="@marketingEmails"
                                     Color="CheckboxColor.Brand" />
                    </div>

                    <button class="btn btn-primary">Save Settings</button>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    // Basic
    private bool checkbox1 = false;
    private bool checkbox2 = true;
    private bool checkbox3 = false;

    // Indeterminate
    private bool isIndeterminate = false;
    private bool isAllChecked = false;
    private bool item1 = false;
    private bool item2 = true;
    private bool item3 = false;

    // Custom content
    private bool acceptTerms = false;
    private bool subscribe = true;
    private bool premium = false;

    // Interests
    private bool interest1 = true;
    private bool interest2 = false;
    private bool interest3 = true;
    private bool interest4 = false;
    private bool interest5 = false;
    private bool interest6 = true;

    // Form
    private bool emailNotif = true;
    private bool pushNotif = true;
    private bool smsNotif = false;
    private bool publicProfile = false;
    private bool searchIndex = false;
    private bool marketingEmails = false;

    protected override void OnInitialized()
    {
        UpdateSelectAll(false);
    }

    private void HandleSelectAll(bool isChecked)
    {
        item1 = item2 = item3 = isChecked;
        UpdateSelectAll(false);
    }

    private void UpdateSelectAll(bool _)
    {
        var checkedCount = new[] { item1, item2, item3 }.Count(x => x);
        
        if (checkedCount == 0)
        {
            isAllChecked = false;
            isIndeterminate = false;
        }
        else if (checkedCount == 3)
        {
            isAllChecked = true;
            isIndeterminate = false;
        }
        else
        {
            isAllChecked = false;
            isIndeterminate = true;
        }
    }

    private int GetSelectedCount()
    {
        return new[] { interest1, interest2, interest3, interest4, interest5, interest6 }.Count(x => x);
    }
}
