@using AppPortal.App.Components.BumitamaKit.Forms.BumiInput

@page "/bumitama/inputs"

<PageTitle>Input - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / BumiInput</p>
        <h1 class="bumitama-title">📝 BumiInput</h1>
        <p class="bumitama-subtitle">Text input component with labels, validation, and themes.</p>
    </div>

    <!-- Default -->
    <div class="bumitama-section">
        <h2>Default</h2>
        <div class="bumitama-card">
            <div class="demo-row">
                <BumiInput @bind-Value="@inputValue"
                          Label="Username"
                          Placeholder="Enter your username"
                          Width="300px" />

                <BumiInput @bind-Value="@emailValue"
                          Label="Email"
                          Placeholder="Enter your email"
                          Width="300px" />
            </div>
        </div>
    </div>

    <!-- With Helper Text -->
    <div class="bumitama-section">
        <h2>With Helper Text</h2>
        <div class="bumitama-card">
            <div class="demo-row">
                <BumiInput @bind-Value="@helperValue"
                          Label="Password"
                          Placeholder="Enter password"
                          HelperText="Must be at least 8 characters"
                          Width="300px" />
            </div>
        </div>
    </div>

    <!-- Validation States -->
    <div class="bumitama-section">
        <h2>Validation States</h2>
        <div class="bumitama-card">
            <div class="demo-row">
                <BumiInput @bind-Value="@errorValue"
                          Label="Username"
                          Placeholder="Enter username"
                          HasError="true"
                          ErrorMessage="Username is required"
                          Width="300px" />

                <BumiInput @bind-Value="@validValue"
                          Label="Email"
                          Placeholder="user@example.com"
                          HelperText="Valid email format"
                          Width="300px" />
            </div>
        </div>
    </div>

    <!-- Disabled & ReadOnly -->
    <div class="bumitama-section">
        <h2>States</h2>
        <div class="bumitama-card">
            <div class="demo-row">
                <BumiInput Value="Disabled Input"
                          Label="Disabled"
                          Disabled="true"
                          Width="300px" />

                <BumiInput Value="Read Only Input"
                          Label="Read Only"
                          ReadOnly="true"
                          Width="300px" />
            </div>
        </div>
    </div>

    <!-- Sizes -->
    <div class="bumitama-section">
        <h2>Sizes</h2>
        <div class="bumitama-card">
            <div class="demo-row">
                <BumiInput @bind-Value="@smallValue"
                          Label="Small"
                          Placeholder="Small size"
                          Size="InputSize.Small"
                          Width="250px" />

                <BumiInput @bind-Value="@mediumValue"
                          Label="Medium"
                          Placeholder="Medium size"
                          Size="InputSize.Medium"
                          Width="250px" />

                <BumiInput @bind-Value="@largeValue"
                          Label="Large"
                          Placeholder="Large size"
                          Size="InputSize.Large"
                          Width="250px" />
            </div>
        </div>
    </div>

    <!-- Themes -->
    <div class="bumitama-section">
        <h2>Themes</h2>
        <div class="bumitama-card">
            <h3>Light Theme</h3>
            <div class="demo-row">
                <BumiInput @bind-Value="@lightValue"
                          Label="Light Theme"
                          Placeholder="Light theme input"
                          Theme="InputTheme.Light"
                          Width="300px" />
            </div>

            <h3 style="margin-top: 30px;">Dark Theme</h3>
            <div class="demo-row" style="background-color: #1a1a1a; padding: 20px; border-radius: 8px;">
                <BumiInput @bind-Value="@darkValue"
                          Label="Dark Theme"
                          Placeholder="Dark theme input"
                          Theme="InputTheme.Dark"
                          Width="300px" />
            </div>
        </div>
    </div>

    <!-- Full Width -->
    <div class="bumitama-section">
        <h2>Full Width</h2>
        <div class="bumitama-card">
            <div style="max-width:600px;">
                <BumiInput @bind-Value="@fullWidthValue"
                          Label="Full Width Input"
                          Placeholder="This input takes full width"
                          Width="100%"
                          HelperText="Input will stretch to container width" />
            </div>
        </div>
    </div>

</div>

@code {
    private string inputValue = "";
    private string emailValue = "";
    private string helperValue = "";
    private string errorValue = "";
    private string validValue = "user@example.com";
    private string smallValue = "";
    private string mediumValue = "";
    private string largeValue = "";
    private string lightValue = "";
    private string darkValue = "";
    private string fullWidthValue = "";
}
