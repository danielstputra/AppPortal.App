@using DevExpress.Blazor

@page "/bumitama/date-edit"

<PageTitle>Date Edit - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / DxDateEdit</p>
        <h1 class="bumitama-title">📅 DxDateEdit</h1>
        <p class="bumitama-subtitle">DxDateEdit component for date selection with calendar picker.</p>
    </div>

    <!-- Basic Date Edit -->
    <div class="bumitama-section">
        <h2>Basic Date Edit</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <DxDateEdit T="DateTime?" @bind-Value="@selectedDate1" />
                
                @if (selectedDate1 != null)
                {
                    <div style="margin-top: 15px; padding: 15px; background-color: #e7f5ff; border-radius: 8px;">
                        <strong>Selected Date:</strong> @selectedDate1.Value.ToString("MMMM dd, yyyy (dddd)")
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- With Labels -->
    <div class="bumitama-section">
        <h2>With Labels</h2>
        <div class="bumitama-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Birth Date</label>
                    <DxDateEdit T="DateTime?" @bind-Value="@birthDate" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Start Date</label>
                    <DxDateEdit T="DateTime?" @bind-Value="@startDate" />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Deadline</label>
                    <DxDateEdit T="DateTime?" @bind-Value="@deadline" />
                </div>
            </div>
        </div>
    </div>

    <!-- Themes -->
    <div class="bumitama-section">
        <h2>Themes</h2>
        <div class="bumitama-card">
            <h3 style="margin-bottom: 15px;">Light Theme</h3>
            <div style="max-width: 400px; margin-bottom: 30px;">
                <DxDateEdit T="DateTime?" Theme="DxDateEditTheme.Light"
                             @bind-Value="@themeLight" />
            </div>

            <h3 style="margin-bottom: 15px;">Dark Theme</h3>
            <div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px;">
                <div style="max-width: 400px;">
                    <DxDateEdit T="DateTime?" Theme="DxDateEditTheme.Dark"
                                 @bind-Value="@themeDark" />
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled State -->
    <div class="bumitama-section">
        <h2>Disabled State</h2>
        <div class="bumitama-card">
            <div style="max-width: 400px;">
                <DxDateEdit T="DateTime?" Disabled="true"
                             @bind-Value="@disabledDate" />
            </div>
        </div>
    </div>

    <!-- Quick Date Selection -->
    <div class="bumitama-section">
        <h2>Quick Date Selection</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <div style="margin-bottom: 15px;">
                    <DxDateEdit T="DateTime?" @bind-Value="@quickDate" />
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetToday">Today</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetYesterday">Yesterday</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetTomorrow">Tomorrow</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetNextWeek">Next Week</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetNextMonth">Next Month</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetStartOfMonth">Start of Month</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SetEndOfMonth">End of Month</button>
                </div>

                @if (quickDate != null)
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #f9fafb; border-radius: 8px;">
                        <strong>Selected:</strong> @quickDate.Value.ToString("MMMM dd, yyyy (dddd)")
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Form Example -->
    <div class="bumitama-section">
        <h2>Form Example</h2>
        <div class="bumitama-card">
            <div style="max-width: 600px;">
                <h3 style="margin-bottom: 20px;">Appointment Booking Form</h3>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Full Name *</label>
                    <input type="text" class="form-control" @bind="appointmentName" placeholder="Enter your name" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Appointment Date *</label>
                    <DxDateEdit T="DateTime?" @bind-Value="@appointmentDate" />
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Preferred Time</label>
                    <select class="form-control" @bind="appointmentTime">
                        <option value="">Select time</option>
                        <option value="09:00">09:00 AM</option>
                        <option value="10:00">10:00 AM</option>
                        <option value="11:00">11:00 AM</option>
                        <option value="14:00">02:00 PM</option>
                        <option value="15:00">03:00 PM</option>
                        <option value="16:00">04:00 PM</option>
                    </select>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Notes</label>
                    <textarea class="form-control" @bind="appointmentNotes" rows="3" placeholder="Additional information"></textarea>
                </div>

                <button class="btn btn-primary" @onclick="SubmitAppointment">Book Appointment</button>

                @if (showAppointmentConfirmation)
                {
                    <div style="margin-top: 20px; padding: 15px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724;">
                        <strong>✓ Appointment Booked Successfully!</strong><br/>
                        <strong>Name:</strong> @appointmentName<br/>
                        <strong>Date:</strong> @appointmentDate?.ToString("MMMM dd, yyyy")<br/>
                        <strong>Time:</strong> @appointmentTime
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Date Comparison -->
    <div class="bumitama-section">
        <h2>Date Comparison</h2>
        <div class="bumitama-card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
                <div>
                    <h4 style="margin-bottom: 15px;">Date 1</h4>
                    <DxDateEdit T="DateTime?" @bind-Value="@compareDate1" />
                </div>

                <div>
                    <h4 style="margin-bottom: 15px;">Date 2</h4>
                    <DxDateEdit T="DateTime?" @bind-Value="@compareDate2" />
                </div>
            </div>

            @if (compareDate1 != null && compareDate2 != null)
            {
                <div style="margin-top: 30px; padding: 20px; background-color: #f8f9fa; border-radius: 8px;">
                    <h4 style="margin-bottom: 15px;">Comparison Result</h4>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Date 1</div>
                            <div style="font-size: 1.1rem; font-weight: 600;">
                                @compareDate1.Value.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Date 2</div>
                            <div style="font-size: 1.1rem; font-weight: 600;">
                                @compareDate2.Value.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.875rem; color: #6c757d;">Days Between</div>
                            <div style="font-size: 1.5rem; font-weight: 600; color: #007bff;">
                                @Math.Abs((compareDate2.Value - compareDate1.Value).Days) days
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Multiple Dates -->
    <div class="bumitama-section">
        <h2>Multiple Date Fields</h2>
        <div class="bumitama-card">
            <div style="max-width: 800px;">
                <h3 style="margin-bottom: 20px;">Project Timeline</h3>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Planning Start</label>
                        <DxDateEdit T="DateTime?" @bind-Value="@projectPlanning" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Development Start</label>
                        <DxDateEdit T="DateTime?" @bind-Value="@projectDevelopment" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Testing Start</label>
                        <DxDateEdit T="DateTime?" @bind-Value="@projectTesting" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Launch Date</label>
                        <DxDateEdit T="DateTime?" @bind-Value="@projectLaunch" />
                    </div>
                </div>

                @if (projectPlanning != null && projectLaunch != null)
                {
                    <div style="margin-top: 30px; padding: 20px; background-color: #e7f5ff; border-radius: 8px;">
                        <h4 style="margin-bottom: 10px;">Project Duration</h4>
                        <div style="font-size: 1.5rem; font-weight: 600; color: #007bff;">
                            @((projectLaunch.Value - projectPlanning.Value).Days) days
                        </div>
                        <div style="font-size: 0.875rem; color: #6c757d; margin-top: 5px;">
                            From @projectPlanning.Value.ToString("MMM dd, yyyy") to @projectLaunch.Value.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    // Basic
    private DateTime? selectedDate1 = DateTime.Now;

    // With Labels
    private DateTime? birthDate = new DateTime(1990, 1, 1);
    private DateTime? startDate = DateTime.Now;
    private DateTime? deadline = DateTime.Now.AddDays(30);

    // Themes
    private DateTime? themeLight = DateTime.Now;
    private DateTime? themeDark = DateTime.Now;

    // Disabled
    private DateTime? disabledDate = DateTime.Now.AddDays(-7);

    // Quick Selection
    private DateTime? quickDate = DateTime.Now;

    // Form
    private string appointmentName = "";
    private DateTime? appointmentDate = DateTime.Now.AddDays(7);
    private string appointmentTime = "";
    private string appointmentNotes = "";
    private bool showAppointmentConfirmation = false;

    // Comparison
    private DateTime? compareDate1 = DateTime.Now;
    private DateTime? compareDate2 = DateTime.Now.AddDays(30);

    // Multiple Dates
    private DateTime? projectPlanning = DateTime.Now;
    private DateTime? projectDevelopment = DateTime.Now.AddDays(14);
    private DateTime? projectTesting = DateTime.Now.AddDays(60);
    private DateTime? projectLaunch = DateTime.Now.AddDays(90);

    private void SetToday()
    {
        quickDate = DateTime.Now.Date;
    }

    private void SetYesterday()
    {
        quickDate = DateTime.Now.Date.AddDays(-1);
    }

    private void SetTomorrow()
    {
        quickDate = DateTime.Now.Date.AddDays(1);
    }

    private void SetNextWeek()
    {
        quickDate = DateTime.Now.Date.AddDays(7);
    }

    private void SetNextMonth()
    {
        quickDate = DateTime.Now.Date.AddMonths(1);
    }

    private void SetStartOfMonth()
    {
        var today = DateTime.Now;
        quickDate = new DateTime(today.Year, today.Month, 1);
    }

    private void SetEndOfMonth()
    {
        var today = DateTime.Now;
        quickDate = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
    }

    private void SubmitAppointment()
    {
        if (!string.IsNullOrWhiteSpace(appointmentName) && appointmentDate != null && !string.IsNullOrWhiteSpace(appointmentTime))
        {
            showAppointmentConfirmation = true;
            StateHasChanged();
        }
    }
}
