@using AppPortal.App.Components.BumitamaKit.Actions.BumiSplitButton
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton
@using DevExpress.Blazor
@page "/bumitama/split-buttons"

<PageTitle>Bumi Split Buttons - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / Bumi Split Button</p>
        <h1 class="bumitama-title">⚔️ Bumi Split Button</h1>
        <p class="bumitama-subtitle">Custom wrapper for split button component with Brand & Custom colors.</p>
    </div>

    <!-- Basic Usage -->

    <div class="bumitama-section">

        <h2>Basic Usage</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiSplitButton Text="Save" Color="ButtonColor.Primary">
                    <DxDropDownButtonItem Text="Save as..." />
                    <DxDropDownButtonItem Text="Save all" />
                </BumiSplitButton>

                <BumiSplitButton Text="Export" Color="ButtonColor.Info">
                    <DxDropDownButtonItem Text="PDF" />
                    <DxDropDownButtonItem Text="Excel" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- Colors -->

    <div class="bumitama-section">

        <h2>Colors</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiSplitButton Text="Primary" Color="ButtonColor.Primary">
                    <DxDropDownButtonItem Text="Option 1" />
                    <DxDropDownButtonItem Text="Option 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Success" Color="ButtonColor.Success">
                    <DxDropDownButtonItem Text="Approve" />
                    <DxDropDownButtonItem Text="Accept" />
                </BumiSplitButton>

                <BumiSplitButton Text="Danger" Color="ButtonColor.Danger">
                    <DxDropDownButtonItem Text="Delete" />
                    <DxDropDownButtonItem Text="Discard" />
                </BumiSplitButton>

                <BumiSplitButton Text="Warning" Color="ButtonColor.Warning">
                    <DxDropDownButtonItem Text="Caution" />
                    <DxDropDownButtonItem Text="Alert" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- Variants -->

    <div class="bumitama-section">

        <h2>Variants</h2>

        <div class="bumitama-card">

            <h3>Filled (Contained)</h3>

            <div class="demo-row">

                <BumiSplitButton Text="Filled" Color="ButtonColor.Primary" Variant="ButtonVariant.Filled">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

            </div>

            <h3 style="margin-top: 20px;">Outline</h3>

            <div class="demo-row">

                <BumiSplitButton Text="Outline" Color="ButtonColor.Primary" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

            </div>

            <h3 style="margin-top: 20px;">Text</h3>

            <div class="demo-row">

                <BumiSplitButton Text="Text" Color="ButtonColor.Primary" Variant="ButtonVariant.Text">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- Sizes -->

    <div class="bumitama-section">

        <h2>Sizes</h2>

        <div class="bumitama-card">

            <div class="demo-row" style="align-items: center; gap: 1rem;">

                <BumiSplitButton Text="Small" Color="ButtonColor.Primary" Size="ButtonSize.Small">
                    <DxDropDownButtonItem Text="Item" />
                </BumiSplitButton>

                <BumiSplitButton Text="Medium" Color="ButtonColor.Primary" Size="ButtonSize.Medium">
                    <DxDropDownButtonItem Text="Item" />
                </BumiSplitButton>

                <BumiSplitButton Text="Large" Color="ButtonColor.Primary" Size="ButtonSize.Large">
                    <DxDropDownButtonItem Text="Item" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- With Icons -->

    <div class="bumitama-section">

        <h2>With Icons</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiSplitButton Text="Download" IconCssClass="dx-icon dx-icon-download" Color="ButtonColor.Info">
                    <DxDropDownButtonItem Text="PDF" />
                    <DxDropDownButtonItem Text="Excel" />
                </BumiSplitButton>

                <BumiSplitButton Text="Share" IconCssClass="dx-icon dx-icon-share" Color="ButtonColor.Success">
                    <DxDropDownButtonItem Text="Email" />
                    <DxDropDownButtonItem Text="Link" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- Brand Color -->

    <div class="bumitama-section">

        <h2>Brand Color</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiSplitButton Text="Brand" Color="ButtonColor.Brand">
                    <DxDropDownButtonItem Text="Option 1" />
                    <DxDropDownButtonItem Text="Option 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Brand Outline" Color="ButtonColor.Brand" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Choice 1" />
                    <DxDropDownButtonItem Text="Choice 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Brand Text" Color="ButtonColor.Brand" Variant="ButtonVariant.Text">
                    <DxDropDownButtonItem Text="Link 1" />
                    <DxDropDownButtonItem Text="Link 2" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

    <!-- Custom Colors -->

    <div class="bumitama-section">

        <h2>Custom Colors</h2>

        <div class="bumitama-card">

            <h3>Light Theme</h3>

            <div class="demo-row">

                <BumiSplitButton Text="Custom Green" Color="ButtonColor.Custom" CustomColor="#00bf63">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Purple" Color="ButtonColor.Custom" CustomColor="#8b5cf6">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Pink" Color="ButtonColor.Custom" CustomColor="#ec4899">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Cyan" Color="ButtonColor.Custom" CustomColor="#06b6d4">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

            </div>

            <h3 style="margin-top: 30px;">Outline Variant</h3>

            <div class="demo-row">

                <BumiSplitButton Text="Custom Green" Color="ButtonColor.Custom" CustomColor="#00bf63" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Purple" Color="ButtonColor.Custom" CustomColor="#8b5cf6" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Pink" Color="ButtonColor.Custom" CustomColor="#ec4899" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

                <BumiSplitButton Text="Custom Cyan" Color="ButtonColor.Custom" CustomColor="#06b6d4" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiSplitButton>

            </div>

        </div>

    </div>

</div>
