@using AppPortal.App.Components.BumitamaKit.Actions.BumiButtonGroup
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton
@using DevExpress.Blazor
@page "/bumitama/button-groups"

<PageTitle>Bumi Button Groups - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / Bumi Button Group</p>
        <h1 class="bumitama-title">🔘 Bumi Button Group</h1>
        <p class="bumitama-subtitle">Custom wrapper for button group component with Brand & Custom colors.</p>
    </div>

    <!-- Basic Usage -->

    <div class="bumitama-section">

        <h2>Basic Usage</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiButtonGroup>
                    <DxButtonGroupItem Text="Option 1" />
                    <DxButtonGroupItem Text="Option 2" />
                    <DxButtonGroupItem Text="Option 3" />
                </BumiButtonGroup>

                <BumiButtonGroup SelectionMode="ButtonGroupSelectionMode.Single">
                    <DxButtonGroupItem Text="Single 1" />
                    <DxButtonGroupItem Text="Single 2" />
                </BumiButtonGroup>

                <BumiButtonGroup SelectionMode="ButtonGroupSelectionMode.Multiple">
                    <DxButtonGroupItem Text="Multi 1" />
                    <DxButtonGroupItem Text="Multi 2" />
                    <DxButtonGroupItem Text="Multi 3" />
                </BumiButtonGroup>

            </div>

        </div>

    </div>

    <!-- With Icons -->

    <div class="bumitama-section">

        <h2>With Icons</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiButtonGroup SelectionMode="ButtonGroupSelectionMode.Single">
                    <DxButtonGroupItem Text="Save" IconCssClass="dx-icon dx-icon-save" />
                    <DxButtonGroupItem Text="Edit" IconCssClass="dx-icon dx-icon-edit" />
                    <DxButtonGroupItem Text="Delete" IconCssClass="dx-icon dx-icon-delete" />
                </BumiButtonGroup>

                <BumiButtonGroup SelectionMode="ButtonGroupSelectionMode.Multiple">
                    <DxButtonGroupItem Text="Bold" IconCssClass="dx-icon dx-icon-bold" />
                    <DxButtonGroupItem Text="Italic" IconCssClass="dx-icon dx-icon-italic" />
                    <DxButtonGroupItem Text="Underline" IconCssClass="dx-icon dx-icon-underline" />
                </BumiButtonGroup>

            </div>

        </div>

    </div>

    <!-- Sizes -->

    <div class="bumitama-section">

        <h2>Sizes</h2>

        <div class="bumitama-card">

            <h3>Small</h3>

            <div class="demo-row">

                <BumiButtonGroup Size="ButtonSize.Small">
                    <DxButtonGroupItem Text="Small 1" />
                    <DxButtonGroupItem Text="Small 2" />
                </BumiButtonGroup>

            </div>

            <h3 style="margin-top: 20px;">Medium</h3>

            <div class="demo-row">

                <BumiButtonGroup Size="ButtonSize.Medium">
                    <DxButtonGroupItem Text="Medium 1" />
                    <DxButtonGroupItem Text="Medium 2" />
                </BumiButtonGroup>

            </div>

            <h3 style="margin-top: 20px;">Large</h3>

            <div class="demo-row">

                <BumiButtonGroup Size="ButtonSize.Large">
                    <DxButtonGroupItem Text="Large 1" />
                    <DxButtonGroupItem Text="Large 2" />
                </BumiButtonGroup>

            </div>

        </div>

    </div>

    <!-- Colors -->

    <div class="bumitama-section">

        <h2>Colors</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiButtonGroup Color="ButtonColor.Primary">
                    <DxButtonGroupItem Text="Primary 1" />
                    <DxButtonGroupItem Text="Primary 2" />
                </BumiButtonGroup>

                <BumiButtonGroup Color="ButtonColor.Success">
                    <DxButtonGroupItem Text="Success 1" />
                    <DxButtonGroupItem Text="Success 2" />
                </BumiButtonGroup>

                <BumiButtonGroup Color="ButtonColor.Danger">
                    <DxButtonGroupItem Text="Danger 1" />
                    <DxButtonGroupItem Text="Danger 2" />
                </BumiButtonGroup>

                <BumiButtonGroup Color="ButtonColor.Warning">
                    <DxButtonGroupItem Text="Warning 1" />
                    <DxButtonGroupItem Text="Warning 2" />
                </BumiButtonGroup>

            </div>

        </div>

    </div>

    <!-- Brand Color -->

    <div class="bumitama-section">

        <h2>Brand Color</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <div style="--dx-color-primary: #00bf63 !important;">
                    <BumiButtonGroup Color="ButtonColor.Brand">
                        <DxButtonGroupItem Text="Option 1" />
                        <DxButtonGroupItem Text="Option 2" />
                        <DxButtonGroupItem Text="Option 3" />
                    </BumiButtonGroup>
                </div>

                <div style="--dx-color-primary: #00bf63 !important;">
                    <BumiButtonGroup Color="ButtonColor.Brand" SelectionMode="ButtonGroupSelectionMode.Single">
                        <DxButtonGroupItem Text="Brand A" IconCssClass="dx-icon dx-icon-star" />
                        <DxButtonGroupItem Text="Brand B" IconCssClass="dx-icon dx-icon-heart" />
                        <DxButtonGroupItem Text="Brand C" IconCssClass="dx-icon dx-icon-bookmark" />
                    </BumiButtonGroup>
                </div>

            </div>

        </div>

    </div>

    <!-- Custom Colors -->

    <div class="bumitama-section">

        <h2>Custom Colors</h2>

        <div class="bumitama-card">

            <h3>Custom Palette</h3>

            <div class="demo-row">

                <div style="--dx-color-primary: #00bf63 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#00bf63">
                        <DxButtonGroupItem Text="Green 1" />
                        <DxButtonGroupItem Text="Green 2" />
                    </BumiButtonGroup>
                </div>

                <div style="--dx-color-primary: #8b5cf6 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#8b5cf6">
                        <DxButtonGroupItem Text="Purple 1" />
                        <DxButtonGroupItem Text="Purple 2" />
                    </BumiButtonGroup>
                </div>

                <div style="--dx-color-primary: #ec4899 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#ec4899">
                        <DxButtonGroupItem Text="Pink 1" />
                        <DxButtonGroupItem Text="Pink 2" />
                    </BumiButtonGroup>
                </div>

                <div style="--dx-color-primary: #06b6d4 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#06b6d4">
                        <DxButtonGroupItem Text="Cyan 1" />
                        <DxButtonGroupItem Text="Cyan 2" />
                    </BumiButtonGroup>
                </div>

            </div>

            <h3 style="margin-top: 30px;">With Selection</h3>

            <div class="demo-row">

                <div style="--dx-color-primary: #00bf63 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#00bf63" SelectionMode="ButtonGroupSelectionMode.Multiple">
                        <DxButtonGroupItem Text="Save" IconCssClass="dx-icon dx-icon-save" />
                        <DxButtonGroupItem Text="Share" IconCssClass="dx-icon dx-icon-share" />
                        <DxButtonGroupItem Text="Export" IconCssClass="dx-icon dx-icon-export" />
                    </BumiButtonGroup>
                </div>

                <div style="--dx-color-primary: #8b5cf6 !important;">
                    <BumiButtonGroup Color="ButtonColor.Custom" CustomColor="#8b5cf6" SelectionMode="ButtonGroupSelectionMode.Single">
                        <DxButtonGroupItem Text="Filter" IconCssClass="dx-icon dx-icon-filter" />
                        <DxButtonGroupItem Text="Search" IconCssClass="dx-icon dx-icon-search" />
                        <DxButtonGroupItem Text="Sort" IconCssClass="dx-icon dx-icon-sort" />
                    </BumiButtonGroup>
                </div>

            </div>

        </div>

    </div>

</div>
