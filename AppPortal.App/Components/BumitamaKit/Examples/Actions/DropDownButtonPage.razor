@using AppPortal.App.Components.BumitamaKit.Actions.BumiDropDownButton
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton
@using DevExpress.Blazor
@page "/bumitama/dropdown-buttons"

<PageTitle>Bumi Dropdown Buttons - Bumitama UI Kit</PageTitle>

<div class="bumitama-page">

    <div class="bumitama-header">
        <p class="bumitama-breadcrumb"><a href="/">Home</a> / Bumitama / Bumi Dropdown Button</p>
        <h1 class="bumitama-title">🔽 Bumi Dropdown Button</h1>
        <p class="bumitama-subtitle">Custom wrapper for dropdown button component with Brand & Custom colors.</p>
    </div>

    <!-- Basic Usage -->

    <div class="bumitama-section">

        <h2>Basic Usage</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiDropDownButton Text="Actions" Color="ButtonColor.Primary">
                    <DxDropDownButtonItem Text="Edit" />
                    <DxDropDownButtonItem Text="Delete" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="File" Color="ButtonColor.Success">
                    <DxDropDownButtonItem Text="New" />
                    <DxDropDownButtonItem Text="Open" />
                    <DxDropDownButtonItem Text="Save" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- Colors -->

    <div class="bumitama-section">

        <h2>Colors</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiDropDownButton Text="Primary" Color="ButtonColor.Primary">
                    <DxDropDownButtonItem Text="Option 1" />
                    <DxDropDownButtonItem Text="Option 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Success" Color="ButtonColor.Success">
                    <DxDropDownButtonItem Text="Approve" />
                    <DxDropDownButtonItem Text="Accept" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Danger" Color="ButtonColor.Danger">
                    <DxDropDownButtonItem Text="Delete" />
                    <DxDropDownButtonItem Text="Discard" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Warning" Color="ButtonColor.Warning">
                    <DxDropDownButtonItem Text="Caution" />
                    <DxDropDownButtonItem Text="Alert" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- Variants -->

    <div class="bumitama-section">

        <h2>Variants</h2>

        <div class="bumitama-card">

            <h3>Filled (Contained)</h3>

            <div class="demo-row">

                <BumiDropDownButton Text="Filled" Color="ButtonColor.Primary" Variant="ButtonVariant.Filled">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

            </div>

            <h3 style="margin-top: 20px;">Outline</h3>

            <div class="demo-row">

                <BumiDropDownButton Text="Outline" Color="ButtonColor.Primary" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

            </div>

            <h3 style="margin-top: 20px;">Text</h3>

            <div class="demo-row">

                <BumiDropDownButton Text="Text" Color="ButtonColor.Primary" Variant="ButtonVariant.Text">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- Sizes -->

    <div class="bumitama-section">

        <h2>Sizes</h2>

        <div class="bumitama-card">

            <div class="demo-row" style="align-items: center; gap: 1rem;">

                <BumiDropDownButton Text="Small" Color="ButtonColor.Primary" Size="ButtonSize.Small">
                    <DxDropDownButtonItem Text="Item" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Medium" Color="ButtonColor.Primary" Size="ButtonSize.Medium">
                    <DxDropDownButtonItem Text="Item" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Large" Color="ButtonColor.Primary" Size="ButtonSize.Large">
                    <DxDropDownButtonItem Text="Item" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- With Icons -->

    <div class="bumitama-section">

        <h2>With Icons</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiDropDownButton Text="Download" IconCssClass="dx-icon dx-icon-download" Color="ButtonColor.Info">
                    <DxDropDownButtonItem Text="PDF" />
                    <DxDropDownButtonItem Text="Excel" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Share" IconCssClass="dx-icon dx-icon-share" Color="ButtonColor.Success">
                    <DxDropDownButtonItem Text="Email" />
                    <DxDropDownButtonItem Text="Link" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- Brand Color -->

    <div class="bumitama-section">

        <h2>Brand Color</h2>

        <div class="bumitama-card">

            <div class="demo-row">

                <BumiDropDownButton Text="Brand" Color="ButtonColor.Brand">
                    <DxDropDownButtonItem Text="Option 1" />
                    <DxDropDownButtonItem Text="Option 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Brand Outline" Color="ButtonColor.Brand" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Choice 1" />
                    <DxDropDownButtonItem Text="Choice 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Brand Text" Color="ButtonColor.Brand" Variant="ButtonVariant.Text">
                    <DxDropDownButtonItem Text="Link 1" />
                    <DxDropDownButtonItem Text="Link 2" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

    <!-- Custom Colors -->

    <div class="bumitama-section">

        <h2>Custom Colors</h2>

        <div class="bumitama-card">

            <h3>Light Theme</h3>

            <div class="demo-row">

                <BumiDropDownButton Text="Custom Green" Color="ButtonColor.Custom" CustomColor="#00bf63">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Purple" Color="ButtonColor.Custom" CustomColor="#8b5cf6">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Pink" Color="ButtonColor.Custom" CustomColor="#ec4899">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Cyan" Color="ButtonColor.Custom" CustomColor="#06b6d4">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

            </div>

            <h3 style="margin-top: 30px;">Outline Variant</h3>

            <div class="demo-row">

                <BumiDropDownButton Text="Custom Green" Color="ButtonColor.Custom" CustomColor="#00bf63" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Purple" Color="ButtonColor.Custom" CustomColor="#8b5cf6" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Pink" Color="ButtonColor.Custom" CustomColor="#ec4899" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

                <BumiDropDownButton Text="Custom Cyan" Color="ButtonColor.Custom" CustomColor="#06b6d4" Variant="ButtonVariant.Outline">
                    <DxDropDownButtonItem Text="Item 1" />
                    <DxDropDownButtonItem Text="Item 2" />
                </BumiDropDownButton>

            </div>

        </div>

    </div>

</div>
