@inherits LayoutComponentBase
@using AppPortal.App.Services
@inject LoadingService LoadingService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="drawer-layout @(_sidebarToggled ? "sidebar-open" : "")"
     style="--sidebar-width: 220px">

    <aside class="sidebar-panel">
        <div class="sidebar-header">
            <a href="/" class="sidebar-logo-link">
                <span class="sidebar-app-name">App Portal</span>
            </a>
        </div>
        <div class="sidebar-body">
            <NavMenu />
        </div>
    </aside>

    <div class="sidebar-backdrop" @onclick="ToggleSidebar"></div>

    <div class="sidebar-content">
        <div class="layout-wrapper">
            <header class="layout-header">
                <!-- Left: hamburger + brand -->
                <div class="header-left">
                    <button type="button" class="menu-button" @onclick="ToggleSidebar"
                            title="Toggle sidebar">
                        <img src="images/menu.svg" class="header-menu-icon" />
                    </button>
                    <div class="header-brand">
                        <span class="header-brand-name">PORTAL</span>
                        <span class="header-brand-sub">SYSTEM</span>
                    </div>
                </div>

                <!-- Right: controls -->
            </header>
            <div class="layout-body">
                @(ChildContent ?? Body)
            </div>
        </div>
        @if (LoadingService.IsLoading)
        {
            <div class="loading-overlay">
                <div class="loading-spinner">
                    @if (!string.IsNullOrEmpty(LoadingService.Message))
                    {
                        <p>@LoadingService.Message</p>
                    }
                </div>
            </div>
        }
        <ToastContainer />
    </div>

</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _sidebarToggled = false;

    protected override void OnInitialized()
    {
        LoadingService.OnChange += StateHasChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_sidebarToggled)
        {
            _sidebarToggled = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        LoadingService.OnChange -= StateHasChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleSidebar() => _sidebarToggled = !_sidebarToggled;
}

<style>
    /* ── Drawer layout ── */
    .drawer-layout {
        display: flex;
        height: 100%;
        overflow: hidden;
    }

    .sidebar-panel {
        width: 220px;
        flex-shrink: 0;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border-right: 1px solid #e5e7eb;
        transition: width 0.3s ease;
        box-shadow: 1px 0 3px rgba(0, 0, 0, 0.05);
    }

    .sidebar-header { flex-shrink: 0; }

    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        padding: 8px 0;
    }

    .sidebar-body::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar-body::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 3px;
    }

    .sidebar-body::-webkit-scrollbar-thumb:hover {
        background: #9ca3af;
    }

    .sidebar-footer { flex-shrink: 0; }

    .drawer-layout.sidebar-open .sidebar-panel {
        width: 0;
    }

    .sidebar-content {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .sidebar-backdrop { display: none; }

    @@media (max-width: 768px) {
        .sidebar-panel {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 220px !important;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            z-index: 200;
            box-shadow: 4px 0 16px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        .drawer-layout.sidebar-open .sidebar-panel {
            transform: translateX(0);
            overflow-y: auto;
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 199;
        }

        .drawer-layout.sidebar-open .sidebar-backdrop {
            display: block;
        }
    }

    .layout-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    /* ── Green branded header ── */
    .layout-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        padding: 0 16px;
        background: linear-gradient(135deg, #00bf63 0%, #00a653 100%);
        flex-shrink: 0;
        color: white;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-button {
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6px;
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s;
    }

    .menu-button:hover {
        background: rgba(255,255,255,0.18);
    }

    .header-menu-icon {
        width: 20px;
        height: 20px;
        filter: brightness(0) invert(1);
    }

    .header-brand {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

    .header-brand-name {
        font-size: 17px;
        font-weight: 700;
        color: white;
        letter-spacing: 0.2px;
    }

    .header-brand-sub {
        font-size: 9px;
        font-weight: 700;
        color: rgba(255,255,255,0.85);
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* ── Layout Body ── */
    .sidebar-header {
        padding: 16px 14px;
        border-bottom: 1px solid #e5e7eb;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar-logo-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-decoration: none;
        color: #111827;
        transition: all 0.2s ease;
        width: 100%;
    }

    .sidebar-logo-link:hover {
        opacity: 0.8;
    }

    .sidebar-app-name {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.3px;
        white-space: nowrap;
        text-align: center;
    }

    /* ── Layout Body ── */
    .layout-body {
        flex: 1;
        overflow: auto;
        background: #f9fafb;
        padding: 24px;
    }

    .layout-body::-webkit-scrollbar {
        width: 8px;
    }

    .layout-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .layout-body::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }

    .layout-body::-webkit-scrollbar-thumb:hover {
        background: #9ca3af;
    }
</style>