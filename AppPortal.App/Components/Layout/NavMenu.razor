    private List<FlatNavItem> GetVisibleItems(List<NavItem> items, string prefix, int depth = 0, bool forceExpand = false)
    {
        var result = new List<FlatNavItem>();
        foreach (var item in items)
        {
            var path = $"{prefix}|{item.Label}";
            var children  = item.Children;
            bool hasChildren = children?.Count > 0;
            bool isExpanded  = forceExpand || expandedItems.Contains(path);
            result.Add(new FlatNavItem(item, depth, path, hasChildren, isExpanded));
            if (hasChildren && isExpanded)
                result.AddRange(GetVisibleItems(children!, path, depth + 1, forceExpand));
        }
        return result;
    }

    private void ToggleItem(string path)
    {
        if (!expandedItems.Add(path)) expandedItems.Remove(path);
    }

    private List<NavGroup> GetFilteredGroups()
    {
        if (string.IsNullOrWhiteSpace(filterText)) return allGroups;
        var q = filterText.Trim().ToLower();
        var result = new List<NavGroup>();
        foreach (var g in allGroups)
        {
            var items = FilterItems(g.Items, q);
            if (items.Count > 0)
                result.Add(g with { Items = items });
        }
        return result;
    }

    private List<NavItem> FilterItems(List<NavItem> items, string q)
    {
        var result = new List<NavItem>();
        foreach (var item in items)
        {
            if (item.Label.ToLower().Contains(q))
            {
                result.Add(item);
            }
            else if (item.Children?.Count > 0)
            {
                var filtered = FilterItems(item.Children, q);
                if (filtered.Count > 0)
                    result.Add(item with { Children = filtered });
            }
        }
        return result;
    }

    private void ToggleGroup(string key)
    {
        if (!expandedGroups.Add(key))
            expandedGroups.Remove(key);
    }

    private async Task OnLinkClick()
    {
        if (OnNavigate.HasDelegate)
            await OnNavigate.InvokeAsync();
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
