@inject NavigationManager NavigationManager
@implements IDisposable

<!-- Filter -->
<div class="sidebar-filter">
    <span class="filter-icon dx-icon dx-icon-search"></span>
    <input class="filter-input"
           type="text"
           placeholder="Filter..."
           @bind="filterText"
           @bind:event="oninput" />
</div>

<!-- Navigation Groups -->
<nav class="sidebar-nav">
    @foreach (var group in GetFilteredGroups())
    {
        <div class="nav-group">
            <button class="nav-group-header @(expandedGroups.Contains(group.Key) ? "expanded" : "")"
                    @onclick="() => ToggleGroup(group.Key)">
                <span class="group-icon">@((MarkupString)group.Icon)</span>
                <span class="group-title">@group.Title</span>
                <span class="group-chevron dx-icon @(expandedGroups.Contains(group.Key) ? "dx-icon-chevronup" : "dx-icon-chevrondown")"></span>
            </button>
            @if (expandedGroups.Contains(group.Key) || !string.IsNullOrWhiteSpace(filterText))
            {
                <ul class="nav-items">
                    @foreach (var flat in GetVisibleItems(group.Items, group.Key, 0, !string.IsNullOrWhiteSpace(filterText)))
                    {
                        <li>
                            @if (flat.HasChildren)
                            {
                                <button class="nav-item-link nav-item-parent nav-depth-@(Math.Min(flat.Depth,4)) @(flat.IsExpanded ? "item-parent-expanded" : "")"
                                        style="padding-left:@(flat.Depth * 12 + 36)px;"
                                        @onclick="@(() => ToggleItem(flat.Path))">
                                    <span class="item-icon">@((MarkupString)flat.Item.Icon)</span>
                                    <span class="item-label">@flat.Item.Label</span>
                                    <span class="item-chevron dx-icon @(flat.IsExpanded ? "dx-icon-chevrondown" : "dx-icon-chevronright")"></span>
                                </button>
                            }
                            else if (flat.Item.Url != null)
                            {
                                <NavLink href="@flat.Item.Url"
                                         class="@($"nav-item-link nav-depth-{Math.Min(flat.Depth,4)}")"
                                         style="@($"padding-left:{flat.Depth * 12 + 36}px;")"
                                         Match="@(flat.Item.Url == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                         @onclick="OnLinkClick">
                                    <span class="item-icon">@((MarkupString)flat.Item.Icon)</span>
                                    <span class="item-label">@flat.Item.Label</span>
                                </NavLink>
                            }
                            else
                            {
                                <span class="nav-item-link disabled nav-depth-@(Math.Min(flat.Depth,4))" style="padding-left:@(flat.Depth * 12 + 36)px;">
                                    <span class="item-icon">@((MarkupString)flat.Item.Icon)</span>
                                    <span class="item-label">@flat.Item.Label</span>
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</nav>

<style>
    /* ===== FILTER ===== */
    .sidebar-filter {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-bottom: 1px solid #f0f0f0;
    }

    .filter-icon {
        color: #9ca3af;
        font-size: 14px;
        flex-shrink: 0;
    }

    .filter-input {
        flex: 1;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 13px;
        color: #374151;
        outline: none;
        background: #f9fafb;
        min-width: 0;
    }

    .filter-input::placeholder {
        color: #9ca3af;
    }

    .filter-input:focus {
        border-color: #10b981;
        background: white;
    }

    /* ===== NAV ===== */
    .sidebar-nav {
        padding: 4px 0;
    }

    .nav-group {
        margin: 0;
    }

    /* Group header (collapsible button) */
    .nav-group-header {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 10px 14px;
        background: none;
        border: none;
        border-bottom: 1px solid #f3f4f6;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        text-align: left;
        transition: background 0.15s;
    }

    .nav-group-header:hover {
        background: #f9fafb;
    }

    .group-icon {
        font-size: 14px;
        min-width: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .group-title {
        flex: 1;
    }

    .group-chevron {
        font-size: 12px;
        color: #9ca3af;
        transition: transform 0.2s;
    }

    /* ===== NAV ITEMS ===== */
    .nav-items {
        list-style: none;
        padding: 4px 0;
        margin: 0;
        background: #fafafa;
    }

    .nav-items li {
        margin: 0;
    }

    .nav-item-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px 9px 36px;
        font-size: 13px;
        font-weight: 400;
        color: #6b7280;
        text-decoration: none;
        width: 100%;
        transition: background 0.15s, color 0.15s;
        border-left: 3px solid transparent;
        box-sizing: border-box;
    }

    .nav-item-link:hover {
        background: #f0fdf4;
        color: #059669;
    }

    .nav-item-link.active {
        background: #ecfdf5;
        color: #059669;
        font-weight: 600;
        border-left-color: #10b981;
    }

    .nav-item-link.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .item-icon {
        font-size: 14px;
        min-width: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .item-label {
        flex: 1;
    }

    .nav-item-parent {
        background: none;
        border: none;
        border-left: 3px solid transparent;
        cursor: pointer;
        text-align: left;
        width: 100%;
        font-weight: 500;
    }

    .nav-item-parent.item-parent-expanded {
        background: #ecfdf5;
        border-left-color: #10b981;
    }

    .item-parent-expanded > .item-label { color: #059669; font-weight: 600; }
    .item-parent-expanded > .item-icon  { color: #059669; }
    .item-parent-expanded > .item-chevron { color: #059669; }

    .item-chevron {
        font-size: 10px;
        color: #9ca3af;
        flex-shrink: 0;
    }

    /* ===== DEPTH TINTS ===== */
    .nav-depth-1 { background: #f3f4f6; }
    .nav-depth-2 { background: #eef0f3; }
    .nav-depth-3 { background: #e9ebef; }
    .nav-depth-4 { background: #e3e6eb; }

    /* expanded parent overrides depth tint */
    .nav-item-parent.item-parent-expanded,
    .nav-item-parent.item-parent-expanded.nav-depth-1,
    .nav-item-parent.item-parent-expanded.nav-depth-2,
    .nav-item-parent.item-parent-expanded.nav-depth-3,
    .nav-item-parent.item-parent-expanded.nav-depth-4 {
        background: #ecfdf5 !important;
        border-left-color: #10b981;
    }
</style>

