<div class="loading-screen-overlay">
    <!-- Central Animation Cluster -->
    <div class="loading-animation-container">
        <!-- Large Ripple Effect -->
        <div class="ripple-effect"></div>

        <!-- Elegant Orbit Spinner -->
        <div class="orbit-spinner"></div>

        <!-- Floating Logo -->
        <div class="logo-container">
            @* <img src="@UiState.AppLogo" class="app-logo" alt="@UiState.AppName Logo" /> *@
            <div class="app-info">
                @* <h1 class="app-name">@UiState.AppName</h1>
                <p class="app-description">@UiState.AppDescription</p> *@
            </div>
        </div>
    </div>

    <!-- Minimalist Text -->
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="loading-message">
            <h3 class="message-text">@Message</h3>
            <div class="loading-dots">
                <div class="dot dot-1"></div>
                <div class="dot dot-2"></div>
                <div class="dot dot-3"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading";
}

<style>
    /* Loading Screen Overlay */
    .loading-screen-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 9999;
        animation: fadeIn 0.3s ease-in;
    }

    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        .loading-screen-overlay {
            background-color: rgba(0, 0, 0, 0.9);
        }
    }

    /* Animation Container */
    .loading-animation-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 320px;
        height: 320px;
    }

    /* Ripple Effect */
    .ripple-effect {
        position: absolute;
        width: 256px;
        height: 256px;
        background-color: rgba(37, 99, 235, 0.05);
        border-radius: 50%;
        animation: ping-slow 3s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    /* Orbit Spinner */
    .orbit-spinner {
        position: absolute;
        width: 160px;
        height: 160px;
        border: 3px solid transparent;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin-smooth 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    /* Logo Container */
    .logo-container {
        position: relative;
        z-index: 10;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 16px;
        animation: float-subtle 4s ease-in-out infinite;
    }

    /* App Logo */
    .app-logo {
        width: 56px;
        height: 56px;
        filter: drop-shadow(0 20px 25px rgba(0, 0, 0, 0.15));
    }

    @@media (min-width: 768px) {
        .app-logo {
            width: 80px;
            height: 80px;
        }
    }

    /* App Info */
    .app-info {
        text-align: left;
    }

    /* App Name */
    .app-name {
        font-size: 1.25rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
        margin: 0;
    }

    @@media (min-width: 768px) {
        .app-name {
            font-size: 1.875rem;
        }
    }

    @@media (prefers-color-scheme: dark) {
        .app-name {
            color: #ffffff;
        }
    }

    /* App Description */
    .app-description {
        font-size: 0.875rem;
        font-weight: 500;
        color: #6b7280;
        margin: 4px 0 0 0;
        max-width: 250px;
    }

    @@media (min-width: 768px) {
        .app-description {
            font-size: 1rem;
            max-width: 28rem;
        }
    }

    @@media (prefers-color-scheme: dark) {
        .app-description {
            color: #9ca3af;
        }
    }

    /* Loading Message */
    .loading-message {
        margin-top: 20px;
        text-align: center;
        font-family: sans-serif;
    }

    /* Message Text */
    .message-text {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: #1f2937;
        margin: 0;
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @@media (prefers-color-scheme: dark) {
        .message-text {
            color: #e5e7eb;
        }
    }

    /* Loading Dots */
    .loading-dots {
        margin-top: 16px;
        display: flex;
        justify-content: center;
        gap: 8px;
        opacity: 0.5;
    }

    /* Individual Dot */
    .dot {
        width: 4px;
        height: 4px;
        background-color: #2563eb;
        border-radius: 50%;
        animation: bounce 1s infinite;
    }

    .dot-1 {
        animation-delay: -0.3s;
    }

    .dot-2 {
        animation-delay: -0.15s;
    }

    .dot-3 {
        animation-delay: 0s;
    }

    /* Keyframe Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes spin-smooth {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes ping-slow {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        75%, 100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    @@keyframes float-subtle {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-5px);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-8px);
        }
    }
</style>
