@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveAuto
@inject NavigationManager Navigation
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using AppPortal.App.Components.BumitamaKit.Forms.BumiInput
@using AppPortal.App.Components.BumitamaKit.Forms.BumiCheckbox
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton

<PageTitle>Login - Portal Aplikasi Bumitama</PageTitle>

<div class="login-container">
    <!-- Left Section - Illustration -->
    <div class="login-left">
        <div class="illustration-content">
            <div class="carousel-container">
                <!-- Slide 1: Security & Authentication -->
                <div class="carousel-slide @(currentSlide == 0 ? "active" : "")">
                    <div class="illustration-image">
                        <svg viewBox="0 0 400 400" class="login-illustration">
                            <!-- Browser Window -->
                            <rect x="50" y="80" width="200" height="180" rx="8" fill="#fff" stroke="#374151" stroke-width="2"/>
                            <circle cx="65" cy="95" r="3" fill="#ef4444"/>
                            <circle cx="78" cy="95" r="3" fill="#fbbf24"/>
                            <circle cx="91" cy="95" r="3" fill="#10b981"/>
                            
                            <!-- User Icon -->
                            <circle cx="150" cy="150" r="25" fill="#fbbf24"/>
                            <circle cx="150" cy="142" r="10" fill="#fff"/>
                            <path d="M 130 170 Q 150 180 170 170" fill="#fff"/>
                            
                            <!-- Password Dots -->
                            <rect x="80" y="195" width="140" height="20" rx="4" fill="#f3f4f6" stroke="#d1d5db" stroke-width="1"/>
                            <circle cx="95" cy="205" r="3" fill="#374151"/>
                            <circle cx="107" cy="205" r="3" fill="#374151"/>
                            <circle cx="119" cy="205" r="3" fill="#374151"/>
                            <circle cx="131" cy="205" r="3" fill="#374151"/>
                            <circle cx="143" cy="205" r="3" fill="#374151"/>
                            
                            <!-- Unlock Button -->
                            <rect x="85" y="225" width="60" height="20" rx="4" fill="#1f2937"/>
                            <text x="115" y="239" text-anchor="middle" fill="#fff" font-size="10" font-weight="600">Unlock</text>
                            
                            <!-- Security Shield -->
                            <path d="M 285 80 L 310 80 L 310 120 Q 297.5 130 285 120 Z" fill="#3b82f6" stroke="#2563eb" stroke-width="2"/>
                            <path d="M 292 95 L 297 100 L 307 85" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
                            
                            <!-- Person Illustration -->
                            <ellipse cx="310" cy="320" rx="35" ry="8" fill="#cbd5e1"/>
                            <circle cx="310" cy="270" r="20" fill="#1e3a8a"/>
                            <ellipse cx="310" cy="260" rx="15" ry="18" fill="#fef3c7"/>
                            <path d="M 290 290 L 290 320 L 280 340 M 290 310 L 270 315" stroke="#1e3a8a" stroke-width="8" stroke-linecap="round"/>
                            <path d="M 330 290 L 330 320 L 340 340 M 330 310 L 350 315" stroke="#1e3a8a" stroke-width="8" stroke-linecap="round"/>
                            <rect x="300" y="280" width="20" height="40" rx="5" fill="#3b82f6"/>
                            <circle cx="305" cy="255" r="2" fill="#1f2937"/>
                            <circle cx="315" cy="255" r="2" fill="#1f2937"/>
                            <path d="M 305 263 Q 310 266 315 263" fill="none" stroke="#1f2937" stroke-width="1.5"/>
                            
                            <!-- Decorative Dots -->
                            <circle cx="180" cy="60" r="4" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="360" cy="140" r="4" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="70" cy="340" r="4" fill="#10b981" opacity="0.6"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h2>Akses Aman & Terpercaya</h2>
                        <p>Sistem keamanan berlapis dengan enkripsi data untuk melindungi informasi sensitif perusahaan Anda.</p>
                    </div>
                </div>

                <!-- Slide 2: Analytics & Data -->
                <div class="carousel-slide @(currentSlide == 1 ? "active" : "")">
                    <div class="illustration-image">
                        <svg viewBox="0 0 400 400" class="login-illustration">
                            <!-- Dashboard Screen -->
                            <rect x="50" y="60" width="300" height="250" rx="8" fill="#fff" stroke="#374151" stroke-width="2"/>
                            <rect x="50" y="60" width="300" height="30" rx="8" fill="#1f2937"/>
                            <circle cx="65" cy="75" r="3" fill="#ef4444"/>
                            <circle cx="78" cy="75" r="3" fill="#fbbf24"/>
                            <circle cx="91" cy="75" r="3" fill="#10b981"/>
                            
                            <!-- Chart Bars -->
                            <rect x="80" y="220" width="40" height="70" rx="4" fill="#10b981"/>
                            <rect x="140" y="180" width="40" height="110" rx="4" fill="#3b82f6"/>
                            <rect x="200" y="200" width="40" height="90" rx="4" fill="#fbbf24"/>
                            <rect x="260" y="160" width="40" height="130" rx="4" fill="#f97316"/>
                            
                            <!-- Line Chart -->
                            <path d="M 80 140 L 120 130 L 160 110 L 200 120 L 240 100 L 280 90" 
                                  fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round"/>
                            <circle cx="80" cy="140" r="4" fill="#10b981"/>
                            <circle cx="120" cy="130" r="4" fill="#10b981"/>
                            <circle cx="160" cy="110" r="4" fill="#10b981"/>
                            <circle cx="200" cy="120" r="4" fill="#10b981"/>
                            <circle cx="240" cy="100" r="4" fill="#10b981"/>
                            <circle cx="280" cy="90" r="4" fill="#10b981"/>
                            
                            <!-- Magnifying Glass -->
                            <circle cx="320" cy="340" r="30" fill="none" stroke="#3b82f6" stroke-width="4"/>
                            <line x1="343" y1="363" x2="370" y2="390" stroke="#3b82f6" stroke-width="4" stroke-linecap="round"/>
                            <text x="320" y="350" text-anchor="middle" fill="#3b82f6" font-size="24" font-weight="700">📊</text>
                            
                            <!-- Decorative elements -->
                            <circle cx="100" cy="340" r="4" fill="#3b82f6" opacity="0.6"/>
                            <circle cx="140" cy="360" r="4" fill="#fbbf24" opacity="0.6"/>
                            <circle cx="180" cy="340" r="4" fill="#10b981" opacity="0.6"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h2>Analitika Data Real-Time</h2>
                        <p>Dashboard interaktif dengan visualisasi data lengkap untuk monitoring produksi dan performa estate secara real-time.</p>
                    </div>
                </div>

                <!-- Slide 3: Palm Oil Production -->
                <div class="carousel-slide @(currentSlide == 2 ? "active" : "")">
                    <div class="illustration-image">
                        <svg viewBox="0 0 400 400" class="login-illustration">
                            <!-- Palm Tree -->
                            <ellipse cx="200" cy="380" rx="40" ry="10" fill="#cbd5e1" opacity="0.6"/>
                            <rect x="190" y="200" width="20" height="180" fill="#92400e" rx="2"/>
                            
                            <!-- Palm Leaves -->
                            <ellipse cx="150" cy="180" rx="60" ry="25" fill="#10b981" transform="rotate(-30 150 180)"/>
                            <ellipse cx="250" cy="180" rx="60" ry="25" fill="#059669" transform="rotate(30 250 180)"/>
                            <ellipse cx="180" cy="150" rx="55" ry="22" fill="#10b981" transform="rotate(-50 180 150)"/>
                            <ellipse cx="220" cy="150" rx="55" ry="22" fill="#059669" transform="rotate(50 220 150)"/>
                            <ellipse cx="195" cy="130" rx="50" ry="20" fill="#10b981" transform="rotate(-70 195 130)"/>
                            <ellipse cx="205" cy="130" rx="50" ry="20" fill="#059669" transform="rotate(70 205 130)"/>
                            <ellipse cx="200" cy="120" rx="45" ry="18" fill="#10b981"/>
                            
                            <!-- Palm Fruits (FFB) -->
                            <ellipse cx="200" cy="220" rx="25" ry="35" fill="#f97316"/>
                            <circle cx="195" cy="210" r="5" fill="#fb923c"/>
                            <circle cx="205" cy="210" r="5" fill="#fb923c"/>
                            <circle cx="190" cy="220" r="5" fill="#fb923c"/>
                            <circle cx="210" cy="220" r="5" fill="#fb923c"/>
                            <circle cx="195" cy="230" r="5" fill="#fb923c"/>
                            <circle cx="205" cy="230" r="5" fill="#fb923c"/>
                            <circle cx="200" cy="240" r="5" fill="#fb923c"/>
                            
                            <!-- Oil Drops -->
                            <path d="M 280 280 Q 280 260 290 250 Q 300 260 300 280 Q 300 295 290 300 Q 280 295 280 280" fill="#fbbf24"/>
                            <path d="M 320 300 Q 320 285 328 278 Q 336 285 336 300 Q 336 312 328 316 Q 320 312 320 300" fill="#fbbf24"/>
                            <path d="M 100 280 Q 100 260 110 250 Q 120 260 120 280 Q 120 295 110 300 Q 100 295 100 280" fill="#fbbf24"/>
                            
                            <!-- Factory Building -->
                            <rect x="80" y="60" width="80" height="60" fill="#6b7280" stroke="#374151" stroke-width="2"/>
                            <rect x="85" y="70" width="15" height="15" fill="#fbbf24"/>
                            <rect x="105" y="70" width="15" height="15" fill="#fbbf24"/>
                            <rect x="130" y="70" width="15" height="15" fill="#fbbf24"/>
                            <rect x="85" y="95" width="15" height="15" fill="#fbbf24"/>
                            <rect x="105" y="95" width="15" height="15" fill="#fbbf24"/>
                            <rect x="130" y="95" width="15" height="15" fill="#fbbf24"/>
                            <polygon points="120,40 80,60 160,60" fill="#374151"/>
                            
                            <!-- Smoke from factory -->
                            <ellipse cx="110" cy="30" rx="8" ry="10" fill="#cbd5e1" opacity="0.6"/>
                            <ellipse cx="105" cy="20" rx="10" ry="12" fill="#cbd5e1" opacity="0.5"/>
                            <ellipse cx="115" cy="15" rx="12" ry="14" fill="#cbd5e1" opacity="0.4"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h2>Manajemen Perkebunan Terintegrasi</h2>
                        <p>Kelola seluruh operasional estate dari penanaman hingga produksi CPO dengan sistem terintegrasi dan efisien.</p>
                    </div>
                </div>
            </div>
            
            <div class="carousel-dots">
                @for (int i = 0; i < 3; i++)
                {
                    int index = i;
                    <span class="dot @(currentSlide == index ? "active" : "")" 
                          @onclick="() => GoToSlide(index)"></span>
                }
            </div>
        </div>
    </div>

    <!-- Right Section - Login Form -->
    <div class="login-right">
        <div class="login-form-container">
            <!-- Logo -->
            <div class="logo-section">
                <div class="logo-image">
                    <svg viewBox="0 0 100 100" width="80" height="80">
                        <!-- Palm Leaves -->
                        <path d="M 50 30 Q 30 25 25 15" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                        <path d="M 50 30 Q 40 22 38 12" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                        <path d="M 50 30 Q 45 20 45 10" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                        <path d="M 50 30 Q 55 20 55 10" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                        <path d="M 50 30 Q 60 22 62 12" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                        <path d="M 50 30 Q 70 25 75 15" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                        
                        <!-- Palm Fruit -->
                        <ellipse cx="50" cy="42" rx="12" ry="15" fill="#f97316"/>
                        <ellipse cx="47" cy="38" rx="3" ry="4" fill="#fb923c"/>
                        <ellipse cx="53" cy="38" rx="3" ry="4" fill="#fb923c"/>
                        <ellipse cx="50" cy="45" rx="3" ry="4" fill="#fb923c"/>
                        
                        <!-- Wheat/Grain -->
                        <path d="M 58 50 L 58 75" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                        <ellipse cx="58" cy="52" rx="3" ry="4" fill="#fbbf24" transform="rotate(-20 58 52)"/>
                        <ellipse cx="58" cy="56" rx="3" ry="4" fill="#fbbf24" transform="rotate(15 58 56)"/>
                        <ellipse cx="58" cy="60" rx="3" ry="4" fill="#fbbf24" transform="rotate(-10 58 60)"/>
                        <ellipse cx="58" cy="64" rx="3" ry="4" fill="#fbbf24" transform="rotate(20 58 64)"/>
                        <ellipse cx="58" cy="68" rx="3" ry="4" fill="#fbbf24" transform="rotate(-15 58 68)"/>
                        <ellipse cx="58" cy="72" rx="3" ry="4" fill="#fbbf24" transform="rotate(10 58 72)"/>
                    </svg>
                </div>
                <div class="logo-text">Bumitama Gunajaya Agro</div>
            </div>

            <!-- Title -->
            <h1 class="form-title">PORTAL APLIKASI BUMITAMA</h1>
            <p class="form-subtitle">Masukan Username dan password Anda untuk masuk ke portal.</p>

            <!-- Login Form -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="login-form">
                <DataAnnotationsValidator />

                <!-- Username Input -->
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <div class="input-with-icon">
                        <i class="fas fa-user input-icon"></i>
                        <BumiInput @bind-Value="loginModel.Username" 
                                   Placeholder="Masukan Username" />
                    </div>
                </div>

                <!-- Password Input -->
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-with-icon">
                        <i class="fas fa-lock input-icon"></i>
                        <BumiInput @bind-Value="loginModel.Password" 
                                   Type="password"
                                   Placeholder="Masukan Password" />
                    </div>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="form-group checkbox-group">
                    <BumiCheckbox @bind-Checked="loginModel.RememberMe" 
                                  Label="Ingatkan saya"
                                  CustomColor="#10b981" />
                </div>

                <!-- Submit Button -->
                <BumiButton Text="@(isSubmitting ? "SIGNING IN..." : "SIGN IN")"
                           Color="ButtonColor.Brand"
                           Click="HandleLogin"
                           Disabled="@isSubmitting"
                           CssClass="w-full" />
            </EditForm>

            <!-- Copyright -->
            <div class="copyright">
                © 2026. Portal Bumitama All Rights Reserved.
            </div>
        </div>
    </div>

    @if (showErrorModal)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <h2 class="modal-title">@errorTitle</h2>
                <p class="modal-message">@errorMessage</p>
                <BumiButton Text="@closeButtonText"
                           Color="ButtonColor.Brand"
                           CssClass="w-full"
                           Click="@(() => showErrorModal = false)" />
            </div>
        </div>
    }
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .login-container {
        display: flex;
        min-height: 100vh;
        background: linear-gradient(135deg, #a3e635 0%, #fbbf24 50%, #fef3c7 100%);
    }

    /* Left Section - Illustration */
    .login-left {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        background: linear-gradient(135deg, #86efac 0%, #10b981 50%, #059669 100%);
        position: relative;
        overflow: hidden;
    }

    .login-left::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 100%;
        height: 150%;
        background: linear-gradient(135deg, rgba(254, 243, 199, 0.3) 0%, transparent 70%);
        transform: rotate(-15deg);
        pointer-events: none;
    }

    .illustration-content {
        max-width: 500px;
        width: 100%;
        z-index: 1;
    }

    .illustration-image {
        margin-bottom: 3rem;
        filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.1));
    }

    .login-illustration {
        width: 100%;
        height: auto;
    }

    .feature-text {
        text-align: center;
        color: #ffffff;
        margin-bottom: 2rem;
    }

    .feature-text h2 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.3;
    }

    .feature-text p {
        font-size: 1rem;
        line-height: 1.6;
        opacity: 0.95;
    }

    .carousel-dots {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    /* Carousel Styles */
    .carousel-container {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transform: translateX(100px);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
    }

    .carousel-slide.active {
        position: relative;
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        transition: all 0.3s;
        cursor: pointer;
    }

    .dot:hover {
        background: rgba(255, 255, 255, 0.6);
        transform: scale(1.1);
    }

    .dot.active {
        width: 24px;
        border-radius: 4px;
        background: #ffffff;
    }

    /* Right Section - Login Form */
    .login-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #fef9f0;
    }

    .login-form-container {
        width: 100%;
        max-width: 450px;
        background: #ffffff;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    }

    /* Logo Section */
    .logo-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 2rem;
    }

    .logo-image {
        margin-bottom: 1rem;
    }

    .logo-text {
        font-size: 0.875rem;
        color: #059669;
        font-weight: 600;
        text-align: center;
    }

    /* Form Title */
    .form-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #10b981;
        text-align: center;
        margin-bottom: 0.75rem;
    }

    .form-subtitle {
        font-size: 0.875rem;
        color: #9ca3af;
        text-align: center;
        margin-bottom: 2rem;
        line-height: 1.5;
    }

    /* Form Styles */
    .login-form {
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .input-with-icon {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 0.875rem;
        z-index: 1;
        pointer-events: none;
    }

    .input-with-icon .bumi-input-theme {
        width: 100%;
    }

    .input-with-icon input {
        padding-left: 2.5rem !important;
    }

    .checkbox-group {
        margin-bottom: 1.5rem;
    }

    .link-primary {
        color: #3b82f6;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }

    .link-primary:hover {
        color: #2563eb;
        text-decoration: underline;
    }

    .help-text {
        margin-top: 0.75rem;
        font-size: 0.875rem;
        color: #6b7280;
    }

    /* Copyright */
    .copyright {
        text-align: center;
        font-size: 0.75rem;
        color: #9ca3af;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
        padding: 1rem;
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .modal-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.75rem;
    }

    .modal-message {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .login-left {
            display: none;
        }

        .login-right {
            flex: 1;
        }
    }

    @@media (max-width: 640px) {
        .login-form-container {
            padding: 1.5rem;
        }

        .form-title {
            font-size: 1.25rem;
        }

        .logo-image svg {
            width: 60px;
            height: 60px;
        }
    }

    .w-full {
        width: 100%;
    }
</style>

@code {
    private class LoginModel
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
        public bool RememberMe { get; set; }
    }

    private LoginModel loginModel = new();

    private bool showErrorModal = false;
    private string errorTitle = "Gagal Masuk";
    private string? errorMessage;
    private string? closeButtonText = "Tutup";

    private bool isSubmitting = false;
    private bool _disposed = false;

    // Carousel state
    private int currentSlide = 0;
    private System.Threading.Timer? carouselTimer;
    private const int AutoPlayInterval = 5000; // 5 seconds

    protected override void OnInitialized()
    {
        // Start auto-play carousel
        StartCarouselAutoPlay();
    }

    private void StartCarouselAutoPlay()
    {
        carouselTimer = new System.Threading.Timer((_) =>
        {
            if (!_disposed)
            {
                InvokeAsync(() =>
                {
                    NextSlide();
                    StateHasChanged();
                });
            }
        }, null, AutoPlayInterval, AutoPlayInterval);
    }

    private void GoToSlide(int slideIndex)
    {
        if (slideIndex >= 0 && slideIndex < 3)
        {
            currentSlide = slideIndex;
            
            // Reset auto-play timer when user manually changes slide
            carouselTimer?.Dispose();
            StartCarouselAutoPlay();
        }
    }

    private void NextSlide()
    {
        currentSlide = (currentSlide + 1) % 3;
    }

    private async Task HandleLogin()
    {
        if (_disposed || isSubmitting) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            // TODO: Implementasikan login logic ke backend
            await Task.Delay(1000);

            // Navigate to dashboard after successful login
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ShowError("Gagal Masuk", ex.Message, "Tutup");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ShowError(string title, string message, string closeText = "Tutup")
    {
        if (_disposed) return;

        errorTitle = title;
        errorMessage = message;
        closeButtonText = closeText;
        showErrorModal = true;

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        carouselTimer?.Dispose();
        await Task.CompletedTask;
    }
}
