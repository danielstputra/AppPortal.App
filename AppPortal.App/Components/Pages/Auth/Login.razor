@page "/login"
@attribute [AllowAnonymous]
@rendermode InteractiveAuto
@inject NavigationManager Navigation
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using AppPortal.App.Components.BumitamaKit.Forms.BumiInput
@using AppPortal.App.Components.BumitamaKit.Actions.BumiButton

<PageTitle>Login</PageTitle>

<div class="min-h-screen flex items-center justify-center p-4 lg:p-8">
    <div class="flex flex-col lg:flex-row items-center justify-center w-full max-w-6xl gap-8 lg:gap-12">

        <!-- Login Card -->
        <div class="w-full max-w-md bg-white dark:bg-[#1e293b] border border-gray-100 dark:border-gray-800 rounded-3xl shadow-xl dark:shadow-2xl p-8 lg:p-10 overflow-hidden">
            <!-- Logo & Branding -->
            <div class="flex items-center mb-10 translate-x-[-8px]">
                <div class="flex flex-col">
                    <span class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">AppPortal</span>
                    <p class="text-[11px] font-medium text-gray-500 dark:text-gray-400 uppercase tracking-widest opacity-80">Login</p>
                </div>
            </div>

            <!-- Welcome Text -->
            <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">
                Selamat Datang
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-8 leading-relaxed">
                Silahkan masukkan email dan password anda untuk login ke halaman dashboard.
            </p>

            <!-- Login Form -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <!-- Email Input -->
                <div class="mb-6">
                    <BumiInput @bind-Value="loginModel.Email" 
                               Label="Alamat Email" 
                               Placeholder="name@company.com" />
                </div>

                <!-- Password Input -->
                <div class="mb-6">
                    <BumiInput @bind-Value="loginModel.Password" 
                               Label="Kata Sandi" 
                               Placeholder="••••••••" />
                </div>

                <!-- Remember Me -->
                <div class="mb-6">
                    <label class="flex items-center gap-2">
                        <InputCheckbox @bind-Value="loginModel.RememberMe" />
                        <span class="text-sm text-gray-600 dark:text-gray-400">Ingatkan saya</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <BumiButton Text="@(isSubmitting ? "Masuk..." : "Masuk ke akun Anda")"
                           Size="ButtonSize.Large"
                           Color="ButtonColor.Primary"
                           Disabled="@isSubmitting"
                           Loading="@isSubmitting"
                           CssClass="w-full"
                           Click="HandleLogin" />
            </EditForm>

            <div class="flex items-center justify-center mt-8">
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Tidak punya akun? <a href="register" class="text-blue-600 dark:text-blue-500 font-bold hover:underline transition-colors">Daftar di sini</a>
                </p>
            </div>

            @if (showErrorModal)
            {
                <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-sm shadow-xl">
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">@errorTitle</h2>
                        <p class="text-gray-700 dark:text-gray-300 mb-6 text-sm leading-relaxed">@errorMessage</p>
                        <BumiButton Text="@closeButtonText"
                                   Color="ButtonColor.Primary"
                                   CssClass="w-full"
                                   Click="@(() => showErrorModal = false)" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private class LoginModel
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
        public bool RememberMe { get; set; }
    }

    private LoginModel loginModel = new();

    private bool showErrorModal = false;
    private string errorTitle = "Gagal Masuk";
    private string? errorMessage;
    private string? closeButtonText = "Tutup";

    private bool isSubmitting = false;
    private bool _disposed = false;

    private async Task HandleLogin()
    {
        if (_disposed || isSubmitting) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            // TODO: Implementasikan login logic ke backend
            await Task.Delay(1000);

            // Navigate to dashboard after successful login
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ShowError("Gagal Masuk", ex.Message, "Tutup");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ShowError(string title, string message, string closeText = "Tutup")
    {
        if (_disposed) return;

        errorTitle = title;
        errorMessage = message;
        closeButtonText = closeText;
        showErrorModal = true;

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Task.CompletedTask;
    }
}
